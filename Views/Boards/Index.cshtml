@model List<PulseBoardMigration.Models.Board>

@{
    ViewData["Title"] = "Meus Quadros";
}

<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-8">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Meus Quadros</h1>
        <p class="text-sm text-slate-500 mt-1">Gerencie seus projetos e fluxos de trabalho de forma centralizada.</p>
    </div>

    <div class="flex items-center gap-3">
        <div class="relative group hidden sm:block">
            <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400 group-focus-within:text-indigo-500 transition-colors"></i>
            <input type="text"
                   placeholder="Buscar quadros..."
                   class="h-10 w-64 rounded-lg border border-slate-200 bg-slate-50/50 pl-9 pr-4 text-sm outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all">
        </div>

        <button onclick="openCreateBoardModal()"
                class="flex h-10 items-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm shadow-indigo-200 transition-all hover:bg-indigo-700 hover:shadow-indigo-300 active:scale-[0.98]">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Novo Quadro
        </button>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="flex min-h-[400px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/50 p-12 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm border border-slate-100 text-indigo-600 mb-4">
            <i data-lucide="kanban-square" class="h-8 w-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Inicie um novo projeto</h3>
        <p class="mt-2 max-w-xs text-sm text-slate-500">Crie seu primeiro quadro para começar a organizar suas tarefas e equipes.</p>
        <button onclick="openCreateBoardModal()" class="mt-6 text-sm font-bold text-indigo-600 hover:text-indigo-700">
            Criar meu primeiro quadro &rarr;
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @foreach (var board in Model)
        {
            <a href="/Boards/Details/@board.Id" class="group relative flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-indigo-200 hover:shadow-xl hover:shadow-slate-200/50 hover:-translate-y-1">
                <div>
                    <div class="flex items-start justify-between">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                            <i data-lucide="layout-dashboard" class="h-5 w-5"></i>
                        </div>

                        <button class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-50 hover:text-slate-600 transition-colors" onclick="event.preventDefault();">
                            <i data-lucide="more-vertical" class="h-4 w-4"></i>
                        </button>
                    </div>

                    <h3 class="mt-5 text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">@board.Name</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-500 line-clamp-2">
                        @(string.IsNullOrWhiteSpace(board.Description) ? "Sem descrição disponível para este quadro." : board.Description)
                    </p>
                </div>

                <div class="mt-8 flex items-center justify-between border-t border-slate-50 pt-4">
                    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                        <i data-lucide="clock" class="h-3 w-3"></i>
                        <span>@board.CreatedAt.ToString("dd MMM, yyyy")</span>
                    </div>
                    <div class="rounded-full bg-slate-50 p-1 text-slate-300 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-all">
                        <i data-lucide="chevron-right" class="h-4 w-4"></i>
                    </div>
                </div>
            </a>
        }
    </div>
}

@await Html.PartialAsync("_CreateBoardModal")