@model PulseBoardMigration.Models.EnterprisePlanningViewModel
@using System.Globalization
@{
    string Hours(int minutes) => $"{minutes / 60m:0.#}h";
    string AbsenceLabel(string value) => value switch { "vacation" => "Férias", "leave" => "Afastamento", "training" => "Treinamento", "day_off" => "Folga", _ => "Outro" };
    var today = DateTime.Today;
    var absences = Model.Absences.Where(x => x.Status == "approved" && x.EndsOn.Date >= today).ToList();
    var holidays = Model.Holidays.Where(x => x.HolidayDate.Date >= today).ToList();
}

<div id="equipe" class="planning-panel space-y-5" role="tabpanel" hidden>
    <section class="rounded-2xl border bg-white p-5"><h2 class="text-xl font-bold">Equipe e capacidade</h2><p class="mt-1 text-sm text-slate-500">Ausências e feriados diminuem as horas disponíveis. Registre-os antes de avaliar a ocupação.</p><div class="mt-4 h-3 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full @(Model.CapacityUtilizationPercent > 100 ? "bg-red-500" : Model.CapacityUtilizationPercent > 85 ? "bg-amber-500" : "bg-emerald-500")" style="width:@Math.Min(Model.CapacityUtilizationPercent, 100).ToString("0.##", CultureInfo.InvariantCulture)%"></div></div><p class="mt-2 text-sm"><strong>@Hours(Model.AllocatedMinutes)</strong> planejadas de <strong>@Hours(Model.EffectiveCapacityMinutes)</strong> disponíveis (@Model.CapacityUtilizationPercent.ToString("0")%).</p></section>
    <div class="grid gap-5 xl:grid-cols-2">
        <section class="rounded-2xl border bg-white p-5">
            <div class="flex items-start justify-between gap-3"><div><h2 class="text-lg font-bold">Ausências da equipe</h2><p class="text-xs text-slate-500">Férias, folgas e afastamentos reduzem a disponibilidade.</p></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">@absences.Count ativa(s)</span></div>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Registrar ausência</summary><form asp-action="AddAbsence" method="post" class="mt-3 grid gap-3 border-t border-indigo-100 pt-3 sm:grid-cols-2"><label class="text-xs font-semibold">Pessoa<select name="userId" required class="field mt-1"><option value="">Selecione</option>@foreach (var p in Model.Profiles) { <option value="@p.Id">@(p.FullName ?? p.Email)</option> }</select></label><label class="text-xs font-semibold">Motivo<select name="type" class="field mt-1"><option value="vacation">Férias</option><option value="leave">Afastamento</option><option value="training">Treinamento</option><option value="day_off">Folga</option><option value="other">Outro</option></select></label><label class="text-xs font-semibold">Primeiro dia<input type="date" name="startsOn" required class="field mt-1" /></label><label class="text-xs font-semibold">Último dia<input type="date" name="endsOn" required class="field mt-1" /></label><label class="text-xs font-semibold sm:col-span-2">Observação<input name="notes" maxlength="500" class="field mt-1" placeholder="Opcional" /></label><button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Confirmar ausência aprovada</button></form></details>
            <div class="mt-4 max-h-80 space-y-2 overflow-y-auto">@foreach (var item in absences) { <div class="flex items-start justify-between gap-3 rounded-lg bg-slate-50 p-3 text-sm"><div><strong>@(Model.Person(item.UserId)?.FullName ?? "Pessoa")</strong><p class="text-xs text-slate-500">@AbsenceLabel(item.AbsenceType) · @item.StartsOn.ToString("dd/MM/yyyy") até @item.EndsOn.ToString("dd/MM/yyyy")</p>@if (!string.IsNullOrWhiteSpace(item.Notes)) { <p class="mt-1 text-xs text-slate-400">@item.Notes</p> }</div><form asp-action="CancelAbsence" method="post" onsubmit="return confirm('Cancelar esta ausência?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-xs font-bold text-red-500">Cancelar</button></form></div> } @if (!absences.Any()) { <div class="rounded-xl border border-dashed p-6 text-center text-sm text-slate-400">Nenhuma ausência ativa ou futura.</div> }</div>
        </section>
        <section class="rounded-2xl border bg-white p-5">
            <div class="flex items-start justify-between gap-3"><div><h2 class="text-lg font-bold">Feriados</h2><p class="text-xs text-slate-500">Podem valer para toda a empresa ou apenas uma equipe.</p></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold">@holidays.Count próximo(s)</span></div>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Adicionar feriado</summary><form asp-action="AddHoliday" method="post" class="mt-3 grid gap-3 border-t border-indigo-100 pt-3 sm:grid-cols-2"><label class="text-xs font-semibold">Data<input type="date" name="date" required class="field mt-1" /></label><label class="text-xs font-semibold">Nome<input name="name" maxlength="120" required class="field mt-1" placeholder="Ex.: Aniversário da cidade" /></label><label class="text-xs font-semibold sm:col-span-2">Aplicar para<select name="teamId" class="field mt-1">@if (Model.IsAdmin) { <option value="">Toda a empresa</option> } @foreach (var t in Model.Teams) { <option value="@t.Id" selected="@(!Model.IsAdmin && t.Id == Model.CurrentUserTeamId)">@t.Name</option> }</select></label><button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Salvar feriado</button></form></details>
            <div class="mt-4 max-h-80 space-y-2 overflow-y-auto">@foreach (var item in holidays) { <div class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 p-3 text-sm"><div><strong>@item.HolidayDate.ToString("dd/MM/yyyy") · @item.Name</strong><p class="text-xs text-slate-500">@(Model.Team(item.TeamId)?.Name ?? "Toda a empresa")</p></div><form asp-action="DeleteHoliday" method="post" onsubmit="return confirm('Remover este feriado?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-xs font-bold text-red-500">Remover</button></form></div> } @if (!holidays.Any()) { <div class="rounded-xl border border-dashed p-6 text-center text-sm text-slate-400">Nenhum feriado futuro cadastrado.</div> }</div>
        </section>
    </div>
</div>
