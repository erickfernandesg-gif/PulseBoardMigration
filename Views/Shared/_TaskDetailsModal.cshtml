@model PulseBoardMigration.Models.BoardDetailsViewModel
@{ var isServiceBoard = string.Equals(Model.Board.OperationProfile, "service", StringComparison.OrdinalIgnoreCase); }
<div id="taskDetailsModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm">
    <div class="max-h-[94vh] w-full max-w-5xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-100 p-6">
            <div><h2 class="text-xl font-bold">Detalhes da demanda</h2><p id="taskDetailsTitle" class="text-sm text-slate-500">Consulte o planejamento, converse e registre a execução.</p></div>
            <button type="button" onclick="closeTaskDetailsModal()" class="rounded-lg p-2 hover:bg-slate-100">✕</button>
        </div>
        <nav class="flex gap-2 overflow-x-auto border-b border-slate-100 bg-slate-50 px-6 py-3" aria-label="Seções dos detalhes">
            <button type="button" data-task-tab="summary" class="task-detail-tab whitespace-nowrap rounded-lg bg-white px-4 py-2 text-sm font-bold text-indigo-700 shadow-sm">Resumo e planejamento</button>
            <button type="button" data-task-tab="activity" class="task-detail-tab whitespace-nowrap rounded-lg px-4 py-2 text-sm font-bold text-slate-600">Conversa e execução</button>
            <button type="button" data-task-tab="workflow" class="task-detail-tab whitespace-nowrap rounded-lg px-4 py-2 text-sm font-bold text-slate-600">Fluxo e dependências</button>
        </nav>
        <section data-task-panel="summary">
        <form id="editTaskForm" asp-controller="Boards" asp-action="UpdateTask" method="post" class="grid gap-5 p-6 md:grid-cols-3">
            <input type="hidden" id="EditTaskId" name="taskId" />
            <input type="hidden" id="EditExpectedVersion" name="expectedVersion" />
            <input type="hidden" name="boardId" value="@Model.Board.Id" />
            <div class="md:col-span-2"><label class="label">Título</label><input id="EditTitle" name="title" required maxlength="200" class="field" /></div>
            <div><label class="label">Etapa</label><select id="EditColumnId" name="columnId" class="field">@foreach(var c in Model.Columns){<option value="@c.Id">@c.Title</option>}</select></div>
            <div class="md:col-span-2"><label class="label">Descrição</label><textarea id="EditDescription" name="description" rows="3" maxlength="5000" class="field"></textarea></div>
            <div><label class="label">Prioridade</label><select id="EditPriority" name="priority" class="field"><option value="low">Baixa</option><option value="medium">Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div>
            <div><label class="label">Responsável</label><select id="EditAssignedTo" name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName ?? p.Email)</option>}</select></div>
            <div><label class="label">Cliente</label><select id="EditClientId" name="clientId" class="field"><option value="">Operação interna</option>@foreach(var c in Model.Clients){<option value="@c.Id">@c.Name</option>}</select></div>
            <div><label class="label">Ciclo</label><input id="EditTargetMonth" type="month" name="targetMonth" class="field" /></div>
            <div><label class="label">Início</label><input id="EditStartDate" type="date" name="startDate" class="field" /></div>
            <div><label class="label">Prazo</label><input id="EditDueDate" type="date" name="dueDate" class="field" /></div>
            <div><label class="label">Estimativa</label><div class="grid grid-cols-2 gap-2"><input id="EditEstimatedHours" type="number" min="0" max="100000" name="estimatedHours" class="field" placeholder="Horas" /><input id="EditEstimatedMinutes" type="number" min="0" max="59" name="estimatedMinutes" class="field" placeholder="Min" /></div></div>
            <div class="md:col-span-2"><label class="label">Colaboradores</label><div class="grid max-h-28 grid-cols-2 gap-2 overflow-y-auto rounded-lg border border-slate-200 p-3">@foreach(var p in Model.Profiles){<label class="flex items-center gap-2 text-xs"><input class="edit-collaborator" type="checkbox" name="collaboratorIds" value="@p.Id" /> @(p.FullName ?? p.Email)</label>}</div></div>
            <details class="md:col-span-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
                <summary class="cursor-pointer text-sm font-bold text-slate-700">Atendimento e exceções <span class="font-normal text-slate-400">— use somente quando necessário</span></summary>
                <div class="mt-4 grid gap-4 md:grid-cols-3">
                    @if (isServiceBoard) { <div class="md:col-span-2"><label class="label">SLA de atendimento (minutos)</label><input id="EditSlaMinutes" type="number" min="0" name="slaMinutes" class="field" placeholder="Ex.: 240" /><p class="mt-1 text-xs text-slate-400">Tempo-alvo de atendimento; não mede esforço estimado nem prazo de entrega.</p></div> }
                    <div class="rounded-lg border border-red-100 bg-red-50 p-3"><label class="flex items-center gap-2 text-sm font-bold text-red-700"><input id="EditIsBlocked" type="checkbox" name="isBlocked" value="true" /> Esta demanda está bloqueada</label><input id="EditBlockerReason" name="blockerReason" maxlength="500" class="field mt-2" placeholder="Explique o que impede o andamento" /></div>
                </div>
            </details>
            <div id="editTaskError" role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 md:col-span-3"></div>
            <div class="flex justify-between border-t border-slate-100 pt-5 md:col-span-3">
                @if(Model.CanManageBoard){<button type="button" onclick="confirmDeleteTask()" class="rounded-lg px-4 py-2 text-sm font-bold text-red-600 hover:bg-red-50">Arquivar</button>}else{<span></span>}
                <button type="submit" class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-bold text-white">Salvar alterações</button>
            </div>
        </form>
        </section>
        <section data-task-panel="activity" class="hidden">
        <div class="p-6">
            <div class="mb-5 rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900"><strong>Use esta área para registrar a execução da atividade.</strong><p class="mt-1 text-xs text-indigo-700">A conversa guarda orientações, dúvidas e prints ligados à mensagem. Documentos, planilhas, PDFs e entregáveis devem ser enviados na área de arquivos.</p></div>
            <div id="taskExtraContent"></div>
            <form id="commentForm" asp-controller="Boards" asp-action="AddComment" method="post" enctype="multipart/form-data" class="mt-6 rounded-xl border border-indigo-100 bg-indigo-50/40 p-4">
                <input class="task-id-target" type="hidden" name="taskId" />
                <label class="label">Conversa e evidências visuais</label>
                <p class="mb-3 text-xs text-slate-500">Registre atualizações, orientações ou dúvidas. Use imagens para prints e evidências que façam sentido junto desta mensagem.</p>
                <textarea name="content" rows="3" maxlength="5000" class="field" placeholder="Ex.: Ajuste concluído; segue print da validação."></textarea>
                <div class="mt-3 grid gap-2 md:grid-cols-2"><div><label class="label">Responder a uma mensagem <span class="font-normal text-slate-400">(opcional)</span></label><select id="CommentReplyTo" name="replyToId" class="field"><option value="">Iniciar nova mensagem</option>@foreach(var c in Model.Comments.Where(x=>!x.DeletedAt.HasValue).OrderByDescending(x=>x.CreatedAt)){<option class="comment-reply-option" data-task-id="@c.TaskId" value="@c.Id">Responder: @c.Content[..Math.Min(60,c.Content.Length)]</option>}</select></div><div><label class="label">Avisar pessoas envolvidas <span class="font-normal text-slate-400">(opcional)</span></label><div class="max-h-24 overflow-y-auto rounded-lg border bg-white p-2">@foreach(var p in Model.Profiles.Where(x=>x.IsActive)){<label class="comment-mention-option mr-3 inline-flex items-center gap-1 text-xs" data-user-id="@p.Id"><input type="checkbox" name="mentionedUserIds" value="@p.Id"/> @(p.FullName??p.Email)</label>}</div><p id="commentMentionEmpty" class="mt-1 hidden text-xs text-slate-400">Nenhuma outra pessoa está vinculada a esta demanda.</p></div></div>
                <div id="chatImagePreview" class="mt-3 hidden grid-cols-2 gap-2 sm:grid-cols-4"></div>
                <div id="commentFormError" role="alert" class="mt-3 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                <div id="commentFormStatus" role="status" class="mt-3 hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
                <div class="mt-3 flex flex-wrap items-center justify-between gap-3"><label class="cursor-pointer rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 hover:border-indigo-300"><input id="ChatImages" type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple class="hidden"/>📷 Anexar imagens à mensagem</label><div class="flex items-center gap-3"><span class="text-[10px] text-slate-400">Prints e evidências · até 4 imagens de 8 MB</span><button type="submit" class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-bold text-white disabled:cursor-wait disabled:opacity-60">Enviar mensagem</button></div></div>
            </form>
            <div class="mt-6 grid gap-3 md:grid-cols-2">
                <form id="checklistForm" asp-controller="Boards" asp-action="AddChecklistItem" method="post" class="rounded-xl border border-slate-200 p-3"><label class="label">Checklist de conclusão</label><p class="mb-2 text-xs text-slate-500">Itens que precisam estar prontos antes de concluir a atividade.</p><div class="flex gap-2"><input class="task-id-target" type="hidden" name="taskId" /><input name="title" required class="field" placeholder="Ex.: Validar com o cliente" /><input type="hidden" name="position" value="999" /><button type="submit" title="Adicionar item" class="rounded-lg bg-slate-900 px-3 text-white">+</button></div></form>
                <form id="timeLogForm" asp-controller="Boards" asp-action="AddTimeLog" method="post" class="rounded-xl border border-slate-200 p-3"><label class="label">Apontamento de tempo</label><p class="mb-2 text-xs text-slate-500">Registre o esforço realizado. Ao enviar para faturamento, descreva a atividade: ela será revisada antes de compor uma fatura.</p><div class="grid grid-cols-4 gap-2"><input class="task-id-target" type="hidden" name="taskId" /><input type="number" min="0" name="hours" class="field" placeholder="Horas" aria-label="Horas" /><input type="number" min="0" max="59" name="minutes" class="field" placeholder="Min" aria-label="Minutos" /><input type="date" name="logDate" class="field col-span-2" aria-label="Data do apontamento" /><input name="description" class="field col-span-3" placeholder="O que foi realizado?" /><button type="submit" title="Registrar horas" class="rounded-lg bg-slate-900 text-white">+</button><label class="col-span-4 flex items-center gap-2 text-xs text-slate-600"><input type="checkbox" name="isBillable" value="true" checked /><input type="hidden" name="isBillable" value="false" /> Enviar para aprovação de faturamento</label></div></form>
            </div>
            <div class="mt-4 grid gap-3 md:grid-cols-2">
                <form id="subtaskForm" asp-controller="Boards" asp-action="CreateSubtask" method="post" class="grid grid-cols-2 gap-2 rounded-xl border p-3"><div class="col-span-2"><label class="label">Subtarefas</label><p class="text-xs text-slate-500">Divida a atividade em entregas menores, com responsável, prazo e estimativa próprios.</p></div><input class="task-id-target" type="hidden" name="parentTaskId"/><input name="title" required class="field col-span-2" placeholder="Ex.: Revisar os dados importados"/><select name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach(var p in Model.Profiles.Where(x=>x.IsActive)){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><input type="date" name="dueDate" class="field" aria-label="Prazo da subtarefa"/><input type="number" name="estimatedMinutes" min="0" class="field" placeholder="Estimativa (min)"/><button type="submit" class="rounded-lg bg-indigo-600 text-sm font-bold text-white">Criar subtarefa</button></form>
                <form id="taskFileForm" asp-controller="Boards" asp-action="AddTaskFile" method="post" enctype="multipart/form-data" class="grid grid-cols-2 gap-2 rounded-xl border p-3"><div class="col-span-2"><label class="label">Documentos e entregáveis</label><p class="text-xs text-slate-500">Use para arquivos que devem permanecer organizados na tarefa: PDFs, planilhas, documentos e versões formais. Para prints de uma conversa, use “Anexar imagens à mensagem”.</p></div><input class="task-id-target" type="hidden" name="taskId"/><input type="file" name="file" required class="field col-span-2"/><input name="description" class="field" placeholder="Descrição e contexto do documento"/><select id="PreviousTaskFile" name="previousVersionId" class="field"><option value="">Novo documento</option>@foreach(var existingFile in Model.Files.OrderByDescending(x=>x.CreatedAt)){<option class="task-file-version-option" data-task-id="@existingFile.TaskId" value="@existingFile.Id">Nova versão de @existingFile.FileName (v@existingFile.Version)</option>}</select><button type="submit" class="col-span-2 rounded-lg bg-slate-900 py-2 text-sm font-bold text-white">Enviar documento/arquivo</button><span class="col-span-2 text-[10px] text-slate-400">Documentos, planilhas, PDFs e imagens de referência · até 25 MB</span></form>
            </div>
        </div>
        </section>
        <section data-task-panel="workflow" class="hidden">
        <div class="p-6">
            <div class="mb-5 rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-900"><strong>Use esta área quando o trabalho depender de outra atividade ou pessoa.</strong><p class="mt-1 text-xs text-sky-700">Se a execução é direta, você não precisa preencher nada aqui.</p></div>
            <div class="mb-6 rounded-xl border border-sky-100 bg-sky-50 p-4"><h3 class="text-sm font-bold text-sky-900">Pré-requisitos da atividade</h3><p class="mb-3 mt-1 text-xs text-sky-700"><strong>Exemplo:</strong> “Publicar em produção” depende de “Concluir os testes”. Enquanto o teste estiver pendente, o sistema impede o aceite da publicação.</p><form id="dependencyForm" asp-controller="Work" asp-action="AddDependency" method="post" class="flex gap-2"><input class="task-id-target" type="hidden" name="taskId"/><select name="dependsOnTaskId" required class="field"><option value="">Esta atividade depende de...</option>@foreach(var candidate in Model.Tasks){<option class="dependency-task-option" value="@candidate.Id">@candidate.Title</option>}</select><button type="submit" class="rounded-lg bg-sky-700 px-4 text-sm font-bold text-white">Adicionar</button></form></div>
            <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4"><h3 class="font-bold text-amber-900">Tenho uma dúvida — devolver a ação</h3><p class="mb-3 mt-1 text-xs text-amber-700">A dúvida entra na conversa, a outra pessoa recebe um alerta e a atividade volta para a caixa de entrada dela. Você continua acompanhando.</p><form id="returnQuestionForm" asp-controller="Work" asp-action="ReturnWithQuestion" method="post" class="grid gap-3 md:grid-cols-[220px_1fr_auto]"><input class="task-id-target" type="hidden" name="taskId"/><select name="toUserId" required class="field"><option value="">Quem deve responder?</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName ?? p.Email)</option>}</select><textarea name="question" required maxlength="5000" rows="2" class="field" placeholder="Descreva sua dúvida com contexto..."></textarea><button type="submit" class="rounded-lg bg-amber-600 px-4 text-sm font-bold text-white">Devolver com dúvida</button></form></div>
            <h3 class="mb-1 text-lg font-bold">Enviar para a próxima etapa</h3>
            <p class="mb-4 text-sm text-slate-500">Transfere a ação, mantém os envolvidos acompanhando e pode exigir uma validação única após a entrega.</p>
            <form id="handoffTaskForm" asp-controller="Work" asp-action="Handoff" method="post" class="grid gap-3 md:grid-cols-4">
                <input class="task-id-target" type="hidden" name="taskId" />
                <div><label class="label">Próxima etapa</label><select name="stage" required class="field">@foreach(var c in Model.Columns){<option value="@c.Id">@c.Title</option>}</select></div>
                <div><label class="label">Novo executor</label><select name="toUserId" required class="field"><option value="">Selecione</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName ?? p.Email)</option>}</select></div>
                <div><label class="label">Prazo da etapa</label><input type="date" name="handoffDueDate" class="field" /></div>
                <div><label class="label">Esforço previsto nesta etapa</label><div class="grid grid-cols-2 gap-2"><input type="number" min="0" name="estimatedHours" class="field" placeholder="h"/><input type="number" min="0" max="59" name="estimatedMinutes" class="field" placeholder="min"/></div></div>
                <div class="md:col-span-2"><label class="label">Instruções</label><textarea name="notes" rows="2" class="field"></textarea></div>
                <div class="md:col-span-2"><label class="label">Critérios de aceite</label><textarea name="acceptanceCriteria" rows="2" class="field"></textarea></div>
                <div class="rounded-lg border border-indigo-100 bg-indigo-50 p-3 text-sm md:col-span-4"><label class="flex items-center gap-2 font-semibold text-indigo-950"><input id="HandoffRequiresAcceptance" type="checkbox" name="requiresAcceptance" value="true" /> Esta entrega precisa de validação após o executor concluir</label><p class="mt-1 text-xs text-indigo-700">Use para uma validação única. Para vários validadores em sequência, use “Validação da entrega” nas Operações do projeto.</p><div id="HandoffAcceptanceConfig" class="mt-3"><label class="label">Quem valida esta entrega?</label><select id="HandoffAcceptanceBy" name="acceptanceBy" class="field"><option value="">Responsável principal</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName ?? p.Email)</option>}</select></div></div>
                <div id="handoffTaskError" role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 md:col-span-4"></div>
                <div class="md:col-span-4 flex justify-end"><button type="submit" class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-bold text-white">Transferir ação</button></div>
            </form>
        </div>
        </section>
        <form id="deleteTaskForm" asp-controller="Boards" asp-action="DeleteTask" method="post" class="hidden"><input id="DeleteTaskId" name="taskId" /></form>
    </div>
</div>
