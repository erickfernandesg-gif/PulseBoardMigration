@model PulseBoardMigration.Models.EnterprisePlanningViewModel
@{
    string DependencyLabel(string value) => value switch { "start_to_start" => "Começar junto", "finish_to_finish" => "Terminar junto", "start_to_finish" => "Terminar após o início", _ => "Começar após o término" };
}

<div id="prazos" class="planning-panel space-y-5" role="tabpanel" hidden>
    <section class="rounded-2xl border bg-white p-5"><h2 class="text-xl font-bold">Prazos e vínculos</h2><p class="mt-1 text-sm text-slate-500">Salve o plano aprovado e informe a ordem entre projetos. Assim, o sistema mostra desvios e conflitos.</p></section>
    <div class="grid gap-5 xl:grid-cols-2">
        <section class="rounded-2xl border bg-white p-5">
            <h2 class="text-lg font-bold">Plano de referência <span class="text-sm font-normal text-slate-400">(baseline)</span></h2><p class="mt-1 text-xs text-slate-500">É uma fotografia do projeto aprovado para comparar prazo e esforço com a situação atual.</p>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Salvar novo plano de referência</summary><div class="mt-3 rounded-lg bg-amber-50 p-3 text-xs text-amber-800">Crie uma versão somente após uma aprovação formal. A anterior continuará disponível para auditoria.</div><form asp-action="CaptureBaseline" method="post" class="mt-3 grid gap-3 sm:grid-cols-2"><label class="text-xs font-semibold">Projeto<select name="boardId" required class="field mt-1"><option value="">Selecione</option>@foreach (var b in Model.Boards) { <option value="@b.Id">@b.Name</option> }</select></label><label class="text-xs font-semibold">Nome da versão<input name="name" maxlength="120" class="field mt-1" placeholder="Ex.: Plano aprovado Q3" /></label><button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Salvar fotografia do plano</button></form></details>
            <div class="mt-4 max-h-80 space-y-2 overflow-y-auto">@foreach (var item in Model.Baselines) { <div class="rounded-lg @(item.IsActive ? "border border-indigo-200 bg-indigo-50" : "bg-slate-50") p-3 text-sm"><div class="flex justify-between gap-3"><strong>@Model.Board(item.BoardId)?.Name</strong><span class="text-xs font-bold">Versão @item.Version @(item.IsActive ? "· ATUAL" : "")</span></div><p class="mt-1 text-xs text-slate-500">@item.Name · salva em @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p class="text-xs text-slate-400">Término aprovado: @(item.PlannedEnd?.ToString("dd/MM/yyyy") ?? "não informado")</p></div> } @if (!Model.Baselines.Any()) { <div class="rounded-xl border border-dashed p-6 text-center"><strong class="block text-sm text-slate-600">Nenhum plano de referência salvo</strong><span class="text-xs text-slate-400">Salve a primeira versão depois que o projeto for aprovado.</span></div> }</div>
        </section>
        <section class="rounded-2xl border bg-white p-5">
            <h2 class="text-lg font-bold">Ordem entre projetos</h2><p class="mt-1 text-xs text-slate-500">Informe quando um projeto só pode começar ou terminar após outro.</p>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Criar vínculo entre projetos</summary><form asp-action="AddDependency" method="post" class="mt-3 grid gap-3 border-t border-indigo-100 pt-3 sm:grid-cols-2"><label class="text-xs font-semibold">Primeiro projeto<select name="predecessor" required class="field mt-1"><option value="">Selecione</option>@foreach (var b in Model.Boards) { <option value="@b.Id">@b.Name</option> }</select></label><label class="text-xs font-semibold">Projeto que depende dele<select name="successor" required class="field mt-1"><option value="">Selecione</option>@foreach (var b in Model.Boards) { <option value="@b.Id">@b.Name</option> }</select></label><label class="text-xs font-semibold">Regra<select name="type" class="field mt-1"><option value="finish_to_start">Começar após o término</option><option value="start_to_start">Começar junto</option><option value="finish_to_finish">Terminar junto</option><option value="start_to_finish">Terminar após o início</option></select></label><label class="text-xs font-semibold">Intervalo em dias<input type="number" name="lagDays" min="-365" max="365" value="0" class="field mt-1" /></label><button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Salvar vínculo</button></form></details>
            <div class="mt-4 max-h-80 space-y-2 overflow-y-auto">@foreach (var item in Model.PortfolioDependencies) { <div class="flex items-start justify-between gap-3 rounded-lg bg-slate-50 p-3 text-sm"><div><strong>@Model.Board(item.PredecessorBoardId)?.Name</strong><span class="mx-1 text-slate-400">→</span><strong>@Model.Board(item.SuccessorBoardId)?.Name</strong><p class="mt-1 text-xs text-slate-500">@DependencyLabel(item.DependencyType) · intervalo de @item.LagDays dia(s)</p></div><form asp-action="DeleteDependency" method="post" onsubmit="return confirm('Remover este vínculo?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-xs font-bold text-red-500">Remover</button></form></div> } @if (!Model.PortfolioDependencies.Any()) { <div class="rounded-xl border border-dashed p-6 text-center"><strong class="block text-sm text-slate-600">Nenhum vínculo criado</strong><span class="text-xs text-slate-400">Se os projetos forem independentes, não é necessário cadastrar nada.</span></div> }</div>
        </section>
    </div>
</div>
