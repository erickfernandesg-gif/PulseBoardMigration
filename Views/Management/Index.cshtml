@model PulseBoardMigration.Models.ManagementViewModel
@{
    ViewData["Title"] = "Equipe";
    var today = Model.PeriodStart;
}

<header class="mb-5 rounded-2xl bg-slate-900 p-5 text-white sm:p-7">
    <p class="text-xs font-bold uppercase tracking-widest text-indigo-300">Gestão operacional</p>
    <h1 class="mt-1 text-3xl font-bold">Equipe nesta semana</h1>
    <p class="mt-2 max-w-3xl text-sm text-slate-300">Equilibre a capacidade disponível de @Model.PeriodStart.ToString("dd/MM") a @Model.PeriodEnd.ToString("dd/MM"). Esta tela usa estimativas e prazos; não mede horas apontadas nem faturamento.</p>
</header>

<nav class="mb-5 flex overflow-x-auto rounded-xl border bg-white p-1 text-sm font-bold" aria-label="Rotinas relacionadas">
    <a href="/Planning" class="whitespace-nowrap rounded-lg px-4 py-2 text-slate-600 hover:bg-slate-50">Planejamento e portfólio</a>
    <a href="/Management" class="whitespace-nowrap rounded-lg bg-slate-900 px-4 py-2 text-white">Equipe nesta semana</a>
    <a href="/Schedule" class="whitespace-nowrap rounded-lg px-4 py-2 text-slate-600 hover:bg-slate-50">Cronograma</a>
    <a href="/Reports" class="whitespace-nowrap rounded-lg px-4 py-2 text-slate-600 hover:bg-slate-50">Horas realizadas</a>
</nav>

<section class="mb-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-950">
    <strong>Como ler:</strong> “Planejado” soma apenas tarefas com estimativa e ao menos uma data. “Disponível” já desconta feriados e ausências aprovadas. Corrija primeiro as pendências sem planejamento; depois distribua a carga.
</section>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <a href="#carga" class="rounded-xl border bg-white p-4 transition hover:border-red-200 hover:bg-red-50"><p class="text-xs font-bold uppercase text-slate-400">Pessoas sobrecarregadas</p><p class="mt-1 text-2xl font-bold text-red-600">@Model.OverloadedPeople</p><p class="mt-1 text-xs text-slate-500">Planejado acima do disponível</p></a>
    <a href="#carga" class="rounded-xl border bg-white p-4 transition hover:border-amber-200 hover:bg-amber-50"><p class="text-xs font-bold uppercase text-slate-400">Sem planejamento</p><p class="mt-1 text-2xl font-bold text-amber-600">@Model.OpenTasksWithoutPlanning</p><p class="mt-1 text-xs text-slate-500">Sem estimativa ou sem período</p></a>
    <a href="#carga" class="rounded-xl border bg-white p-4 transition hover:border-indigo-200 hover:bg-indigo-50"><p class="text-xs font-bold uppercase text-slate-400">Sem responsável</p><p class="mt-1 text-2xl font-bold text-indigo-600">@Model.OpenUnassignedTasks</p><p class="mt-1 text-xs text-slate-500">Tarefas abertas para distribuir</p></a>
    <a href="#carga" class="rounded-xl border bg-white p-4 transition hover:border-slate-300 hover:bg-slate-50"><p class="text-xs font-bold uppercase text-slate-400">Capacidade não configurada</p><p class="mt-1 text-2xl font-bold">@Model.PeopleWithoutConfiguredCapacity</p><p class="mt-1 text-xs text-slate-500">A tela considera 40 h por semana</p></a>
</div>

<section id="carga" class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
    <div class="border-b p-5"><h2 class="text-lg font-bold">Distribuição da semana</h2><p class="mt-1 text-sm text-slate-500">Ajuste a capacidade contratada da pessoa quando necessário. Disponível e planejado usam o mesmo período.</p></div>
    <table class="w-full min-w-[980px] text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Pessoa</th><th>Disponível</th><th>Planejado</th><th>Situação</th><th>Pendências</th><th>Capacidade semanal</th></tr></thead>
        <tbody class="divide-y">
        @foreach (var person in Model.Workloads)
        {
            var state = person.PlannedMinutes > person.EffectiveCapacityMinutes ? "Sobrecarregada" : person.PlannedMinutes == 0 ? "Sem carga planejada" : "Dentro da capacidade";
            var stateClass = person.PlannedMinutes > person.EffectiveCapacityMinutes ? "bg-red-100 text-red-700" : person.PlannedMinutes == 0 ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700";
            <tr data-searchable>
                <td class="p-4"><strong>@person.Name</strong><small class="block text-slate-400">@person.Email</small></td>
                <td><strong>@((person.AvailableMinutes / 60m).ToString("0.#")) h</strong><small class="block text-slate-400">de @((person.EffectiveCapacityMinutes / 60m).ToString("0.#")) h no período</small></td>
                <td><strong>@((person.PlannedMinutes / 60m).ToString("0.#")) h</strong><small class="block text-slate-400">estimativas com data</small></td>
                <td><span class="rounded-full px-2 py-1 text-xs font-bold @stateClass">@state</span><small class="mt-1 block text-slate-400">@person.UtilizationPercent.ToString("0")% da capacidade</small></td>
                <td><span class="font-bold text-red-600">@person.OverdueTasks atrasada(s)</span><span class="mx-1 text-slate-300">·</span><span class="font-bold text-amber-600">@person.BlockedTasks bloqueada(s)</span><small class="mt-1 block text-slate-400">@person.PendingAssignments aguardando aceite · @person.UnplannedTasks sem planejamento</small></td>
                <td><form asp-action="SaveCapacity" method="post" class="flex items-center gap-2"><input type="hidden" name="userId" value="@person.UserId" /><label class="sr-only" for="capacity-@person.UserId">Capacidade semanal de @person.Name</label><input id="capacity-@person.UserId" type="number" name="weeklyHours" min="0" max="168" step="0.5" value="@(person.WeeklyCapacityMinutes / 60m)" class="field !w-24" /><button class="text-xs font-bold text-indigo-600">Salvar</button></form><small class="mt-1 block text-slate-400">@(person.HasConfiguredCapacity ? "Configurada" : "Padrão de 40 h — confirme")</small></td>
            </tr>
        }
        @if (!Model.Workloads.Any()) { <tr><td colspan="6" class="p-8 text-center text-slate-500">Não há pessoas ativas na equipe para exibir.</td></tr> }
        </tbody>
    </table>
</section>

<div class="mt-7 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-1 text-lg font-bold">O que exige ação agora</h2><p class="mb-4 text-sm text-slate-500">Bloqueios e atrasos que podem afetar a semana.</p><div class="space-y-2">@foreach (var task in Model.Tasks.Where(x => x.Status != "done" && (x.IsBlocked || x.DueDate < today)).OrderBy(x => x.DueDate).Take(20)) { var owner = Model.Profiles.FirstOrDefault(x => x.Id == task.AssignedTo); var board = Model.Boards.FirstOrDefault(x => x.Id == task.BoardId); <a href="/Boards/Details/@task.BoardId" class="flex justify-between rounded-lg bg-slate-50 p-3 text-sm hover:bg-slate-100"><span><strong>@task.Title</strong><small class="block text-slate-400">@(board?.Name ?? "Projeto") · @(owner?.FullName ?? owner?.Email)</small></span><span class="text-xs font-bold @(task.IsBlocked ? "text-amber-600" : "text-red-600")">@(task.IsBlocked ? "Bloqueada" : "Atrasada")</span></a>}@if (!Model.Tasks.Any(x => x.Status != "done" && (x.IsBlocked || x.DueDate < today))) { <p class="py-4 text-sm text-slate-500">Nenhuma tarefa bloqueada ou atrasada nesta equipe.</p> }</div></section>
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-1 text-lg font-bold">Atribuições aguardando aceite</h2><p class="mb-4 text-sm text-slate-500">Estas transferências ainda não entraram em execução.</p><div class="space-y-2">@foreach (var item in Model.Assignments.Where(x => x.Status == "pending").OrderByDescending(x => x.CreatedAt).Take(15)) { var task = Model.Tasks.FirstOrDefault(x => x.Id == item.TaskId); var to = Model.Profiles.FirstOrDefault(x => x.Id == item.ToUserId); if (task != null) { <a href="/Boards/Details/@task.BoardId" class="block rounded-lg bg-slate-50 p-3 text-sm hover:bg-slate-100"><strong>@task.Title</strong><p class="text-xs text-slate-500">Aguardando aceite de @(to?.FullName ?? to?.Email)</p></a> } }@if (!Model.Assignments.Any(x => x.Status == "pending")) { <p class="py-4 text-sm text-slate-500">Não há transferências pendentes.</p> }</div></section>
</div>
