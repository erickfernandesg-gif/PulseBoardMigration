@model PulseBoardMigration.Models.EnterprisePlanningViewModel
@using System.Text.Json
@{
    var activeTemplates = Model.Templates.Where(x => x.IsActive).ToList();
}

<div id="automacoes" class="planning-panel space-y-5" role="tabpanel" hidden>
    <section class="rounded-2xl border bg-white p-5"><h2 class="text-xl font-bold">Modelos e automações</h2><p class="mt-1 text-sm text-slate-500">Padronize tarefas frequentes e programe a criação automática do trabalho repetitivo.</p><div class="mt-3 rounded-xl bg-slate-50 p-3 text-xs text-slate-600"><strong>Dica:</strong> crie primeiro um modelo com as informações padrão. Depois use esse modelo em uma automação.</div></section>
    <div class="grid gap-5 xl:grid-cols-2">
        <section class="rounded-2xl border bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-indigo-500">Passo 1</p><h2 class="text-lg font-bold">Modelos de tarefa</h2><p class="text-xs text-slate-500">Preenchem automaticamente título, descrição, prioridade e estimativa.</p>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Criar modelo</summary><form asp-action="SaveTemplate" method="post" class="mt-3 grid gap-3 border-t border-indigo-100 pt-3 sm:grid-cols-2"><label class="text-xs font-semibold sm:col-span-2">Nome do modelo<input name="name" maxlength="120" required class="field mt-1" placeholder="Ex.: Reunião mensal com cliente" /></label><label class="text-xs font-semibold">Disponível no projeto<select name="boardId" class="field mt-1"><option value="">Todos os projetos</option>@foreach (var b in Model.Boards) { <option value="@b.Id">@b.Name</option> }</select></label><label class="text-xs font-semibold">Disponível para a equipe<select name="teamId" class="field mt-1"><option value="">Todas as equipes</option>@foreach (var team in Model.Teams) { <option value="@team.Id">@team.Name</option> }</select></label><label class="text-xs font-semibold">Estimativa em minutos<input type="number" name="estimatedMinutes" min="0" max="100000" class="field mt-1" placeholder="Ex.: 60" /></label><label class="text-xs font-semibold">Prioridade<select name="priority" class="field mt-1"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></label><label class="text-xs font-semibold sm:col-span-2">Descrição padrão<textarea name="description" maxlength="5000" class="field mt-1" rows="3" placeholder="Explique como a tarefa deve ser executada"></textarea></label><button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Salvar modelo</button></form></details>
            <div class="mt-4 max-h-80 space-y-2 overflow-y-auto">@foreach (var item in Model.Templates) { <div class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 p-3 text-sm"><div><strong>@item.Name</strong><p class="text-xs text-slate-500">@(item.BoardId.HasValue ? Model.Board(item.BoardId.Value)?.Name : "Todos os projetos") · @(item.IsActive ? "Disponível" : "Desativado")</p></div><form asp-action="ToggleTemplate" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="active" value="@(!item.IsActive)" /><button class="text-xs font-bold @(item.IsActive ? "text-red-500" : "text-emerald-600")">@(item.IsActive ? "Desativar" : "Reativar")</button></form></div> } @if (!Model.Templates.Any()) { <div class="rounded-xl border border-dashed p-6 text-center text-sm text-slate-400">Nenhum modelo criado.</div> }</div>
        </section>

        <section class="rounded-2xl border bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-indigo-500">Passo 2</p><h2 class="text-lg font-bold">Automação de tarefas</h2><p class="text-xs text-slate-500">Cria tarefas automaticamente nos dias programados.</p>
            <details class="mt-4 rounded-xl border border-indigo-200 bg-indigo-50 p-3"><summary class="cursor-pointer list-none text-sm font-bold text-indigo-700">+ Programar automação</summary><form asp-action="SaveRecurring" method="post" class="mt-3 grid gap-3 border-t border-indigo-100 pt-3 sm:grid-cols-2">
                <label class="text-xs font-semibold">Projeto<select id="RecurringBoard" name="boardId" required class="field mt-1"><option value="">Selecione</option>@foreach (var b in Model.Boards) { <option value="@b.Id" data-columns="@JsonSerializer.Serialize(b.Settings.Select(x => new { id = x.Id, title = x.Title }))">@b.Name</option> }</select></label>
                <label class="text-xs font-semibold">Usar modelo<select id="RecurringTemplate" name="templateId" class="field mt-1"><option value="">Sem modelo</option>@foreach (var template in activeTemplates) { var priority = template.Definition.TryGetValue("priority", out var tp) ? tp?.ToString() ?? "medium" : "medium"; var minutes = template.Definition.TryGetValue("estimatedMinutes", out var tm) ? tm?.ToString() ?? "0" : "0"; <option value="@template.Id" data-board-id="@template.BoardId" data-name="@template.Name" data-description="@template.Description" data-priority="@priority" data-estimated-minutes="@minutes">@template.Name</option> }</select></label>
                <label class="text-xs font-semibold">Título da tarefa<input id="RecurringTitle" name="title" maxlength="200" required class="field mt-1" /></label><label class="text-xs font-semibold">Coluna de destino<select id="RecurringStatus" name="targetStatus" required class="field mt-1" disabled><option value="">Selecione o projeto</option></select></label>
                <label class="text-xs font-semibold">Repetir<select name="cadence" class="field mt-1"><option value="daily">Todos os dias</option><option value="weekly" selected>Toda semana</option><option value="monthly">Todo mês</option></select></label><label class="text-xs font-semibold">A cada<input type="number" name="intervalCount" min="1" max="365" value="1" class="field mt-1" /><span class="mt-1 block font-normal text-slate-400">Ex.: 2 significa a cada duas semanas.</span></label>
                <label class="text-xs font-semibold">Primeira criação<input type="datetime-local" name="nextRunAt" required class="field mt-1" /></label><label class="text-xs font-semibold">Responsável<select name="assignedTo" class="field mt-1"><option value="">Definir depois</option>@foreach (var p in Model.Profiles) { <option value="@p.Id">@(p.FullName ?? p.Email)</option> }</select></label>
                <label class="text-xs font-semibold">Prioridade<select id="RecurringPriority" name="priority" class="field mt-1"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></label><label class="text-xs font-semibold">Estimativa em minutos<input id="RecurringEstimatedMinutes" type="number" name="estimatedMinutes" min="0" max="100000" class="field mt-1" /></label>
                <label class="text-xs font-semibold sm:col-span-2">Descrição<textarea id="RecurringDescription" name="description" maxlength="5000" class="field mt-1" rows="3"></textarea></label>
                <details class="rounded-lg bg-white p-3 sm:col-span-2"><summary class="cursor-pointer text-xs font-bold text-slate-600">Opções avançadas</summary><div class="mt-3 grid gap-3 sm:grid-cols-2"><label class="text-xs font-semibold">Prazo após criação (dias)<input type="number" name="dueAfterDays" min="0" max="365" value="0" class="field mt-1" /></label><label class="text-xs font-semibold">Fuso horário<select name="timeZone" class="field mt-1"><option value="America/Sao_Paulo">Brasília</option><option value="UTC">UTC</option></select></label><label class="text-xs font-semibold">Encerrar após<input type="datetime-local" name="endsAt" class="field mt-1" /></label><label class="text-xs font-semibold">Máximo de tarefas<input type="number" name="maxOccurrences" min="1" max="10000" class="field mt-1" placeholder="Sem limite" /></label></div></details>
                <button class="rounded-lg bg-indigo-600 py-2.5 text-sm font-bold text-white sm:col-span-2">Ativar automação</button>
            </form></details>
            <div class="mt-4 max-h-96 space-y-2 overflow-y-auto">
            @foreach (var item in Model.RecurringRules)
            {
                var board = Model.Board(item.BoardId);
                <details class="rounded-lg bg-slate-50 p-3 text-sm"><summary class="flex cursor-pointer list-none items-start justify-between gap-3"><span><strong>@item.Title</strong><span class="ml-2 rounded-full px-2 py-0.5 text-[10px] font-bold @(item.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-500")">@(item.IsActive ? "ATIVA" : "PAUSADA")</span><small class="mt-1 block text-slate-500">@board?.Name · próxima em @item.NextRunAt.ToLocalTime().ToString("dd/MM HH:mm") · @item.OccurrencesCreated criada(s)</small></span><span class="text-xs font-bold text-indigo-600">Configurar</span></summary>
                    <form asp-action="UpdateRecurring" method="post" class="mt-3 grid gap-2 border-t pt-3 sm:grid-cols-2"><input type="hidden" name="id" value="@item.Id" /><label class="text-xs">Título<input name="title" required maxlength="200" value="@item.Title" class="field mt-1" /></label><label class="text-xs">Coluna<select name="targetStatus" class="field mt-1">@foreach (var column in board?.Settings ?? []) { <option value="@column.Id" selected="@(column.Id == item.TargetStatus)">@column.Title</option> }</select></label><label class="text-xs">Frequência<select name="cadence" class="field mt-1"><option value="daily" selected="@(item.Cadence == "daily")">Diária</option><option value="weekly" selected="@(item.Cadence == "weekly")">Semanal</option><option value="monthly" selected="@(item.Cadence == "monthly")">Mensal</option></select></label><label class="text-xs">Intervalo<input type="number" name="intervalCount" min="1" max="365" value="@item.IntervalCount" class="field mt-1" /></label><label class="text-xs">Próxima criação<input type="datetime-local" name="nextRunAt" required value="@item.NextRunAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" class="field mt-1" /></label><label class="text-xs">Fuso<select name="timeZone" class="field mt-1"><option value="America/Sao_Paulo" selected="@(item.TimeZone == "America/Sao_Paulo")">Brasília</option><option value="UTC" selected="@(item.TimeZone == "UTC")">UTC</option></select></label><label class="text-xs">Responsável<select name="assignedTo" class="field mt-1"><option value="">Definir depois</option>@foreach (var p in Model.Profiles) { <option value="@p.Id" selected="@(item.AssignedTo == p.Id)">@(p.FullName ?? p.Email)</option> }</select></label><label class="text-xs">Prioridade<select name="priority" class="field mt-1"><option value="low" selected="@(item.Priority == "low")">Baixa</option><option value="medium" selected="@(item.Priority == "medium")">Média</option><option value="high" selected="@(item.Priority == "high")">Alta</option><option value="critical" selected="@(item.Priority == "critical")">Crítica</option></select></label><label class="text-xs">Estimativa (min)<input type="number" name="estimatedMinutes" min="0" max="100000" value="@item.EstimatedMinutes" class="field mt-1" /></label><label class="text-xs">Prazo após criação (dias)<input type="number" name="dueAfterDays" min="0" max="365" value="@item.DueAfterDays" class="field mt-1" /></label><label class="text-xs">Encerrar após<input type="datetime-local" name="endsAt" value="@item.EndsAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" class="field mt-1" /></label><label class="text-xs">Máximo de tarefas<input type="number" name="maxOccurrences" min="@(item.OccurrencesCreated + 1)" max="10000" value="@item.MaxOccurrences" class="field mt-1" placeholder="Sem limite" /></label><label class="text-xs sm:col-span-2">Descrição<textarea name="description" maxlength="5000" class="field mt-1">@item.Description</textarea></label><button class="rounded-lg bg-indigo-600 py-2 text-xs font-bold text-white sm:col-span-2">Salvar alterações</button></form>
                    <form asp-action="ToggleRecurring" method="post" class="mt-2 text-right"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="active" value="@(!item.IsActive)" /><button class="text-xs font-bold @(item.IsActive ? "text-red-500" : "text-emerald-600")">@(item.IsActive ? "Pausar automação" : "Retomar automação")</button></form>
                </details>
            }
            @if (!Model.RecurringRules.Any()) { <div class="rounded-xl border border-dashed p-6 text-center text-sm text-slate-400">Nenhuma automação programada.</div> }
            </div>
        </section>
    </div>
</div>
