@model PulseBoardMigration.Models.MyWorkViewModel
@{
    ViewData["Title"] = "Início";
    var pending = Model.PendingAssignments;
    var review = Model.ReviewTasks;
    var urgent = Model.UrgentTasks;
    var next = Model.NextTasks;
    var active = Model.ActiveTasks;
    var waiting = Model.WaitingTasks;
    var recentlyDone = Model.RecentlyCompletedTasks;
    var firstName = Model.CurrentUser?.FullName?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

    string TaskUrl(PulseTask task, string tab = "summary") =>
        $"/Boards/Details/{task.BoardId}?taskId={task.Id}&tab={tab}";
    string DueLabel(PulseTask task) => task.DueDate?.ToString("dd/MM/yyyy") ?? "Sem prazo";
    bool IsOverdue(PulseTask task) => task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.UtcNow.Date;
}

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">PulseBoard</p>
        <h1 class="mt-1 text-3xl font-bold">@(string.IsNullOrWhiteSpace(firstName) ? "Meu trabalho" : $"Olá, {firstName}")</h1>
        <p class="mt-1 text-sm text-slate-500">Comece pelo que precisa da sua atenção agora.</p>
    </div>
    @if (Model.CanManage)
    {
        <a href="/Boards" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700">
            <i data-lucide="plus" class="h-4 w-4"></i> Nova demanda
        </a>
    }
</div>

@if (!Model.Boards.Any())
{
    <section class="rounded-2xl border border-indigo-100 bg-white p-6 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">Primeiro acesso</p>
        @if (Model.CanManage)
        {
            <h2 class="mt-1 text-xl font-bold">Configure a primeira operação</h2>
            <p class="mt-2 max-w-2xl text-sm text-slate-500">Crie um projeto, defina suas etapas e registre a primeira demanda. As atividades atribuídas aparecerão automaticamente nesta página.</p>
            <div class="mt-5 flex flex-wrap gap-3">
                <a href="/Boards" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Criar primeiro projeto</a>
                <a href="/Settings" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600">Revisar meu perfil</a>
            </div>
        }
        else
        {
            <h2 class="mt-1 text-xl font-bold">Seu espaço está pronto</h2>
            <p class="mt-2 max-w-2xl text-sm text-slate-500">Quando uma demanda for atribuída a você, ela aparecerá aqui com prazo, orientações e a próxima ação necessária.</p>
            <a href="/Settings" class="mt-5 inline-block rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600">Revisar meu perfil</a>
        }
    </section>
}
else
{
    <div class="mb-7 grid grid-cols-2 gap-3 xl:grid-cols-4">
        <a href="#atencao" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-red-300"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Precisa de atenção</p><p class="mt-1 text-2xl font-bold @(Model.AttentionCount > 0 ? "text-red-600" : "text-emerald-600")">@Model.AttentionCount</p></a>
        <a href="#proximas" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-indigo-300"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Em execução</p><p class="mt-1 text-2xl font-bold text-indigo-600">@active.Count</p></a>
        <a href="#acompanhando" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-amber-300"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Aguardando terceiros</p><p class="mt-1 text-2xl font-bold text-amber-600">@waiting.Count</p></a>
        <a href="#atencao" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-orange-300"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Atrasadas ou bloqueadas</p><p class="mt-1 text-2xl font-bold text-orange-600">@urgent.Count</p></a>
    </div>

    <section id="atencao" class="scroll-mt-6 rounded-2xl border @(Model.AttentionCount > 0 ? "border-red-200 bg-red-50/30" : "border-emerald-200 bg-emerald-50/30") p-5">
        <div class="mb-4 flex items-center justify-between gap-3"><div><h2 class="text-lg font-bold @(Model.AttentionCount > 0 ? "text-red-950" : "text-emerald-950")">Precisa da minha atenção</h2><p class="mt-1 text-xs @(Model.AttentionCount > 0 ? "text-red-700" : "text-emerald-700")">Novas atribuições, aprovações, atrasos, bloqueios e ajustes solicitados.</p></div><span class="rounded-full bg-white px-3 py-1 text-sm font-bold text-slate-600">@Model.AttentionCount</span></div>
        @if (Model.AttentionCount == 0)
        {
            <div class="rounded-xl border border-emerald-100 bg-white p-6 text-center"><i data-lucide="circle-check" class="mx-auto h-8 w-8 text-emerald-500"></i><strong class="mt-2 block text-sm text-emerald-900">Nada urgente neste momento</strong><span class="mt-1 block text-xs text-slate-500">Continue pelas próximas atividades planejadas.</span></div>
        }
        else
        {
            <div class="grid gap-4 xl:grid-cols-2">
                @foreach (var assignment in pending)
                {
                    var task = Model.Tasks.FirstOrDefault(x => x.Id == assignment.TaskId); if (task == null) continue;
                    <article class="rounded-xl border border-indigo-100 bg-white p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase text-indigo-500">Nova atribuição · @Model.Board(task.BoardId)?.Name</p><h3 class="mt-1 font-bold">@task.Title</h3></div><span class="rounded bg-indigo-50 px-2 py-1 text-[10px] font-bold text-indigo-700">ACEITAR OU RECUSAR</span></div>
                        @if (!string.IsNullOrWhiteSpace(assignment.Notes)) { <p class="mt-3 text-sm text-slate-600">@assignment.Notes</p> }
                        @if (!string.IsNullOrWhiteSpace(assignment.AcceptanceCriteria)) { <div class="mt-3 rounded-lg bg-slate-50 p-3 text-xs"><strong>Critérios de aceite:</strong> @assignment.AcceptanceCriteria</div> }
                        <div class="mt-4 flex flex-wrap gap-2"><form asp-action="Respond" method="post"><input type="hidden" name="assignmentId" value="@assignment.Id"/><input type="hidden" name="action" value="accept"/><button class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-bold text-white">Aceitar</button></form><form asp-action="Respond" method="post" class="flex gap-2"><input type="hidden" name="assignmentId" value="@assignment.Id"/><input type="hidden" name="action" value="reject"/><input name="note" required maxlength="1000" class="field !w-52 !py-2" placeholder="Motivo da recusa"/><button class="rounded-lg border border-red-200 px-3 py-2 text-xs font-bold text-red-600">Recusar</button></form><a href="@TaskUrl(task)" class="rounded-lg px-3 py-2 text-xs font-bold text-slate-500">Ver detalhes</a></div>
                    </article>
                }
                @foreach (var task in review)
                {
                    <article class="rounded-xl border border-emerald-100 bg-white p-4 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase text-emerald-600">Aguardando meu aceite · @Model.Board(task.BoardId)?.Name</p><h3 class="mt-1 font-bold">@task.Title</h3></div><span class="text-xs font-bold text-slate-500">@DueLabel(task)</span></div><div class="mt-4 flex flex-wrap gap-2"><form asp-action="Review" method="post"><input type="hidden" name="taskId" value="@task.Id"/><input type="hidden" name="action" value="approve"/><button class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white">Aprovar entrega</button></form><form asp-action="Review" method="post" class="flex gap-2"><input type="hidden" name="taskId" value="@task.Id"/><input type="hidden" name="action" value="changes"/><input name="note" required maxlength="1000" class="field !w-56 !py-2" placeholder="Ajustes necessários"/><button class="rounded-lg border border-amber-300 px-3 py-2 text-xs font-bold text-amber-700">Solicitar ajustes</button></form><a href="@TaskUrl(task, "activity")" class="rounded-lg px-3 py-2 text-xs font-bold text-slate-500">Revisar detalhes</a></div></article>
                }
                @foreach (var task in urgent)
                {
                    var assignment = Model.ActiveAssignment(task.Id);
                    <article class="rounded-xl border border-red-100 bg-white p-4 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase text-red-500">@Model.Board(task.BoardId)?.Name</p><h3 class="mt-1 font-bold">@task.Title</h3></div><span class="text-xs font-bold @(IsOverdue(task) ? "text-red-600" : "text-slate-500")">@DueLabel(task)</span></div><div class="mt-3 flex flex-wrap items-center gap-2">@if (IsOverdue(task)) { <span class="rounded bg-red-100 px-2 py-1 text-[10px] font-bold text-red-700">ATRASADA</span> } @if (task.IsBlocked) { <span class="rounded bg-red-100 px-2 py-1 text-[10px] font-bold text-red-700">BLOQUEADA</span> } @if (task.WorkflowState == "changes_requested") { <span class="rounded bg-amber-100 px-2 py-1 text-[10px] font-bold text-amber-700">AJUSTES SOLICITADOS</span> }<a href="@TaskUrl(task, "activity")" class="ml-auto rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-600">Abrir demanda</a>@if (assignment?.Status == "accepted" && !task.IsBlocked) { <form asp-action="Respond" method="post"><input type="hidden" name="assignmentId" value="@assignment.Id"/><input type="hidden" name="action" value="complete"/><button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white">Concluir etapa</button></form> }</div>@if (task.IsBlocked && !string.IsNullOrWhiteSpace(task.BlockerReason)) { <p class="mt-3 rounded-lg bg-red-50 p-2 text-xs text-red-700"><strong>Impedimento:</strong> @task.BlockerReason</p> }</article>
                }
            </div>
        }
    </section>

    <section id="proximas" class="mt-7 scroll-mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="mb-4 flex items-center justify-between"><div><h2 class="text-lg font-bold">Próximas atividades</h2><p class="mt-1 text-xs text-slate-500">Ordenadas pelo prazo mais próximo.</p></div><span class="text-sm font-bold text-slate-400">@next.Count</span></div>
        <div class="grid gap-3 lg:grid-cols-2">
            @foreach (var task in next)
            {
                var assignment = Model.ActiveAssignment(task.Id);
                <article class="rounded-xl border border-slate-100 bg-slate-50 p-4"><div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase text-slate-400">@Model.Board(task.BoardId)?.Name · @task.Status</p><a href="@TaskUrl(task)" class="font-bold hover:text-indigo-600">@task.Title</a></div><span class="text-xs font-bold text-slate-500">@DueLabel(task)</span></div><div class="mt-3 flex items-center gap-2"><span class="text-xs text-slate-500">@(task.StartDate?.ToString("dd/MM") ?? "Sem início") → @(task.DueDate?.ToString("dd/MM") ?? "Sem prazo")</span><a href="@TaskUrl(task, "activity")" class="ml-auto text-xs font-bold text-indigo-600">Continuar</a>@if (assignment?.Status == "accepted") { <form asp-action="Respond" method="post"><input type="hidden" name="assignmentId" value="@assignment.Id"/><input type="hidden" name="action" value="complete"/><button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white">Concluir etapa</button></form> }</div></article>
            }
            @if (!next.Any()) { <p class="py-8 text-center text-sm text-slate-400 lg:col-span-2">Nenhuma próxima atividade planejada.</p> }
        </div>
    </section>

    <section id="acompanhando" class="mt-7 scroll-mt-6 rounded-2xl border border-slate-200 bg-white p-5">
        <div class="mb-4 flex items-center justify-between"><div><h2 class="text-lg font-bold">Acompanhando</h2><p class="mt-1 text-xs text-slate-500">Demandas que estão com outras pessoas.</p></div><span class="text-sm font-bold text-slate-400">@waiting.Count</span></div>
        <div class="grid gap-3 lg:grid-cols-2">@foreach (var task in waiting) { <a href="@TaskUrl(task)" class="block rounded-xl border border-slate-100 bg-slate-50 p-4 hover:border-indigo-200"><div class="flex justify-between gap-3"><div><p class="text-[10px] font-bold uppercase text-slate-400">@Model.Board(task.BoardId)?.Name</p><strong>@task.Title</strong><p class="mt-1 text-xs text-slate-500">Com @(Model.Person(task.AssignedTo)?.FullName ?? "responsável não definido")</p></div><span class="text-xs @(IsOverdue(task) ? "font-bold text-red-600" : "text-slate-500")">@DueLabel(task)</span></div></a> } @if (!waiting.Any()) { <p class="py-8 text-center text-sm text-slate-400 lg:col-span-2">Nada aguardando outras pessoas.</p> }</div>
    </section>

    <details class="mt-7 rounded-2xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-bold">Concluídas recentemente (@recentlyDone.Count)</summary><div class="mt-4 grid gap-2 md:grid-cols-2">@foreach (var task in recentlyDone) { <a href="@TaskUrl(task)" class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@task.Title</strong><span class="ml-2 text-xs text-slate-400">@task.CompletedAt?.ToString("dd/MM")</span></a> } @if (!recentlyDone.Any()) { <p class="text-sm text-slate-400">Nenhuma demanda concluída nos últimos 14 dias.</p> }</div></details>
}
