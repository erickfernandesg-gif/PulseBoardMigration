@model PulseBoardMigration.Models.IntakePublicViewModel
@{Layout=null;}<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>@Model.Title</title><script src="https://cdn.tailwindcss.com"></script></head><body class="min-h-screen bg-slate-100 p-5"><main class="mx-auto mt-10 max-w-xl rounded-2xl bg-white p-7 shadow"><h1 class="text-2xl font-bold">@Model.Title</h1><p class="mt-2 text-sm text-slate-500">@Model.Description</p><div asp-validation-summary="All" class="mt-4 text-sm text-red-600"></div><form method="post" action="/solicitacao/@Model.Token" class="mt-6 space-y-4">@Html.AntiForgeryToken()<div><label class="text-sm font-bold">Seu nome</label><input name="requesterName" required maxlength="120" class="mt-1 w-full rounded-lg border p-3"/></div><div><label class="text-sm font-bold">Seu e-mail</label><input name="requesterEmail" type="email" required="@Model.RequireEmail" maxlength="200" class="mt-1 w-full rounded-lg border p-3"/></div><div><label class="text-sm font-bold">Assunto</label><input name="title" required maxlength="200" class="mt-1 w-full rounded-lg border p-3"/></div><div><label class="text-sm font-bold">Detalhes</label><textarea name="description" rows="6" maxlength="5000" class="mt-1 w-full rounded-lg border p-3"></textarea></div><button class="w-full rounded-lg bg-indigo-600 p-3 font-bold text-white">Enviar solicitação</button></form></main></body></html>
