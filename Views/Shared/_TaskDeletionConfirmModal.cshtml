<div id="taskDeletionConfirmModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="taskDeletionConfirmTitle" aria-describedby="taskDeletionConfirmDescription">
    <div class="w-full max-w-md overflow-hidden rounded-2xl border border-red-100 bg-white shadow-2xl">
        <div class="border-b border-slate-100 bg-gradient-to-r from-red-50 to-amber-50 px-6 py-5">
            <div class="flex items-start gap-4">
                <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-red-100 text-red-700" aria-hidden="true">
                    <i data-lucide="triangle-alert" class="h-5 w-5"></i>
                </div>
                <div>
                    <h2 id="taskDeletionConfirmTitle" class="text-lg font-bold text-slate-950">Confirmar ação</h2>
                    <p id="taskDeletionConfirmDescription" class="mt-1 text-sm leading-6 text-slate-600"></p>
                </div>
            </div>
        </div>
        <div class="px-6 py-5">
            <div id="taskDeletionConfirmNotice" class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-5 text-amber-900"></div>
            <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button id="taskDeletionConfirmCancel" type="button" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">Cancelar</button>
                <button id="taskDeletionConfirmAction" type="button" class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100">Excluir definitivamente</button>
            </div>
        </div>
    </div>
</div>
