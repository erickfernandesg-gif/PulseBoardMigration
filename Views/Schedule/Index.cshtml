@model PulseBoardMigration.Models.CompanyScheduleViewModel
@{ ViewData["Title"]="Cronograma da empresa"; var totalDays=Math.Max(1,(Model.To-Model.From).TotalDays); }
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><h1 class="text-3xl font-bold">Cronograma da empresa</h1><p class="mt-1 text-sm text-slate-500">Todos os projetos, responsáveis, prazos e riscos em uma única linha do tempo.</p></div><form method="get" class="flex gap-2"><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="field"/><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="field"/><button class="rounded-lg bg-slate-900 px-4 text-sm font-bold text-white">Aplicar</button></form></div>
<div class="mb-5 grid gap-3 sm:grid-cols-5"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Itens planejados</p><p class="text-2xl font-bold">@Model.Rows.Count</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Projetos</p><p class="text-2xl font-bold">@Model.Rows.Select(x=>x.BoardName).Distinct().Count()</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Caminho crítico</p><p class="text-2xl font-bold text-fuchsia-700">@Model.Rows.Count(x=>x.IsCritical)</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Atrasados</p><p class="text-2xl font-bold text-red-600">@Model.Rows.Count(x=>x.IsOverdue)</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Bloqueados</p><p class="text-2xl font-bold text-amber-600">@Model.Rows.Count(x=>x.IsBlocked)</p></div></div>
<section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white"><div class="min-w-[1000px]"><div class="grid grid-cols-[300px_1fr] border-b bg-slate-50 text-xs font-bold uppercase text-slate-400"><div class="p-4">Entrega</div><div class="flex justify-between p-4"><span>@Model.From.ToString("dd/MM")</span><span>@Model.From.AddDays(totalDays/2).ToString("dd/MM")</span><span>@Model.To.ToString("dd/MM")</span></div></div>
@foreach(var row in Model.Rows){<div class="grid grid-cols-[300px_1fr] items-center border-b last:border-0"><a href="/Boards/Details/@row.BoardId" class="p-4"><strong class="block truncate text-sm">@row.TaskTitle</strong><span class="text-xs text-slate-400">@row.BoardName · @row.PersonName @(row.IsCritical?"· crítico":"")</span></a><div class="relative mx-4 h-9 rounded-lg bg-slate-100"><div title="@row.Start.ToString("dd/MM") a @row.End.ToString("dd/MM")" class="absolute top-1.5 h-6 rounded-md @(row.IsBlocked?"bg-amber-500":row.IsOverdue?"bg-red-500":row.IsCritical?"bg-fuchsia-600":"bg-indigo-500")" style="left:@row.LeftPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%;width:@row.WidthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>}
</div></section>
<section class="mt-7 rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Marcos</h2><form asp-action="AddMilestone" method="post" class="mb-4 grid gap-2 sm:grid-cols-4"><select name="boardId" required class="field"><option value="">Projeto</option>@foreach(var board in Model.Boards){<option value="@board.Id">@board.Name</option>}</select><input name="title" required class="field" placeholder="Nome do marco"/><input type="date" name="dueDate" required class="field"/><button class="rounded-lg bg-indigo-600 text-sm font-bold text-white">Adicionar marco</button></form><div class="flex flex-wrap gap-2">@foreach(var milestone in Model.Milestones.OrderBy(x=>x.DueDate)){<span class="rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-700">@milestone.DueDate.ToString("dd/MM") · @milestone.Title</span>}</div></section>
