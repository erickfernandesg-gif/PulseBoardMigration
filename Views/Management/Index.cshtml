@model PulseBoardMigration.Models.ManagementViewModel
@{ ViewData["Title"] = "Gestão da equipe"; var today=DateTime.UtcNow.Date; var weekEnd=today.AddDays(7); }
<div class="mb-7"><h1 class="text-3xl font-bold">Gestão da equipe</h1><p class="mt-1 text-sm text-slate-500">Capacidade, atrasos, bloqueios e handoffs da sua equipe.</p></div>
<div class="mb-6 grid gap-4 sm:grid-cols-4"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Pessoas</p><p class="mt-1 text-2xl font-bold">@Model.Profiles.Count</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Em aberto</p><p class="mt-1 text-2xl font-bold text-indigo-600">@Model.Tasks.Count(x=>x.Status!="done")</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Atrasadas</p><p class="mt-1 text-2xl font-bold text-red-600">@Model.Tasks.Count(x=>x.Status!="done" && x.DueDate<today)</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Bloqueadas</p><p class="mt-1 text-2xl font-bold text-amber-600">@Model.Tasks.Count(x=>x.IsBlocked)</p></div></div>
<section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white"><table class="w-full min-w-[850px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Pessoa</th><th>Capacidade</th><th>Carga próximos 7 dias</th><th>Utilização</th><th>Atrasadas</th><th>Bloqueadas</th><th>Caixa de entrada</th></tr></thead><tbody class="divide-y">
@foreach(var person in Model.Profiles)
{
    var schedule=Model.Schedules.FirstOrDefault(x=>x.UserId==person.Id && x.ValidTo==null); var capacity=schedule?.WeeklyCapacityMinutes ?? 2400;
    var personTasks=Model.Tasks.Where(x=>x.AssignedTo==person.Id && x.Status!="done").ToList(); var weekMinutes=personTasks.Where(x=>(x.StartDate??today)<=weekEnd && (x.DueDate??weekEnd)>=today).Sum(x=>x.EstimatedMinutes); var utilization=capacity==0?0:weekMinutes*100/capacity;
    <tr data-searchable><td class="p-4"><strong>@(person.FullName??person.Email)</strong><small class="block text-slate-400">@person.Email</small></td><td><form asp-action="SaveCapacity" method="post" class="flex items-center gap-2"><input type="hidden" name="userId" value="@person.Id"/><input type="number" name="weeklyHours" min="0" max="168" step="0.5" value="@(capacity/60m)" class="field !w-24"/><button class="text-xs font-bold text-indigo-600">Salvar</button></form></td><td>@((weekMinutes/60m).ToString("0.#"))h</td><td><span class="rounded-full px-2 py-1 text-xs font-bold @(utilization>100?"bg-red-100 text-red-700":utilization>80?"bg-amber-100 text-amber-700":"bg-emerald-100 text-emerald-700")">@utilization%</span></td><td class="font-bold text-red-600">@personTasks.Count(x=>x.DueDate<today)</td><td class="font-bold text-amber-600">@personTasks.Count(x=>x.IsBlocked)</td><td>@Model.Assignments.Count(x=>x.ToUserId==person.Id && x.Status=="pending")</td></tr>
}
</tbody></table></section>
<section class="mt-7 overflow-x-auto rounded-2xl border bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Desempenho e capacidade efetiva</h2><p class="text-xs text-slate-500">A capacidade já desconta ausências aprovadas da semana.</p></div><table class="w-full min-w-[950px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Pessoa</th><th>Concluídas</th><th>No prazo</th><th>Real/estimado</th><th>Retrabalho</th><th>Utilização</th><th>Disponível</th></tr></thead><tbody class="divide-y">@foreach(var item in Model.Performance){<tr><td class="p-4 font-bold">@item.Name</td><td>@item.CompletedTasks</td><td>@item.OnTimePercent.ToString("0")%</td><td>@item.EstimateAccuracyPercent.ToString("0")%</td><td>@item.ReworkPercent.ToString("0")%</td><td><span class="rounded-full px-2 py-1 text-xs font-bold @(item.UtilizationPercent>100?"bg-red-100 text-red-700":item.UtilizationPercent>80?"bg-amber-100 text-amber-700":"bg-emerald-100 text-emerald-700")">@item.UtilizationPercent.ToString("0")%</span></td><td>@item.AvailableHours.ToString("0.0")h</td></tr>}</tbody></table></section>
<div class="mt-7 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Itens que exigem atenção</h2><div class="space-y-2">@foreach(var task in Model.Tasks.Where(x=>x.IsBlocked || (x.Status!="done"&&x.DueDate<today)).OrderBy(x=>x.DueDate).Take(20)){var owner=Model.Profiles.FirstOrDefault(x=>x.Id==task.AssignedTo);<a href="/Boards/Details/@task.BoardId" class="flex justify-between rounded-lg bg-slate-50 p-3 text-sm"><span><strong>@task.Title</strong><small class="block text-slate-400">@(owner?.FullName??owner?.Email)</small></span><span class="text-xs font-bold @(task.IsBlocked?"text-amber-600":"text-red-600")">@(task.IsBlocked?"Bloqueada":task.DueDate?.ToString("dd/MM"))</span></a>}</div></section><section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Handoffs recentes</h2><div class="space-y-2">@foreach(var item in Model.Assignments.OrderByDescending(x=>x.CreatedAt).Take(15)){var task=Model.Tasks.FirstOrDefault(x=>x.Id==item.TaskId);var to=Model.Profiles.FirstOrDefault(x=>x.Id==item.ToUserId);<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@task?.Title</strong><p class="text-xs text-slate-500">@item.Stage → @(to?.FullName??to?.Email) · @item.Status</p></div>}</div></section></div>
