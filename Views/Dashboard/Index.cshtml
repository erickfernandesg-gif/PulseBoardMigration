@model PulseBoardMigration.Models.DashboardViewModel
@{
    ViewData["Title"] = "Início";
}
<div class="mb-8"><p class="text-xs font-bold uppercase tracking-widest text-indigo-600">PulseBoard</p><h1 class="mt-1 text-3xl font-bold">Início</h1><p class="mt-1 text-sm text-slate-500">Comece pelo que precisa da sua atenção agora.</p></div>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <a href="/Work" class="rounded-2xl border border-slate-200 bg-white p-5 hover:border-indigo-300"><p class="text-xs font-bold uppercase text-slate-400">Minhas ações</p><p class="mt-2 text-3xl font-bold text-indigo-600">@Model.MyActiveTasks</p></a>
    <a href="/Work" class="rounded-2xl border border-slate-200 bg-white p-5 hover:border-amber-300"><p class="text-xs font-bold uppercase text-slate-400">Aguardando terceiros</p><p class="mt-2 text-3xl font-bold text-amber-600">@Model.WaitingOnOthers</p></a>
    <a href="/Work" class="rounded-2xl border border-slate-200 bg-white p-5 hover:border-emerald-300"><p class="text-xs font-bold uppercase text-slate-400">Aguardando meu aceite</p><p class="mt-2 text-3xl font-bold text-emerald-600">@Model.WaitingMyReview</p></a>
    <a href="/Schedule" class="rounded-2xl border border-slate-200 bg-white p-5 hover:border-red-300"><p class="text-xs font-bold uppercase text-slate-400">Atrasadas visíveis</p><p class="mt-2 text-3xl font-bold text-red-600">@Model.OverdueTasks</p></a>
</div>
<section class="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-5"><div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-lg font-bold text-indigo-950">Seu próximo passo</h2><p class="text-sm text-indigo-700">Abra Meu trabalho para aceitar, executar ou aprovar tarefas.</p></div><a href="/Work" class="rounded-lg bg-indigo-600 px-4 py-2 text-center text-sm font-bold text-white">Abrir Meu trabalho</a></div></section>
@if (!Model.Boards.Any())
{
    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-widest text-indigo-600">Primeiro acesso</p>
        <h2 class="mt-1 text-xl font-bold">Configure sua primeira operação</h2>
        <p class="mt-1 text-sm text-slate-500">Crie um projeto, registre uma tarefa e atribua um responsável. O restante do acompanhamento aparecerá automaticamente nas áreas de gestão.</p>
        <div class="mt-5 grid gap-3 md:grid-cols-3">
            <a href="/Boards" class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 hover:border-indigo-400"><span class="text-xs font-bold text-indigo-600">1. PROJETO</span><strong class="mt-1 block">Criar projeto</strong><span class="mt-1 block text-xs text-slate-600">Defina o fluxo de trabalho.</span></a>
            <a href="/Boards" class="rounded-xl border bg-slate-50 p-4 hover:border-indigo-300"><span class="text-xs font-bold text-slate-500">2. TAREFA</span><strong class="mt-1 block">Adicionar tarefa</strong><span class="mt-1 block text-xs text-slate-600">Registre a primeira entrega.</span></a>
            <a href="/Settings" class="rounded-xl border bg-slate-50 p-4 hover:border-indigo-300"><span class="text-xs font-bold text-slate-500">3. PERFIL</span><strong class="mt-1 block">Completar perfil</strong><span class="mt-1 block text-xs text-slate-600">Ajuste suas notificações.</span></a>
        </div>
    </section>
}
<div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="mb-5 flex items-center justify-between"><h2 class="text-lg font-bold">Projetos recentes</h2><a href="/Boards" class="text-sm font-bold text-indigo-600">Ver projetos</a></div>
        <div class="grid gap-3 sm:grid-cols-2">
            @foreach (var board in Model.Boards.Take(6))
            {
                <a data-searchable href="/Boards/Details/@board.Id" class="rounded-xl border border-slate-100 bg-slate-50 p-4 hover:border-indigo-300 hover:bg-white">
                    <h3 class="font-bold">@board.Name</h3><p class="mt-1 line-clamp-2 text-xs text-slate-500">@board.Description</p>
                    <p class="mt-3 text-[10px] font-bold uppercase text-slate-400">@Model.Tasks.Count(t => t.BoardId == board.Id && t.Status != "done") tarefas abertas</p>
                </a>
            }
        </div>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="mb-5 text-lg font-bold">Atualizações recentes</h2>
        @if (!Model.RecentComments.Any()) { <p class="text-sm italic text-slate-400">Nenhum comentário recente.</p> }
        <div class="space-y-3">
            @foreach (var comment in Model.RecentComments)
            {
                var profile = Model.Profiles.FirstOrDefault(p => p.Id == comment.UserId);
                var task = Model.Tasks.FirstOrDefault(t => t.Id == comment.TaskId);
                <a data-searchable href="/Boards/Details/@task?.BoardId" class="block rounded-xl bg-slate-50 p-3">
                    <p class="text-xs font-bold text-indigo-700">@(profile?.FullName ?? profile?.Email ?? "Usuário") · @task?.Title</p>
                    <p class="mt-1 line-clamp-2 text-sm text-slate-600">@comment.Content</p>
                </a>
            }
        </div>
    </section>
</div>
