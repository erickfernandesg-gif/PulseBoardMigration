@model PulseBoardMigration.Models.EnterprisePlanningViewModel
@{
    ViewData["Title"] = "Planejamento";
}

<header class="mb-5 rounded-2xl bg-slate-900 p-5 text-white sm:p-7">
    <div class="flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
        <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-widest text-indigo-300">Central de decisões</p>
            <h1 class="mt-1 text-3xl font-bold">Planejamento</h1>
            <p class="mt-2 text-sm text-slate-300">Veja o que precisa de atenção, organize a capacidade da equipe e mantenha os projetos dentro do combinado.</p>
        </div>
        <form method="get" class="grid gap-2 rounded-xl bg-white/10 p-3 sm:grid-cols-2 xl:grid-cols-5" aria-label="Filtros do planejamento">
            <label class="text-xs text-slate-300"><span class="mb-1 block">Equipe</span><select name="teamId" class="field text-slate-900"><option value="">@(Model.IsAdmin ? "Todas as equipes" : "Minha equipe")</option>@foreach (var team in Model.Teams) { <option value="@team.Id" selected="@(Model.SelectedTeamId == team.Id)">@team.Name</option> }</select></label>
            <label class="text-xs text-slate-300"><span class="mb-1 block">Projeto</span><select name="boardId" class="field text-slate-900"><option value="">Todos os projetos</option>@foreach (var board in Model.Boards) { <option value="@board.Id" selected="@(Model.SelectedBoardId == board.Id)">@board.Name</option> }</select></label>
            <label class="text-xs text-slate-300"><span class="mb-1 block">De</span><input type="date" name="from" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" class="field text-slate-900" /></label>
            <label class="text-xs text-slate-300"><span class="mb-1 block">Até</span><input type="date" name="to" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" class="field text-slate-900" /></label>
            <button class="self-end rounded-lg bg-indigo-500 px-4 py-2.5 text-sm font-bold hover:bg-indigo-400">Aplicar filtros</button>
        </form>
    </div>
</header>

<section class="mb-5 rounded-2xl border border-indigo-100 bg-indigo-50 p-4 sm:p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div><h2 class="font-bold text-indigo-950">Como usar esta área</h2><p class="mt-1 text-sm text-indigo-700">Siga esta ordem: entenda os alertas, confira a equipe, ajuste os prazos e automatize o trabalho repetitivo.</p></div>
        <div class="grid grid-cols-2 gap-2 text-xs sm:grid-cols-4"><span class="rounded-lg bg-white px-3 py-2 font-semibold text-indigo-800">1. Ver alertas</span><span class="rounded-lg bg-white px-3 py-2 font-semibold text-indigo-800">2. Conferir equipe</span><span class="rounded-lg bg-white px-3 py-2 font-semibold text-indigo-800">3. Ajustar prazos</span><span class="rounded-lg bg-white px-3 py-2 font-semibold text-indigo-800">4. Automatizar</span></div>
    </div>
</section>

<nav class="mb-5 overflow-x-auto rounded-xl border bg-white p-1" aria-label="Áreas do planejamento" role="tablist">
    <div class="flex min-w-max gap-1">
        <button type="button" class="planning-tab rounded-lg px-4 py-2.5 text-sm font-bold" data-planning-tab="visao-geral" role="tab">Visão geral</button>
        <button type="button" class="planning-tab rounded-lg px-4 py-2.5 text-sm font-bold" data-planning-tab="equipe" role="tab">Equipe e capacidade</button>
        <button type="button" class="planning-tab rounded-lg px-4 py-2.5 text-sm font-bold" data-planning-tab="prazos" role="tab">Prazos e vínculos</button>
        <button type="button" class="planning-tab rounded-lg px-4 py-2.5 text-sm font-bold" data-planning-tab="automacoes" role="tab">Modelos e automações</button>
    </div>
</nav>

<partial name="_Overview" model="Model" />
<partial name="_TeamCapacity" model="Model" />
<partial name="_Deadlines" model="Model" />
<partial name="_Automations" model="Model" />

@section Scripts {
<script>
(() => {
    const tabs = [...document.querySelectorAll('[data-planning-tab]')];
    const panels = [...document.querySelectorAll('.planning-panel')];
    const activate = (name, updateHash = true) => {
        if (!panels.some(panel => panel.id === name)) name = 'visao-geral';
        panels.forEach(panel => panel.hidden = panel.id !== name);
        tabs.forEach(tab => {
            const active = tab.dataset.planningTab === name;
            tab.classList.toggle('bg-slate-900', active); tab.classList.toggle('text-white', active);
            tab.classList.toggle('text-slate-600', !active); tab.setAttribute('aria-selected', active);
        });
        sessionStorage.setItem('planning-active-tab', name);
        if (updateHash) history.replaceState(null, '', `#${name}`);
    };
    tabs.forEach(tab => tab.addEventListener('click', () => activate(tab.dataset.planningTab)));
    document.querySelectorAll('.planning-jump').forEach(link => link.addEventListener('click', () => activate(link.hash.slice(1))));
    activate(location.hash.slice(1) || sessionStorage.getItem('planning-active-tab') || 'visao-geral', false);

    const board = document.getElementById('RecurringBoard');
    const status = document.getElementById('RecurringStatus');
    const template = document.getElementById('RecurringTemplate');
    const refreshStatuses = () => {
        if (!status) return;
        let columns = []; try { columns = JSON.parse(board?.selectedOptions[0]?.dataset.columns || '[]'); } catch { }
        status.replaceChildren(...columns.map(column => { const option = document.createElement('option'); option.value = column.id; option.textContent = column.title; return option; }));
        status.disabled = columns.length === 0;
    };
    board?.addEventListener('change', () => {
        refreshStatuses();
        [...template.options].forEach(option => option.hidden = Boolean(option.dataset.boardId) && option.dataset.boardId !== board.value);
        if (template.selectedOptions[0]?.hidden) template.value = '';
    });
    template?.addEventListener('change', () => {
        const option = template.selectedOptions[0]; if (!option?.value) return;
        document.getElementById('RecurringTitle').value = option.dataset.name || '';
        document.getElementById('RecurringDescription').value = option.dataset.description || '';
        document.getElementById('RecurringPriority').value = option.dataset.priority || 'medium';
        document.getElementById('RecurringEstimatedMinutes').value = option.dataset.estimatedMinutes || '0';
    });
    refreshStatuses();
})();
</script>
}
