@model PulseBoardMigration.Models.BoardDetailsViewModel

@{
    ViewData["Title"] = Model.Board.Name;
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
        <a href="/Boards" class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 transition-colors">
            <i data-lucide="arrow-left" class="h-5 w-5"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@Model.Board.Name</h1>
            <p class="text-sm text-slate-500">@Model.Board.Description</p>
        </div>
    </div>

    <div class="flex items-center gap-2">
        <div class="flex bg-slate-100 p-1 rounded-lg mr-4">
            <button data-view-target="kanban" class="px-3 py-1.5 text-sm font-medium rounded-md bg-indigo-50 text-indigo-600 transition-colors">Kanban</button>
            <button data-view-target="table" class="px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors">Tabela</button>
            <button data-view-target="gantt" class="px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors">Gantt</button>
        </div>

        <button class="flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
            <i data-lucide="filter" class="h-4 w-4"></i> Filtros
        </button>
        <button onclick="openCreateTaskModal()" class="flex h-10 items-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-medium text-white hover:bg-indigo-700 transition-colors shadow-sm">
            <i data-lucide="plus" class="h-4 w-4"></i> Nova Tarefa
        </button>
    </div>
</div>

<div class="relative">

    <div id="view-kanban" class="flex h-[calc(100vh-200px)] gap-6 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-slate-200 transition-opacity duration-300">
        @foreach (var column in Model.Board.Settings)
        {
            <div class="flex w-80 shrink-0 flex-col rounded-xl bg-slate-100/50 border border-slate-200/60 p-4">
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider">@column.Title</h3>
                        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 text-[10px] font-bold text-slate-600">
                            @Model.Tasks.Count(t => t.Status == column.Id)
                        </span>
                    </div>
                    <button class="text-slate-400 hover:text-slate-600">
                        <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                    </button>
                </div>

                <div data-column-id="@column.Id" class="kanban-column-body flex flex-1 flex-col gap-3 min-h-[50px]">
                    @foreach (var task in Model.Tasks.Where(t => t.Status == column.Id).OrderBy(t => t.CreatedAt))
                    {
                        <div class="kanban-task group relative flex flex-col rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-all hover:border-indigo-300 hover:shadow-md cursor-grab active:cursor-grabbing"
                             data-task-id="@task.Id"
                             data-title="@task.Title"
                             data-description="@task.Description"
                             data-status="@task.Status"
                             data-priority="@task.Priority"
                             data-assignee-id="@task.AssigneeId"
                             data-start-date="@(task.StartDate?.ToString("yyyy-MM-dd"))"
                             data-due="@(task.DueDate?.ToString("yyyy-MM-dd"))"
                             data-department="@task.Department"
                             data-risk-level="@task.RiskLevel"
                             data-story-points="@task.StoryPoints"
                             data-tags="@task.Tags"
                             onclick="openTaskDetailsModal(this)">

                            <div class="mb-2 flex items-start justify-between">
                                <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-indigo-600">
                                    @task.Priority
                                </span>
                                <button class="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-slate-600 transition-opacity">
                                    <i data-lucide="edit-3" class="h-3 w-3"></i>
                                </button>
                            </div>

                            <h4 class="text-sm font-bold text-slate-900 mb-1">@task.Title</h4>
                            <p class="text-xs text-slate-500 line-clamp-2 mb-3">@task.Description</p>
                        </div>
                    }
                </div>

                <button onclick="openCreateTaskModal('@column.Id')" class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg py-2 text-xs font-medium text-slate-400 hover:bg-white hover:text-slate-600 border border-transparent hover:border-slate-200 transition-all">
                    <i data-lucide="plus" class="h-3 w-3"></i> Adicionar Tarefa
                </button>
            </div>
        }
    </div>

    <div id="view-table" class="hidden transition-opacity duration-300">
        @* Aqui você chama a sua partial view existente *@
        @await Html.PartialAsync("_TableBoard", Model)
    </div>

    <div id="view-gantt" class="hidden transition-opacity duration-300">
        @* Aqui você chama a sua partial view existente *@
        @await Html.PartialAsync("_GanttBoard", Model)
    </div>

</div>

@await Html.PartialAsync("_CreateTaskModal", Model)
@await Html.PartialAsync("_TaskDetailsModal", Model)

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/frappe-gantt/0.6.1/frappe-gantt.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/frappe-gantt/0.6.1/frappe-gantt.css">

    <script src="~/js/boards.js" asp-append-version="true"></script>
}