@model PulseBoardMigration.Models.BillingViewModel
@{ ViewData["Title"]="Faturamento"; var tasks=Model.Tasks.ToDictionary(x=>x.Id); var monthStart=DateTime.Parse(Model.Month+"-01"); }
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><h1 class="text-3xl font-bold">Faturamento</h1><p class="mt-1 text-sm text-slate-500">Aprovação de horas, contratos, valores históricos e faturas.</p></div><form method="get"><input type="month" name="month" value="@Model.Month" class="field" onchange="this.form.submit()"/></form></div>
<div class="mb-6 grid gap-4 sm:grid-cols-4"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Horas registradas</p><p class="text-2xl font-bold">@((Model.Logs.Sum(x=>x.Minutes)/60m).ToString("0.0"))</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Pendentes</p><p class="text-2xl font-bold text-amber-600">@Model.Logs.Count(x=>x.ApprovalStatus=="pending")</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Aprovado não faturado</p><p class="text-2xl font-bold text-indigo-600">@Model.ApprovedUnbilled.ToString("C")</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Faturas</p><p class="text-2xl font-bold text-emerald-600">@Model.Invoices.Sum(x=>x.Total).ToString("C")</p></div></div>
<section class="mb-7 overflow-x-auto rounded-2xl border bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Apontamentos do período</h2></div><table class="w-full min-w-[950px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Data</th><th>Tarefa</th><th>Pessoa</th><th>Horas</th><th>Custo</th><th>Venda</th><th>Situação</th><th></th></tr></thead><tbody class="divide-y">
@foreach(var log in Model.Logs){tasks.TryGetValue(log.TaskId,out var task);var person=Model.Profiles.FirstOrDefault(x=>x.Id==log.UserId);<tr><td class="p-4">@log.LogDate.ToString("dd/MM")</td><td><strong>@task?.Title</strong><small class="block text-slate-400">@log.Description</small></td><td>@(person?.FullName??person?.Email)</td><td>@((log.Minutes/60m).ToString("0.##"))</td><td>@log.CostAmount.ToString("C")</td><td>@(log.IsBillable?log.BillableAmount.ToString("C"):"Não faturável")</td><td><span class="rounded-full px-2 py-1 text-xs font-bold @(log.ApprovalStatus=="approved"?"bg-emerald-100 text-emerald-700":log.ApprovalStatus=="rejected"?"bg-red-100 text-red-700":"bg-amber-100 text-amber-700")">@log.ApprovalStatus</span></td><td>@if(log.ApprovalStatus=="pending"){<div class="flex gap-2"><form asp-action="ReviewLog" method="post"><input type="hidden" name="logId" value="@log.Id"/><input type="hidden" name="approve" value="true"/><input type="hidden" name="month" value="@Model.Month"/><button class="text-xs font-bold text-emerald-600">Aprovar</button></form><form asp-action="ReviewLog" method="post"><input type="hidden" name="logId" value="@log.Id"/><input type="hidden" name="approve" value="false"/><input type="hidden" name="month" value="@Model.Month"/><button class="text-xs font-bold text-red-600">Rejeitar</button></form></div>}</td></tr>}
</tbody></table></section>
<div class="grid gap-7 xl:grid-cols-2"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Contratos</h2><form asp-action="SaveContract" method="post" class="grid gap-3 sm:grid-cols-2"><select name="ClientId" required class="field"><option value="">Cliente</option>@foreach(var item in Model.Clients){<option value="@item.Id">@item.Name</option>}</select><input name="Name" required class="field" placeholder="Nome do contrato"/><select name="ContractType" class="field"><option value="hourly">Por hora</option><option value="fixed">Preço fechado</option><option value="retainer">Mensalidade</option><option value="hour_bank">Banco de horas</option><option value="internal">Interno</option></select><input type="number" min="0" step="0.01" name="BillingRate" class="field" placeholder="Valor/hora"/><input type="number" min="0" step="0.01" name="BudgetAmount" class="field" placeholder="Orçamento"/><input type="number" min="0" name="IncludedMinutes" class="field" placeholder="Minutos incluídos"/><input type="date" name="StartsOn" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required class="field"/><button class="rounded-lg bg-slate-900 text-sm font-bold text-white">Salvar contrato</button></form><div class="mt-5 space-y-2">@foreach(var contract in Model.Contracts.Take(10)){<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@contract.Name</strong><span class="float-right font-bold">@contract.BillingRate.ToString("C")/h</span><p class="text-xs text-slate-400">@Model.Clients.FirstOrDefault(x=>x.Id==contract.ClientId)?.Name · @contract.ContractType</p></div>}</div></section>
<section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Gerar fatura</h2><form asp-action="GenerateInvoice" method="post" class="grid gap-3 sm:grid-cols-2"><select name="clientId" required class="field"><option value="">Cliente</option>@foreach(var item in Model.Clients){<option value="@item.Id">@item.Name</option>}</select><input type="date" name="dueDate" class="field"/><input type="date" name="periodStart" required value="@monthStart.ToString("yyyy-MM-dd")" class="field"/><input type="date" name="periodEnd" required value="@monthStart.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")" class="field"/><button class="rounded-lg bg-indigo-600 py-2 text-sm font-bold text-white sm:col-span-2">Criar com horas aprovadas</button></form><div class="mt-5 space-y-2">@foreach(var invoice in Model.Invoices.Take(15)){var account=Model.Clients.FirstOrDefault(x=>x.Id==invoice.ClientId);<div class="rounded-lg border border-slate-100 p-3"><div class="flex justify-between"><span><strong>@invoice.Reference</strong><small class="block text-slate-400">@account?.Name</small></span><strong>@invoice.Total.ToString("C")</strong></div><form asp-action="UpdateInvoice" method="post" class="mt-2 flex gap-2"><input type="hidden" name="invoiceId" value="@invoice.Id"/><input type="hidden" name="month" value="@Model.Month"/><select name="status" class="field !py-1 text-xs"><option value="draft" selected="@(invoice.Status=="draft")">Rascunho</option><option value="issued" selected="@(invoice.Status=="issued")">Emitida</option><option value="paid" selected="@(invoice.Status=="paid")">Paga</option><option value="cancelled" selected="@(invoice.Status=="cancelled")">Cancelada</option></select><button class="text-xs font-bold text-indigo-600">Atualizar</button></form></div>}</div></section></div>
