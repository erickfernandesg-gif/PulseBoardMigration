@model PulseBoardMigration.Models.AdminViewModel
@{ ViewData["Title"] = "Organização"; }

<header class="mb-6 rounded-2xl bg-slate-900 p-5 text-white sm:p-7"><p class="text-xs font-bold uppercase tracking-widest text-indigo-300">Administração</p><h1 class="mt-1 text-3xl font-bold">Organização</h1><p class="mt-2 max-w-3xl text-sm text-slate-300">Cadastre as bases do sistema. Pessoas definem responsáveis e custos; equipes organizam Planejamento e Management; clientes se conectam a contratos e faturamento.</p></header>

<section class="mb-6 grid gap-4 md:grid-cols-3"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Pessoas ativas</p><p class="mt-1 text-2xl font-bold">@Model.Profiles.Count(x => x.IsActive)</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Equipes</p><p class="mt-1 text-2xl font-bold">@Model.Teams.Count</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Clientes</p><p class="mt-1 text-2xl font-bold">@Model.Clients.Count</p></div></section>

<section class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950"><strong>Antes de excluir:</strong> pessoas com tarefas abertas devem ser reatribuídas; equipes com pessoas não podem ser removidas; clientes com contratos ou faturas precisam ser preservados. Essas regras evitam perder vínculos importantes.</section>

<div class="grid gap-6 xl:grid-cols-3">
    <section class="rounded-2xl border bg-white p-5 xl:col-span-2"><div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-bold">Pessoas e acesso</h2><p class="mt-1 text-sm text-slate-500">O custo/hora é interno e alimenta custos em Indicadores. Não é o valor vendido ao cliente.</p></div><details class="shrink-0"><summary class="cursor-pointer rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Nova pessoa</summary><form asp-action="CreateUser" method="post" class="mt-3 grid gap-2 rounded-xl border bg-slate-50 p-3 md:grid-cols-2"><label class="text-xs font-bold text-slate-600">Nome<input name="fullName" required class="field mt-1" /></label><label class="text-xs font-bold text-slate-600">E-mail corporativo<input name="email" type="email" required class="field mt-1" /></label><label class="text-xs font-bold text-slate-600">Senha provisória<input name="password" type="password" minlength="8" required class="field mt-1" /></label><label class="text-xs font-bold text-slate-600">Função<select name="role" class="field mt-1"><option value="user">Colaborador</option><option value="manager">Gestor</option><option value="admin">Administrador</option></select></label><label class="text-xs font-bold text-slate-600">Equipe<select name="teamId" class="field mt-1"><option value="">Sem equipe</option>@foreach(var team in Model.Teams){<option value="@team.Id">@team.Name</option>}</select></label><label class="text-xs font-bold text-slate-600">Custo interno por hora (R$)<input name="hourlyRate" type="number" step="0.01" min="0" class="field mt-1" /></label><button class="rounded-lg bg-slate-900 py-2 text-sm font-bold text-white md:col-span-2">Criar acesso</button></form></details></div><div class="mt-5 space-y-3">@foreach (var profile in Model.Profiles) { var rate = Model.Rates.FirstOrDefault(r => r.UserId == profile.Id)?.HourlyRate ?? 0; <form asp-action="UpdateUser" method="post" data-searchable class="rounded-xl border @(profile.IsActive ? "border-slate-200" : "border-slate-200 bg-slate-50 opacity-70") p-4"><input type="hidden" name="id" value="@profile.Id" /><div class="mb-3 flex items-center justify-between"><strong>@(profile.FullName ?? profile.Email)</strong><span class="rounded-full px-2 py-1 text-xs font-bold @(profile.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600")">@(profile.IsActive ? "Ativa" : "Desativada")</span></div><div class="grid gap-2 md:grid-cols-4"><label class="text-xs font-bold text-slate-600">Nome<input name="fullName" value="@profile.FullName" class="field mt-1" /></label><label class="text-xs font-bold text-slate-600">Função<select name="role" class="field mt-1"><option value="user" selected="@(profile.Role == "user")">Colaborador</option><option value="manager" selected="@(profile.Role == "manager")">Gestor</option><option value="admin" selected="@(profile.Role == "admin")">Administrador</option></select></label><label class="text-xs font-bold text-slate-600">Equipe<select name="teamId" class="field mt-1"><option value="">Sem equipe</option>@foreach(var team in Model.Teams){<option value="@team.Id" selected="@(profile.TeamId == team.Id)">@team.Name</option>}</select></label><label class="text-xs font-bold text-slate-600">Custo interno/hora<input type="number" step="0.01" min="0" name="hourlyRate" value="@rate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="field mt-1" /></label></div><div class="mt-3 flex gap-3"><button class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-bold text-white">Salvar alterações</button>@if(profile.IsActive){<button type="submit" formaction="/Admin/DeleteUser" onclick="return confirm('Desativar esta pessoa? O sistema exigirá que não existam tarefas abertas atribuídas a ela.');" class="text-xs font-bold text-red-600">Desativar</button>}else{<button type="submit" formaction="/Admin/ReactivateUser" class="text-xs font-bold text-emerald-700">Reativar</button>}</div></form> }</div></section>
    <aside class="space-y-6"><section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Equipes</h2><p class="mt-1 text-sm text-slate-500">Usadas para organizar capacidade, planejamento e indicadores.</p><form asp-action="SaveTeam" method="post" class="mt-4 space-y-2"><input name="Name" required class="field" placeholder="Nome da equipe" /><textarea name="Description" class="field" placeholder="Como esta equipe atua?"></textarea><button class="w-full rounded-lg bg-slate-900 py-2 text-sm font-bold text-white">Adicionar equipe</button></form><div class="mt-4 space-y-2">@foreach(var team in Model.Teams){var members = Model.TeamMemberCounts.GetValueOrDefault(team.Id);<div data-searchable class="rounded-lg bg-slate-50 p-3 text-sm"><div class="flex justify-between gap-2"><strong>@team.Name</strong><span class="text-xs text-slate-500">@members pessoa(s)</span></div><small class="block text-slate-400">@team.Description</small><form asp-action="DeleteTeam" method="post" onsubmit="return confirm('Excluir esta equipe? Só é permitido quando não houver pessoas vinculadas.');" class="mt-2"><input type="hidden" name="id" value="@team.Id"/><button class="text-xs font-bold text-red-600">Excluir equipe</button></form></div>}</div></section>
    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Clientes</h2><p class="mt-1 text-sm text-slate-500">São usados nos Boards e no faturamento. Contratos e faturas protegem o cadastro contra exclusão.</p><form asp-action="SaveClient" method="post" class="mt-4 space-y-2"><input name="Name" required class="field" placeholder="Nome do cliente" /><input name="Email" type="email" class="field" placeholder="E-mail" /><input name="Phone" class="field" placeholder="Telefone" /><button class="w-full rounded-lg bg-slate-900 py-2 text-sm font-bold text-white">Adicionar cliente</button></form><div class="mt-4 space-y-2">@foreach(var client in Model.Clients){var contracts = Model.ClientContractCounts.GetValueOrDefault(client.Id);var invoices = Model.ClientInvoiceCounts.GetValueOrDefault(client.Id);<div data-searchable class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@client.Name</strong><small class="block text-slate-400">@client.Email</small><small class="mt-1 block text-slate-500">@contracts contrato(s) · @invoices fatura(s)</small><form asp-action="DeleteClient" method="post" onsubmit="return confirm('Excluir este cliente? Só é permitido sem contratos e sem faturas.');" class="mt-2"><input type="hidden" name="id" value="@client.Id"/><button class="text-xs font-bold text-red-600">Excluir cliente</button></form></div>}</div></section></aside>
</div>
