@{
    var path = Context.Request.Path.Value ?? "/";
    var links = new[]
    {
        ("/Dashboard", "layout-dashboard", "Dashboard"),
        ("/Work", "list-checks", "Meu trabalho"),
        ("/Boards", "kanban-square", "Quadros"),
        ("/Management", "users-round", "Gestão da equipe"),
        ("/Schedule", "calendar-range", "Cronograma"),
        ("/Planning", "network", "Planejamento"),
        ("/Billing", "badge-dollar-sign", "Faturamento"),
        ("/Executive", "chart-no-axes-combined", "Painel executivo"),
        ("/Reports", "file-chart-column", "Relatórios"),
        ("/Forms", "clipboard-list", "Formulários"),
        ("/Automations", "workflow", "Automações"),
        ("/Admin", "shield-check", "Administração"),
        ("/Settings", "settings", "Configurações")
    };
}
<aside id="desktopSidebar" class="relative hidden h-screen w-64 shrink-0 flex-col border-r border-slate-200 bg-white md:flex">
    <div class="flex h-16 items-center gap-3 border-b border-slate-100 px-5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-white"><i data-lucide="activity" class="h-5 w-5"></i></div>
        <strong class="sidebar-text text-lg">PulseBoard</strong>
        <button id="toggleSidebarBtn" class="ml-auto rounded-lg p-2 text-slate-400 hover:bg-slate-100"><i id="toggleIcon" data-lucide="panel-left-close" class="h-4 w-4"></i></button>
    </div>
    <nav class="flex-1 space-y-1 overflow-y-auto p-3">
        @foreach (var link in links)
        {
            var active = path.StartsWith(link.Item1, StringComparison.OrdinalIgnoreCase);
            <a href="@link.Item1" title="@link.Item3" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold @(active ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-50")">
                <i data-lucide="@link.Item2" class="h-5 w-5 shrink-0"></i><span class="sidebar-text">@link.Item3</span>
            </a>
        }
    </nav>
    <div class="border-t border-slate-100 p-4 text-xs text-slate-500"><span class="sidebar-text truncate">@User.Identity?.Name</span></div>
</aside>
<script>
(() => {
    const sidebar = document.getElementById('desktopSidebar');
    const button = document.getElementById('toggleSidebarBtn');
    if (!sidebar || !button) return;
    let collapsed = localStorage.getItem('pulseboard.sidebar') === 'collapsed';
    const apply = () => {
        sidebar.classList.toggle('w-64', !collapsed);
        sidebar.classList.toggle('w-20', collapsed);
        sidebar.querySelectorAll('.sidebar-text').forEach(x => x.classList.toggle('hidden', collapsed));
    };
    apply();
    button.addEventListener('click', () => { collapsed = !collapsed; localStorage.setItem('pulseboard.sidebar', collapsed ? 'collapsed' : 'open'); apply(); });
})();
</script>
