@model PulseBoardMigration.Models.BillingViewModel
@{
    ViewData["Title"] = "Faturamento";
    var monthStart = DateTime.Parse(Model.Month + "-01");
    var tasks = Model.Tasks.ToDictionary(x => x.Id);
    var boards = Model.Boards.ToDictionary(x => x.Id);
    var clients = Model.Clients.ToDictionary(x => x.Id);
    string ApprovalLabel(string status) => status switch { "pending" => "Aguardando aprovação", "approved" => "Aprovado", "rejected" => "Rejeitado", _ => status };
    string InvoiceLabel(string status) => status switch { "draft" => "Rascunho", "issued" => "Emitida", "paid" => "Paga", "cancelled" => "Cancelada", _ => status };
    string ContractScope(PulseBoardMigration.Models.ClientContract contract) => contract.BoardId.HasValue && boards.TryGetValue(contract.BoardId.Value, out var board) ? board.Name : "Projeto não localizado";
    string BillingStage(PulseBoardMigration.Models.TimeLog log) => log.BillingStatus == "invoiced" ? "Faturado" : log.ApprovalStatus == "approved" ? "Pronto para faturar" : log.ApprovalStatus == "rejected" ? "Rejeitado" : "Aguardando aprovação";
}

<div class="mb-7 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
        <p class="text-xs font-bold uppercase tracking-wide text-indigo-600">Financeiro</p>
        <h1 class="mt-1 text-3xl font-bold text-slate-900">Faturamento</h1>
        <p class="mt-1 max-w-3xl text-sm text-slate-500">Acompanhe o caminho do trabalho até a receita: registrar, aprovar para cobrança e emitir a fatura.</p>
    </div>
    <form method="get" class="flex items-end gap-2 rounded-xl border bg-white p-3 shadow-sm">
        <label class="block text-xs font-bold uppercase tracking-wide text-slate-500">Período exibido
            <input type="month" name="month" value="@Model.Month" class="field mt-1" onchange="this.form.submit()" />
        </label>
    </form>
</div>

<section class="mb-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-950">
    <h2 class="font-bold">O caminho de cada apontamento</h2>
    <ol class="mt-2 grid gap-2 md:grid-cols-4">
        <li><strong>1. Registrar:</strong> a pessoa informa o tempo realizado.</li>
        <li><strong>2. Aprovar:</strong> o gestor libera a hora para cobrança.</li>
        <li><strong>3. Pronto para faturar:</strong> a hora aprovada aguarda uma fatura.</li>
        <li><strong>4. Receita emitida:</strong> a fatura é emitida ou paga.</li>
    </ol>
</section>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Trabalho registrado</p><p class="mt-1 text-2xl font-bold text-slate-900">@((Model.Logs.Sum(x => x.Minutes) / 60m).ToString("0.0")) h</p><p class="mt-1 text-xs text-slate-500">Tempo realizado no período</p></div>
    <div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Aguardando sua aprovação</p><p class="mt-1 text-2xl font-bold text-amber-600">@Model.Logs.Count(x => x.ApprovalStatus == "pending")</p><p class="mt-1 text-xs text-slate-500">Ainda não pode entrar na cobrança</p></div>
    <div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Aprovado para cobrança</p><p class="mt-1 text-2xl font-bold text-indigo-600">@Model.ApprovedUnbilled.ToString("C")</p><p class="mt-1 text-xs text-slate-500">Aprovado, faturável e sem fatura</p></div>
    <div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Receita emitida</p><p class="mt-1 text-2xl font-bold text-emerald-600">@Model.PeriodInvoiceTotal.ToString("C")</p><p class="mt-1 text-xs text-slate-500">Faturas emitidas ou pagas deste período</p></div>
</div>

@if (Model.UnratedLogs.Count > 0)
{
    <section class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
        <h2 class="font-bold">@Model.UnratedLogs.Count apontamento(s) sem valor do contrato</h2>
        <p class="mt-1">Essas horas não podem entrar em uma fatura porque foram registradas sem contrato ativo para o mesmo projeto, cliente e data. O valor histórico não muda automaticamente; use o contrato antes de registrar novos apontamentos.</p>
    </section>
}

@if (Model.UncostedLogs.Count > 0)
{
    <section class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-950">
        <h2 class="font-bold">@Model.UncostedLogs.Count apontamento(s) sem custo/hora histórico</h2>
        <p class="mt-1">Esses registros foram gravados com custo R$ 0,00. Confirme o valor/hora da pessoa que realmente registrou a atividade — não apenas o responsável da tarefa — e a data em que o apontamento foi criado. Alterações futuras no Admin não reescrevem o histórico já registrado.</p>
    </section>
}

<section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-bold">Contratos que definem o valor da hora</h2><p class="mt-1 text-sm text-slate-500">O valor do contrato ativo é copiado para novos apontamentos na data em que são registrados.</p></div>
        <a href="#contratos" class="text-sm font-bold text-indigo-700 hover:underline">Gerenciar contratos</a>
    </div>
    <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
    @foreach (var contract in Model.Contracts.Where(x => x.IsActive))
    {
        <div class="rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm">
            <div class="flex items-start justify-between gap-3"><strong class="text-slate-900">@contract.Name</strong><span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-700">Ativo</span></div>
            <p class="mt-2 text-xs text-slate-600">@ContractScope(contract) · @(clients.TryGetValue(contract.ClientId, out var client) ? client.Name : "Cliente não localizado")</p>
            <p class="mt-3 text-lg font-bold text-indigo-800">@contract.BillingRate.ToString("C")/h</p>
            <p class="mt-1 text-xs text-slate-500">Válido desde @contract.StartsOn.ToString("dd/MM/yyyy")@(contract.EndsOn.HasValue ? " até " + contract.EndsOn.Value.ToString("dd/MM/yyyy") : "")</p>
        </div>
    }
    @if (!Model.Contracts.Any(x => x.IsActive)) { <p class="rounded-xl bg-amber-50 p-4 text-sm text-amber-950 md:col-span-2 xl:col-span-3">Nenhum contrato ativo. Novos apontamentos faturáveis serão registrados sem valor para cobrança.</p> }
    </div>
</section>

<section class="mb-7 overflow-hidden rounded-2xl border bg-white">
    <div class="flex flex-col gap-1 border-b p-5 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-lg font-bold">Aprovar apontamentos</h2><p class="text-sm text-slate-500">Aprovar não emite uma fatura: apenas libera a hora para cobrança. O valor da hora é a fotografia do contrato ativo no momento do lançamento.</p></div><span class="text-xs font-bold text-slate-500">@Model.Logs.Count registro(s) no período</span></div>
    <div class="overflow-x-auto"><table class="w-full min-w-[1320px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400"><tr><th class="p-4">Data</th><th>Tarefa e projeto</th><th>Pessoa que registrou</th><th>Horas</th><th>Custo/h</th><th>Custo total</th><th>Valor do contrato/h</th><th>Valor deste apontamento</th><th>Etapa da cobrança</th><th class="pr-4">Ação</th></tr></thead><tbody class="divide-y">
    @foreach (var log in Model.Logs)
    {
        tasks.TryGetValue(log.TaskId, out var task); var person = Model.Profiles.FirstOrDefault(x => x.Id == log.UserId); boards.TryGetValue(task?.BoardId ?? Guid.Empty, out var board);
        <tr>
            <td class="p-4 whitespace-nowrap">@log.LogDate.ToString("dd/MM/yyyy")</td>
            <td><strong class="text-slate-900">@task?.Title</strong><small class="mt-1 block text-slate-400">@(board?.Name ?? "Projeto não localizado") · @log.Description</small></td>
            <td>@(person?.FullName ?? person?.Email ?? "Pessoa não localizada")</td>
            <td>@((log.Minutes / 60m).ToString("0.##")) h</td>
            <td>@log.CostRateSnapshot.ToString("C")/h</td>
            <td class="font-bold text-amber-700">@log.CostAmount.ToString("C")</td>
            <td>@(log.IsBillable ? log.BillingRateSnapshot.ToString("C") + "/h" : "Não faturável")</td>
            <td class="font-bold text-indigo-700">@(log.IsBillable ? log.BillableAmount.ToString("C") : "—")</td>
            <td><span class="rounded-full px-2 py-1 text-xs font-bold @(log.BillingStatus == "invoiced" ? "bg-indigo-100 text-indigo-700" : log.ApprovalStatus == "approved" ? "bg-emerald-100 text-emerald-700" : log.ApprovalStatus == "rejected" ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-700")">@BillingStage(log)</span><small class="mt-1 block text-slate-400">@ApprovalLabel(log.ApprovalStatus) · @(log.BillingStatus == "invoiced" ? "Incluído em fatura" : "Sem fatura")</small></td>
            <td class="pr-4">
            @if (log.ApprovalStatus == "pending" && log.BillingStatus == "unbilled")
            {
                <div class="flex gap-3">
                    <form asp-action="ReviewLog" method="post"><input type="hidden" name="logId" value="@log.Id" /><input type="hidden" name="approve" value="true" /><input type="hidden" name="month" value="@Model.Month" /><button class="font-bold text-emerald-700 hover:underline">Aprovar</button></form>
                    <form asp-action="ReviewLog" method="post"><input type="hidden" name="logId" value="@log.Id" /><input type="hidden" name="approve" value="false" /><input type="hidden" name="month" value="@Model.Month" /><button class="font-bold text-red-700 hover:underline">Rejeitar</button></form>
                    <form asp-action="DeletePendingLog" method="post" onsubmit="return confirm('Excluir este apontamento pendente? O tempo será removido da tarefa e esta ação não poderá ser desfeita.');"><input type="hidden" name="logId" value="@log.Id" /><input type="hidden" name="month" value="@Model.Month" /><button class="font-bold text-slate-600 hover:underline">Excluir</button></form>
                </div>
            }
            else { <span class="text-xs text-slate-400">Registro protegido</span> }
            </td>
        </tr>
    }
    @if (!Model.Logs.Any()) { <tr><td colspan="10" class="p-8 text-center text-slate-500">Nenhum apontamento no período selecionado.</td></tr> }
    </tbody></table></div>
</section>

<div class="grid gap-7 xl:grid-cols-2">
    <section id="contratos" class="rounded-2xl border bg-white p-5">
        <div class="mb-4"><h2 class="text-lg font-bold">Gerenciar contratos de cobrança</h2><p class="mt-1 text-sm text-slate-500">Cada contrato vincula cliente e projeto. O valor por hora é usado somente em novos apontamentos registrados durante sua vigência.</p></div>
        <form asp-action="SaveContract" method="post" class="grid gap-3 sm:grid-cols-2"><input type="hidden" name="month" value="@Model.Month" /><label class="text-sm font-semibold text-slate-700 sm:col-span-2">Projeto<select name="BoardId" required class="field mt-1"><option value="">Selecione o projeto</option>@foreach (var board in Model.Boards.OrderBy(x => x.Name)) { <option value="@board.Id">@board.Name</option> }</select></label><label class="text-sm font-semibold text-slate-700">Cliente<select name="ClientId" required class="field mt-1"><option value="">Selecione o cliente</option>@foreach (var client in Model.Clients.OrderBy(x => x.Name)) { <option value="@client.Id">@client.Name</option> }</select></label><label class="text-sm font-semibold text-slate-700">Nome do contrato<input name="Name" required maxlength="255" class="field mt-1" placeholder="Ex.: Sustentação 2026" /></label><input type="hidden" name="ContractType" value="hourly" /><label class="text-sm font-semibold text-slate-700">Valor por hora<input type="number" min="0" step="0.01" name="BillingRate" required class="field mt-1" placeholder="0,00" /></label><label class="text-sm font-semibold text-slate-700">Orçamento de referência <span class="font-normal text-slate-400">(opcional)</span><input type="number" min="0" step="0.01" name="BudgetAmount" class="field mt-1" placeholder="0,00" /></label><label class="text-sm font-semibold text-slate-700">Início<input type="date" name="StartsOn" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required class="field mt-1" /></label><label class="text-sm font-semibold text-slate-700">Fim <span class="font-normal text-slate-400">(opcional)</span><input type="date" name="EndsOn" class="field mt-1" /></label><label class="flex items-center gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="IsActive" value="true" checked /><input type="hidden" name="IsActive" value="false" /> Contrato ativo para novos apontamentos</label><button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white sm:col-span-2">Salvar contrato por hora</button></form>
        <div class="mt-6 space-y-2"><h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">Todos os contratos</h3>@foreach (var contract in Model.Contracts) { <details class="rounded-xl border bg-slate-50 p-3"><summary class="cursor-pointer list-none"><div class="flex items-start justify-between gap-3"><div><strong class="text-slate-900">@contract.Name</strong><p class="mt-1 text-xs text-slate-500">@ContractScope(contract) · @(clients.TryGetValue(contract.ClientId, out var client) ? client.Name : "Cliente não localizado") · @contract.BillingRate.ToString("C")/h</p></div><span class="rounded-full px-2 py-1 text-xs font-bold @(contract.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600")">@(contract.IsActive ? "Ativo" : "Inativo")</span></div></summary><form asp-action="SaveContract" method="post" class="mt-4 grid gap-3 border-t pt-4 sm:grid-cols-2"><input type="hidden" name="Id" value="@contract.Id" /><input type="hidden" name="month" value="@Model.Month" /><input type="hidden" name="ContractType" value="hourly" /><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Projeto<select name="BoardId" class="field mt-1">@foreach (var board in Model.Boards.OrderBy(x => x.Name)) { <option value="@board.Id" selected="@(contract.BoardId == board.Id ? "selected" : null)">@board.Name</option> }</select></label><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Cliente<select name="ClientId" class="field mt-1">@foreach (var client in Model.Clients.OrderBy(x => x.Name)) { <option value="@client.Id" selected="@(contract.ClientId == client.Id ? "selected" : null)">@client.Name</option> }</select></label><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Nome<input name="Name" value="@contract.Name" required class="field mt-1" /></label><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Valor/hora<input name="BillingRate" type="number" min="0" step="0.01" value="@contract.BillingRate" required class="field mt-1" /></label><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Início<input name="StartsOn" type="date" value="@contract.StartsOn.ToString("yyyy-MM-dd")" required class="field mt-1" /></label><label class="text-xs font-bold uppercase tracking-wide text-slate-500">Fim<input name="EndsOn" type="date" value="@(contract.EndsOn?.ToString("yyyy-MM-dd"))" class="field mt-1" /></label><label class="flex items-center gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="IsActive" value="true" checked="@(contract.IsActive ? "checked" : null)" /><input type="hidden" name="IsActive" value="false" /> Disponível para novos apontamentos</label><button class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-800 sm:col-span-2">Salvar alterações</button></form></details> }@if (!Model.Contracts.Any()) { <p class="rounded-lg bg-slate-50 p-3 text-sm text-slate-500">Nenhum contrato disponível para os projetos que você gerencia.</p> }</div>
    </section>

    <section class="rounded-2xl border bg-white p-5">
        <div class="mb-4"><h2 class="text-lg font-bold">Gerar e acompanhar faturas</h2><p class="mt-1 text-sm text-slate-500">A fatura reúne somente horas aprovadas, não faturadas, do projeto e cliente escolhidos. Cancele somente rascunhos para liberar as horas novamente.</p></div>
        <form asp-action="GenerateInvoice" method="post" class="grid gap-3 sm:grid-cols-2"><label class="text-sm font-semibold text-slate-700 sm:col-span-2">Projeto<select name="boardId" required class="field mt-1"><option value="">Selecione o projeto</option>@foreach (var board in Model.Boards.OrderBy(x => x.Name)) { <option value="@board.Id">@board.Name</option> }</select></label><label class="text-sm font-semibold text-slate-700">Cliente<select name="clientId" required class="field mt-1"><option value="">Selecione o cliente</option>@foreach (var client in Model.Clients.OrderBy(x => x.Name)) { <option value="@client.Id">@client.Name</option> }</select></label><label class="text-sm font-semibold text-slate-700">Vencimento <span class="font-normal text-slate-400">(opcional)</span><input type="date" name="dueDate" class="field mt-1" /></label><label class="text-sm font-semibold text-slate-700">Início do período<input type="date" name="periodStart" required value="@monthStart.ToString("yyyy-MM-dd")" class="field mt-1" /></label><label class="text-sm font-semibold text-slate-700">Fim do período<input type="date" name="periodEnd" required value="@monthStart.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")" class="field mt-1" /></label><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white sm:col-span-2">Criar rascunho com horas aprovadas</button></form>
        <div class="mt-6 space-y-3"><h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">Faturas do período</h3>@foreach (var invoice in Model.Invoices) { var items = Model.ItemsFor(invoice.Id); <details class="rounded-xl border p-4"><summary class="cursor-pointer list-none"><div class="flex items-start justify-between gap-3"><div><strong class="text-slate-900">@invoice.Reference</strong><p class="mt-1 text-xs text-slate-500">@(clients.TryGetValue(invoice.ClientId, out var client) ? client.Name : "Cliente não localizado") · @invoice.PeriodStart.ToString("dd/MM") a @invoice.PeriodEnd.ToString("dd/MM/yyyy")</p></div><div class="text-right"><strong class="text-slate-900">@invoice.Total.ToString("C")</strong><span class="ml-2 rounded-full px-2 py-1 text-xs font-bold @(invoice.Status == "paid" ? "bg-emerald-100 text-emerald-700" : invoice.Status == "cancelled" ? "bg-slate-200 text-slate-600" : invoice.Status == "issued" ? "bg-indigo-100 text-indigo-700" : "bg-amber-100 text-amber-700")">@InvoiceLabel(invoice.Status)</span></div></div></summary><div class="mt-4 border-t pt-4"><p class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500">Itens da fatura</p><ul class="space-y-2 text-sm">@foreach (var item in items) { <li class="flex justify-between gap-3"><span>@item.Description <small class="block text-slate-400">@((item.Minutes / 60m).ToString("0.##")) h × @item.UnitRate.ToString("C")/h</small></span><strong>@item.Amount.ToString("C")</strong></li> }@if (!items.Any()) { <li class="text-slate-500">Itens não disponíveis para consulta.</li> }</ul><div class="mt-4 flex flex-wrap gap-2">@if (invoice.Status == "draft") { <form asp-action="UpdateInvoice" method="post"><input type="hidden" name="invoiceId" value="@invoice.Id" /><input type="hidden" name="status" value="issued" /><input type="hidden" name="month" value="@Model.Month" /><button class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-bold text-white">Marcar como emitida</button></form><form asp-action="UpdateInvoice" method="post" onsubmit="return confirm('Cancelar este rascunho? As horas voltarão para a fila de faturamento.');"><input type="hidden" name="invoiceId" value="@invoice.Id" /><input type="hidden" name="status" value="cancelled" /><input type="hidden" name="month" value="@Model.Month" /><button class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-bold text-red-700">Cancelar rascunho</button></form> } else if (invoice.Status == "issued") { <form asp-action="UpdateInvoice" method="post"><input type="hidden" name="invoiceId" value="@invoice.Id" /><input type="hidden" name="status" value="paid" /><input type="hidden" name="month" value="@Model.Month" /><button class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white">Registrar pagamento</button></form><p class="self-center text-xs text-slate-500">Fatura emitida não pode ser cancelada aqui; use o processo de estorno.</p> } else { <p class="text-xs text-slate-500">Esta fatura está encerrada e não aceita alterações.</p> }</div></div></details> }@if (!Model.Invoices.Any()) { <p class="rounded-lg bg-slate-50 p-3 text-sm text-slate-500">Nenhuma fatura cujo período intersecte o mês selecionado.</p> }</div>
    </section>
</div>
