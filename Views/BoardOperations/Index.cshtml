@model PulseBoardMigration.Models.BoardOperationsViewModel
@{
    ViewData["Title"] = $"Operações · {Model.Board.Name}";
    var ownTasks = Model.Tasks.Where(x => x.BoardId == Model.Board.Id).ToList();
    string TaskName(Guid id) => Model.Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? "Tarefa indisponível";
    string PersonName(Guid id) { var person = Model.Profiles.FirstOrDefault(x => x.Id == id); return person?.FullName ?? person?.Email ?? "Usuário indisponível"; }
    string BoardName(Guid taskId) { var task = Model.Tasks.FirstOrDefault(x => x.Id == taskId); return Model.Boards.FirstOrDefault(x => x.Id == task?.BoardId)?.Name ?? "Board indisponível"; }
}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div><a asp-controller="Boards" asp-action="Details" asp-route-id="@Model.Board.Id" class="text-sm font-bold text-indigo-600">← Voltar ao Board</a><h1 class="mt-2 text-2xl font-bold">Central de operações</h1><p class="text-sm text-slate-500">Fluxo, governança, SLA e integrações de @Model.Board.Name.</p></div>
    <a asp-action="Import" asp-route-id="@Model.Board.Id" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white">Importar Monday / Excel</a>
</div>
<div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-5">
    <div class="rounded-xl border bg-white p-4"><span class="text-[10px] font-bold uppercase text-slate-400">Tarefas</span><strong class="mt-1 block text-xl">@ownTasks.Count</strong></div>
    <div class="rounded-xl border bg-white p-4"><span class="text-[10px] font-bold uppercase text-slate-400">Etapas</span><strong class="mt-1 block text-xl">@Model.Board.Settings.Count</strong></div>
    <div class="rounded-xl border bg-white p-4"><span class="text-[10px] font-bold uppercase text-slate-400">Automações</span><strong class="mt-1 block text-xl">@Model.Automations.Count(x => x.IsActive)</strong></div>
    <div class="rounded-xl border bg-white p-4"><span class="text-[10px] font-bold uppercase text-slate-400">Formulários</span><strong class="mt-1 block text-xl">@Model.IntakeForms.Count(x => x.IsActive)</strong></div>
    <div class="rounded-xl border bg-white p-4"><span class="text-[10px] font-bold uppercase text-slate-400">Aprovações pendentes</span><strong class="mt-1 block text-xl">@Model.ApprovalSteps.Count(x => x.Status == "pending")</strong></div>
</div>

<div class="grid gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border bg-white p-5 xl:col-span-2">
        <h2 class="text-lg font-bold">Editor visual de colunas e WIP</h2><p class="mb-4 text-sm text-slate-500">Defina ordem, cor, limite simultâneo e aprovação obrigatória. Etapas com tarefas não podem ser removidas ou ter o identificador alterado.</p>
        <form asp-action="SaveColumns" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><div id="columnEditor" class="space-y-2">
            @for (var i = 0; i < Model.Board.Settings.Count; i++)
            {
                var column = Model.Board.Settings[i];
                <div class="column-row grid items-center gap-2 rounded-xl bg-slate-50 p-3 md:grid-cols-[1fr_1.3fr_80px_130px_1fr_auto]">
                    <input name="columnId" value="@column.Id" class="field" aria-label="Identificador"/><input name="title" value="@column.Title" class="field" aria-label="Nome"/><input name="color" type="color" value="@column.Color" class="h-10 w-full rounded border" aria-label="Cor"/><input name="wipLimit" type="number" min="1" value="@column.WipLimit" class="field" placeholder="Sem limite"/><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="requiresApproval" value="@i" checked="@column.RequiresApproval"/> Exigir aprovação</label><div class="flex"><button type="button" class="column-up p-2 text-slate-400" title="Subir">↑</button><button type="button" class="column-down p-2 text-slate-400" title="Descer">↓</button><button type="button" class="column-remove p-2 text-red-500" title="Remover">×</button></div>
                </div>
            }
        </div><div class="mt-3 flex gap-2"><button type="button" id="addColumn" class="rounded-lg border px-3 py-2 text-sm font-bold">+ Coluna</button><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Salvar fluxo</button></div></form>
    </section>

    <section class="rounded-2xl border bg-white p-5 xl:col-span-2">
        <h2 class="text-lg font-bold">Ações em massa</h2><p class="mb-4 text-sm text-slate-500">Selecione até 500 tarefas. A operação é transacional: ou todas são atualizadas ou nenhuma é alterada.</p>
        <form id="bulkForm" asp-action="Bulk" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><div class="mb-3 grid gap-2 md:grid-cols-5"><select id="bulkAction" name="action" class="field"><option value="assign">Atribuir</option><option value="move">Mover</option><option value="archive">Arquivar</option><option value="due_date">Alterar prazo</option><option value="priority">Alterar prioridade</option></select><select data-bulk-field="assign" name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach (var person in Model.Profiles) { <option value="@person.Id">@(person.FullName ?? person.Email)</option> }</select><select data-bulk-field="move" name="status" class="field">@foreach (var column in Model.Board.Settings) { <option value="@column.Id">@column.Title</option> }</select><input data-bulk-field="due_date" name="dueDate" type="date" class="field"/><select data-bulk-field="priority" name="priority" class="field"><option value="medium">Média</option><option value="low">Baixa</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div>
            <div class="max-h-72 overflow-y-auto rounded-xl border"><label class="sticky top-0 flex border-b bg-slate-50 p-3 text-xs font-bold"><input id="selectAllTasks" type="checkbox" class="mr-2"/> Selecionar todas (@ownTasks.Count)</label>@foreach (var task in ownTasks) { <label class="flex items-center gap-3 border-b p-3 text-sm last:border-0"><input type="checkbox" name="taskIds" value="@task.Id"/><span class="min-w-0 flex-1 truncate">@task.Title</span><span class="text-xs text-slate-400">@task.Status</span></label> }</div><div id="bulkError" class="mt-3 hidden rounded-lg bg-red-50 p-3 text-sm text-red-700"></div><button class="mt-3 rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Executar ação</button>
        </form>
    </section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Formulários externos</h2><form asp-action="CreateIntake" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input name="title" required maxlength="200" class="field" placeholder="Nome do formulário"/><textarea name="description" maxlength="2000" class="field" placeholder="Orientação ao cliente"></textarea><div class="grid grid-cols-2 gap-2"><select name="targetStatus" class="field">@foreach (var column in Model.Board.Settings) { <option value="@column.Id">@column.Title</option> }</select><select name="priority" class="field"><option value="medium">Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div><label class="flex gap-2 text-sm"><input type="checkbox" name="requireEmail" value="true" checked/> E-mail obrigatório</label><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Criar link seguro</button></form>
        @foreach (var form in Model.IntakeForms) { <div class="mt-3 rounded-lg bg-slate-50 p-3 text-xs"><div class="flex items-center justify-between gap-2"><strong>@form.Title</strong><span class="rounded-full px-2 py-1 font-bold @(form.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-500")">@(form.IsActive ? "Ativo" : "Pausado")</span></div><a target="_blank" href="/solicitacao/@form.PublicToken" class="mt-1 block break-all text-indigo-600">@($"{Context.Request.Scheme}://{Context.Request.Host}/solicitacao/{form.PublicToken}")</a><form asp-action="ToggleIntake" method="post" class="mt-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="id" value="@form.Id"/><input type="hidden" name="active" value="@(!form.IsActive)"/><button class="font-bold text-indigo-600">@(form.IsActive ? "Pausar recebimento" : "Reativar")</button></form></div> }
    </section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Automações X → Y</h2><p class="text-sm text-slate-500">Regras restritas a este Board e validadas contra suas etapas e usuários.</p><a asp-controller="Automations" asp-action="Index" asp-route-boardId="@Model.Board.Id" class="mt-4 inline-flex rounded-lg border px-3 py-2 text-sm font-bold text-indigo-600">Configurar automações</a>@foreach (var automation in Model.Automations) { <div class="mt-3 rounded-lg bg-slate-50 p-3 text-xs"><strong>@automation.Title</strong><p>@automation.TriggerType = @automation.TriggerValue → @automation.ActionType</p></div> }</section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Aprovação em múltiplas etapas</h2><form asp-action="AddApproval" method="post" class="mt-3 grid gap-2 md:grid-cols-3"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="taskId" required class="field"><option value="">Selecione a tarefa</option>@foreach (var task in ownTasks) { <option value="@task.Id">@task.Title</option> }</select><input name="sequence" type="number" min="1" value="1" required class="field"/><select name="approverId" required class="field"><option value="">Selecione o aprovador</option>@foreach (var person in Model.Profiles) { <option value="@person.Id">@(person.FullName ?? person.Email)</option> }</select><button class="rounded-lg bg-indigo-600 p-2 text-sm font-bold text-white md:col-span-3">Adicionar etapa</button></form>
        @foreach (var step in Model.ApprovalSteps) { <div class="mt-2 rounded-lg bg-slate-50 p-3 text-xs"><div class="flex justify-between gap-2"><strong>@TaskName(step.TaskId) · etapa @step.Sequence</strong><form asp-action="DeleteApproval" method="post" onsubmit="return confirm('Remover esta etapa?')"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="id" value="@step.Id"/><button class="font-bold text-red-500">Remover</button></form></div><p>@PersonName(step.ApproverId) — @step.Status</p>@if (step.Status == "pending") { <form asp-action="DecideApproval" method="post" class="mt-2 flex gap-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="stepId" value="@step.Id"/><button name="decision" value="approve" class="font-bold text-emerald-600">Aprovar</button><button name="decision" value="reject" class="font-bold text-red-600">Rejeitar</button></form> }</div> }
    </section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Substituto durante férias</h2><form asp-action="AddDelegation" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="delegatorId" required class="field">@foreach (var person in Model.Profiles) { <option value="@person.Id">@(person.FullName ?? person.Email)</option> }</select><select name="substituteId" required class="field">@foreach (var person in Model.Profiles) { <option value="@person.Id">@(person.FullName ?? person.Email)</option> }</select><div class="grid grid-cols-2 gap-2"><input name="startsOn" type="date" required class="field"/><input name="endsOn" type="date" required class="field"/></div><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Programar substituição</button></form>@foreach (var delegation in Model.Delegations) { <div class="mt-2 flex items-center justify-between rounded-lg bg-slate-50 p-3 text-xs"><span><strong>@PersonName(delegation.DelegatorId) → @PersonName(delegation.SubstituteId)</strong><small class="block text-slate-500">@delegation.StartsOn.ToString("dd/MM/yyyy") a @delegation.EndsOn.ToString("dd/MM/yyyy")</small></span><form asp-action="DeleteDelegation" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="id" value="@delegation.Id"/><button class="font-bold text-red-500">Remover</button></form></div> }</section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Campos espelhados entre Boards</h2><form asp-action="AddMirror" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="sourceTaskId" required class="field">@foreach (var task in Model.Tasks) { <option value="@task.Id">@BoardName(task.Id) · @task.Title</option> }</select><select name="targetTaskId" required class="field">@foreach (var task in Model.Tasks) { <option value="@task.Id">@BoardName(task.Id) · @task.Title</option> }</select><select name="fieldName" class="field"><option value="status">Status</option><option value="priority">Prioridade</option><option value="due_date">Prazo</option><option value="assigned_to">Responsável</option></select><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Criar espelhamento</button></form>@foreach (var mirror in Model.Mirrors) { <div class="mt-2 flex items-center justify-between rounded-lg bg-slate-50 p-3 text-xs"><span><strong>@TaskName(mirror.SourceTaskId) → @TaskName(mirror.TargetTaskId)</strong><small class="block text-slate-500">Campo: @mirror.FieldName</small></span><form asp-action="DeleteMirror" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="id" value="@mirror.Id"/><button class="font-bold text-red-500">Remover</button></form></div> }</section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Dependências entre projetos</h2><p class="text-sm text-slate-500">Impede a conclusão enquanto o pré-requisito não estiver concluído e bloqueia dependências circulares.</p><form asp-action="AddCrossDependency" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="taskId" required class="field">@foreach (var task in ownTasks) { <option value="@task.Id">@task.Title</option> }</select><select name="dependsOnTaskId" required class="field"><option value="">Selecione o pré-requisito</option>@foreach (var task in Model.Tasks.Where(x => x.BoardId != Model.Board.Id)) { <option value="@task.Id">@BoardName(task.Id) · @task.Title</option> }</select><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Vincular pré-requisito</button></form>@foreach (var dependency in Model.CrossDependencies) { <div class="mt-2 flex items-center justify-between rounded-lg bg-slate-50 p-3 text-xs"><span><strong>@TaskName(dependency.TaskId)</strong><small class="block text-slate-500">depende de @BoardName(dependency.DependsOnTaskId) · @TaskName(dependency.DependsOnTaskId)</small></span><form asp-action="DeleteCrossDependency" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="id" value="@dependency.Id"/><button class="font-bold text-red-500">Remover</button></form></div> }</section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">SLA com calendário comercial</h2><p class="mt-2 text-sm text-slate-500">Considera segunda a sexta e feriados cadastrados. O monitor é executado a cada 15 minutos.</p><div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs"><div class="rounded-lg bg-amber-50 p-3"><strong>60 min antes</strong><br/>Preventivo</div><div class="rounded-lg bg-red-50 p-3"><strong>No vencimento</strong><br/>Violação</div><div class="rounded-lg bg-purple-50 p-3"><strong>60 min depois</strong><br/>Escalação</div></div></section>

    <section class="rounded-2xl border bg-white p-5 xl:col-span-2"><h2 class="text-lg font-bold">Histórico completo por campo</h2><div class="mt-3 max-h-96 overflow-auto"><table class="w-full text-left text-xs"><thead class="sticky top-0 bg-white"><tr class="border-b"><th class="p-2">Data</th><th>Tarefa</th><th>Campo</th><th>Antes</th><th>Depois</th><th>Autor</th></tr></thead><tbody>@foreach (var history in Model.FieldHistory) { <tr class="border-b"><td class="p-2">@history.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@TaskName(history.TaskId)</td><td>@history.FieldName</td><td class="max-w-48 truncate text-red-500" title="@history.OldValue">@history.OldValue</td><td class="max-w-48 truncate text-emerald-600" title="@history.NewValue">@history.NewValue</td><td>@(history.ChangedBy.HasValue ? PersonName(history.ChangedBy.Value) : "Sistema")</td></tr> }</tbody></table></div></section>
</div>

@section Scripts {
<script src="~/js/board-operations.js" asp-append-version="true"></script>
}
