@{ var canManageMobile = User.IsInRole("admin") || User.IsInRole("manager"); }
<div id="mobileOverlay" class="fixed inset-0 z-40 hidden bg-slate-950/40 md:hidden"></div>
<aside id="mobileSidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-white p-4 shadow-2xl transition-transform md:hidden">
    <div class="mb-5 flex items-center justify-between"><strong class="text-xl">PulseBoard</strong><button id="closeMobileMenuBtn">✕</button></div>
    <nav class="space-y-1 text-sm font-semibold">
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Dashboard">Início</a>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Work">Meu trabalho</a>
        <p class="px-3 pt-3 text-[10px] font-bold tracking-wider text-slate-400">PROJETOS</p>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Boards">Projetos</a>
        @if(canManageMobile){<a class="block rounded-lg p-3 hover:bg-slate-50" href="/Schedule">Cronograma</a>
        <p class="px-3 pt-3 text-[10px] font-bold tracking-wider text-slate-400">GESTÃO</p>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Planning">Central de gestão</a>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Management">Equipe</a>
        <p class="px-3 pt-3 text-[10px] font-bold tracking-wider text-slate-400">FINANCEIRO</p>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Billing">Faturamento</a>
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Reports">Indicadores</a>}
        <p class="px-3 pt-3 text-[10px] font-bold tracking-wider text-slate-400">CONFIGURAÇÕES</p>
        @if(canManageMobile){<a class="block rounded-lg p-3 hover:bg-slate-50" href="/Admin">Organização</a>}
        <a class="block rounded-lg p-3 hover:bg-slate-50" href="/Settings">Meu perfil</a>
    </nav>
</aside>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const menu = document.getElementById('mobileSidebar'), overlay = document.getElementById('mobileOverlay');
    const set = open => { menu?.classList.toggle('-translate-x-full', !open); overlay?.classList.toggle('hidden', !open); };
    document.getElementById('openMobileMenuBtn')?.addEventListener('click', () => set(true));
    document.getElementById('closeMobileMenuBtn')?.addEventListener('click', () => set(false));
    overlay?.addEventListener('click', () => set(false));
});
</script>
