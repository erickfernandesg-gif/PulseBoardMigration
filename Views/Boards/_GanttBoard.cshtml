@model PulseBoardMigration.Models.BoardDetailsViewModel

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
        <div>
            <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Cronograma do Projeto</h3>
            <p class="text-xs text-slate-400">Visualização de prazos baseado nas datas de início e entrega de tarefas.</p>
        </div>
        <div class="flex bg-slate-100 p-1 rounded-lg" id="gantt-modes">
            <button onclick="changeGanttMode('Day')" class="px-2.5 py-1 text-xs font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors">Dia</button>
            <button onclick="changeGanttMode('Week')" class="px-2.5 py-1 text-xs font-medium rounded-md bg-white text-slate-900 shadow-sm transition-colors">Semana</button>
            <button onclick="changeGanttMode('Month')" class="px-2.5 py-1 text-xs font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors">Mês</button>
        </div>
    </div>

    <div class="w-full overflow-x-auto border border-slate-100 rounded-lg bg-slate-50/50 p-2 min-h-[300px]">
        @if (Model.Tasks == null || !Model.Tasks.Any())
        {
            <div class="flex min-h-[250px] items-center justify-center text-sm text-slate-400 italic">
                Nenhuma tarefa cadastrada para exibir no gráfico de Gantt.
            </div>
        }
        else
        {
            <svg id="gantt-chart" class="w-full"></svg>
        }
    </div>
</div>

@if (Model.Tasks != null && Model.Tasks.Any())
{
    <script>
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                const tasks = [
                    @foreach (var task in Model.Tasks)
                    {
                            var startStr = (task.StartDate ?? task.CreatedAt).ToString("yyyy-MM-dd");
                            var endStr = (task.DueDate ?? (task.StartDate ?? task.CreatedAt).AddDays(1)).ToString("yyyy-MM-dd");
                            var progress = task.Status == "done" ? 100 : (task.Status == "in-progress" ? 50 : 0);

                            <text>
                            {
                                id: '@task.Id',
                                name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(task.Title))',
                                start: '@startStr',
                                end: '@endStr',
                                progress: @progress,
                                custom_class: '@(task.Priority == "Urgente" ? "gantt-urgente" : (task.Priority == "Alta" ? "gantt-alta" : "gantt-normal"))'
                            },
                            </text>
                    }
                ];

                if (tasks.length > 0 && document.getElementById('gantt-chart')) {
                    window.ganttChartInstance = new Gantt("#gantt-chart", tasks, {
                        header_height: 50,
                        column_width: 30,
                        step: 24,
                        view_mode: 'Week',
                        language: 'pt',
                        custom_popup_html: function(task) {
                            return `
                                <div class="p-3 bg-white border border-slate-100 rounded-lg shadow-xl text-xs font-sans min-w-[160px]">
                                    <div class="font-bold text-slate-900 mb-1">${task.name}</div>
                                    <div class="text-slate-500 mb-1">Progresso: ${task.progress}%</div>
                                    <div class="text-[10px] text-slate-400">Início: ${task.start}</div>
                                    <div class="text-[10px] text-slate-400">Entrega: ${task.end}</div>
                                </div>
                            `;
                        }
                    });
                }
            });

            window.changeGanttMode = function (mode) {
                if (window.ganttChartInstance) {
                    window.ganttChartInstance.change_view_mode(mode);

                    const buttons = document.querySelectorAll('#gantt-modes button');
                    buttons.forEach(btn => {
                        btn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm');
                        btn.classList.add('text-slate-600');
                    });

                    const clickedBtn = Array.from(buttons).find(btn => btn.getAttribute('onclick').includes(mode));
                    if (clickedBtn) {
                        clickedBtn.classList.remove('text-slate-600');
                        clickedBtn.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
                    }
                }
            };
        })();
    </script>

    <style>
        .gantt .bar-wrapper.gantt-urgente .bar {
            fill: #ef4444;
        }

        .gantt .bar-wrapper.gantt-urgente .bar-progress {
            fill: #dc2626;
        }

        .gantt .bar-wrapper.gantt-alta .bar {
            fill: #f59e0b;
        }

        .gantt .bar-wrapper.gantt-alta .bar-progress {
            fill: #d97706;
        }

        .gantt .bar-wrapper.gantt-normal .bar {
            fill: #6366f1;
        }

        .gantt .bar-wrapper.gantt-normal .bar-progress {
            fill: #4f46e5;
        }
    </style>
}