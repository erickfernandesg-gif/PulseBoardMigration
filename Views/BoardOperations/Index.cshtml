@model PulseBoardMigration.Models.BoardOperationsViewModel
@{ ViewData["Title"] = $"Operações · {Model.Board.Name}"; var ownTasks = Model.Tasks.Where(x => x.BoardId == Model.Board.Id).ToList(); }
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
 <div><a asp-controller="Boards" asp-action="Details" asp-route-id="@Model.Board.Id" class="text-sm font-bold text-indigo-600">← Voltar ao Board</a><h1 class="mt-2 text-2xl font-bold">Central de operações</h1><p class="text-sm text-slate-500">Fluxo, governança, SLA e integrações de @Model.Board.Name.</p></div>
 <a asp-action="Import" asp-route-id="@Model.Board.Id" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white">Importar Monday / Excel</a>
</div>
<div class="grid gap-6 xl:grid-cols-2">
 <section class="rounded-2xl border bg-white p-5 xl:col-span-2">
  <h2 class="text-lg font-bold">Editor visual de colunas e WIP</h2><p class="mb-4 text-sm text-slate-500">Defina ordem, cor, limite simultâneo e aprovação obrigatória.</p>
  <form asp-action="SaveColumns" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><div id="columnEditor" class="space-y-2">
  @for(var i=0;i<Model.Board.Settings.Count;i++){var c=Model.Board.Settings[i];<div class="column-row grid gap-2 rounded-xl bg-slate-50 p-3 md:grid-cols-5"><input name="columnId" value="@c.Id" class="field" aria-label="Identificador"/><input name="title" value="@c.Title" class="field" aria-label="Nome"/><input name="color" type="color" value="@c.Color" class="h-10 w-full rounded border" aria-label="Cor"/><input name="wipLimit" type="number" min="1" value="@c.WipLimit" class="field" placeholder="WIP sem limite"/><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="requiresApproval" value="@i" checked="@c.RequiresApproval"/> Exigir aprovação</label></div>}
  </div><div class="mt-3 flex gap-2"><button type="button" onclick="addColumnRow()" class="rounded-lg border px-3 py-2 text-sm font-bold">+ Coluna</button><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Salvar fluxo</button></div></form>
 </section>
 <section class="rounded-2xl border bg-white p-5 xl:col-span-2">
  <h2 class="text-lg font-bold">Ações em massa</h2><p class="mb-4 text-sm text-slate-500">Selecione até 500 tarefas; a operação inteira confirma ou é revertida.</p>
  <form id="bulkForm" asp-action="Bulk" method="post"><input type="hidden" name="boardId" value="@Model.Board.Id"/><div class="mb-3 grid gap-2 md:grid-cols-5"><select name="action" class="field"><option value="assign">Atribuir</option><option value="move">Mover</option><option value="archive">Arquivar</option><option value="due_date">Alterar prazo</option><option value="priority">Alterar prioridade</option></select><select name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><select name="status" class="field">@foreach(var c in Model.Board.Settings){<option value="@c.Id">@c.Title</option>}</select><input name="dueDate" type="date" class="field"/><select name="priority" class="field"><option value="medium">Média</option><option value="low">Baixa</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div>
  <div class="max-h-64 overflow-y-auto rounded-xl border"><label class="flex border-b bg-slate-50 p-3 text-xs font-bold"><input id="selectAllTasks" type="checkbox" class="mr-2"/> Selecionar todas</label>@foreach(var t in ownTasks){<label class="flex items-center gap-3 border-b p-3 text-sm last:border-0"><input type="checkbox" name="taskIds" value="@t.Id"/><span class="min-w-0 flex-1 truncate">@t.Title</span><span class="text-xs text-slate-400">@t.Status</span></label>}</div><button class="mt-3 rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Executar ação</button></form>
 </section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Formulários externos</h2><form asp-action="CreateIntake" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input name="title" required class="field" placeholder="Nome do formulário"/><textarea name="description" class="field" placeholder="Orientação ao cliente"></textarea><div class="grid grid-cols-2 gap-2"><select name="targetStatus" class="field">@foreach(var c in Model.Board.Settings){<option value="@c.Id">@c.Title</option>}</select><select name="priority" class="field"><option value="medium">Média</option><option value="high">Alta</option></select></div><label class="flex gap-2 text-sm"><input type="checkbox" name="requireEmail" value="true" checked/> E-mail obrigatório</label><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Criar link seguro</button></form>@foreach(var f in Model.IntakeForms){<div class="mt-3 rounded-lg bg-slate-50 p-3 text-xs"><strong>@f.Title</strong><a target="_blank" href="/solicitacao/@f.PublicToken" class="mt-1 block break-all text-indigo-600">@($"{Context.Request.Scheme}://{Context.Request.Host}/solicitacao/{f.PublicToken}")</a></div>}</section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Automações X → Y</h2><p class="text-sm text-slate-500">As regras podem ser restritas a este Board.</p><a asp-controller="Automations" asp-action="Index" asp-route-boardId="@Model.Board.Id" class="mt-4 inline-flex rounded-lg border px-3 py-2 text-sm font-bold text-indigo-600">Configurar automações</a>@foreach(var a in Model.Automations){<div class="mt-3 rounded-lg bg-slate-50 p-3 text-xs"><strong>@a.Title</strong><p>Quando @a.TriggerType = @a.TriggerValue → @a.ActionType</p></div>}</section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Aprovação em múltiplas etapas</h2><form asp-action="AddApproval" method="post" class="mt-3 grid gap-2 md:grid-cols-3"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="taskId" class="field">@foreach(var t in ownTasks){<option value="@t.Id">@t.Title</option>}</select><input name="sequence" type="number" min="1" value="1" class="field"/><select name="approverId" class="field">@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><button class="rounded-lg bg-indigo-600 p-2 text-sm font-bold text-white md:col-span-3">Adicionar etapa</button></form>@foreach(var s in Model.ApprovalSteps){var t=ownTasks.FirstOrDefault(x=>x.Id==s.TaskId);var p=Model.Profiles.FirstOrDefault(x=>x.Id==s.ApproverId);<div class="mt-2 rounded-lg bg-slate-50 p-3 text-xs"><strong>@t?.Title · etapa @s.Sequence</strong><p>@(p?.FullName??p?.Email) — @s.Status</p>@if(s.Status=="pending"){<form asp-action="DecideApproval" method="post" class="mt-2 flex gap-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="stepId" value="@s.Id"/><button name="decision" value="approve" class="text-emerald-600">Aprovar</button><button name="decision" value="reject" class="text-red-600">Rejeitar</button></form>}</div>}</section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Substituto durante férias</h2><form asp-action="AddDelegation" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="delegatorId" class="field">@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><select name="substituteId" class="field">@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><div class="grid grid-cols-2 gap-2"><input name="startsOn" type="date" required class="field"/><input name="endsOn" type="date" required class="field"/></div><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Programar substituição</button></form></section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Campos espelhados entre Boards</h2><form asp-action="AddMirror" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="sourceTaskId" class="field">@foreach(var t in Model.Tasks){var b=Model.Boards.FirstOrDefault(x=>x.Id==t.BoardId);<option value="@t.Id">@b?.Name · @t.Title</option>}</select><select name="targetTaskId" class="field">@foreach(var t in Model.Tasks){var b=Model.Boards.FirstOrDefault(x=>x.Id==t.BoardId);<option value="@t.Id">@b?.Name · @t.Title</option>}</select><select name="fieldName" class="field"><option value="status">Status</option><option value="priority">Prioridade</option><option value="due_date">Prazo</option><option value="assigned_to">Responsável</option></select><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Criar espelhamento</button></form></section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">Dependências entre projetos</h2><p class="text-sm text-slate-500">Impede a conclusão enquanto o pré-requisito não estiver concluído.</p><form asp-action="AddCrossDependency" method="post" class="mt-3 space-y-2"><input type="hidden" name="boardId" value="@Model.Board.Id"/><select name="taskId" class="field">@foreach(var t in ownTasks){<option value="@t.Id">@t.Title</option>}</select><select name="dependsOnTaskId" class="field">@foreach(var t in Model.Tasks.Where(x=>x.BoardId!=Model.Board.Id)){var b=Model.Boards.FirstOrDefault(x=>x.Id==t.BoardId);<option value="@t.Id">@b?.Name · @t.Title</option>}</select><button class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white">Vincular pré-requisito</button></form></section>
 <section class="rounded-2xl border bg-white p-5"><h2 class="text-lg font-bold">SLA com calendário comercial</h2><p class="mt-2 text-sm text-slate-500">Considera segunda a sexta e feriados cadastrados, com alertas ao responsável e ao gestor.</p><div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs"><div class="rounded-lg bg-amber-50 p-3"><strong>80%</strong><br/>Preventivo</div><div class="rounded-lg bg-red-50 p-3"><strong>100%</strong><br/>Violação</div><div class="rounded-lg bg-purple-50 p-3"><strong>120%</strong><br/>Escalação</div></div></section>
 <section class="rounded-2xl border bg-white p-5 xl:col-span-2"><h2 class="text-lg font-bold">Histórico completo por campo</h2><div class="mt-3 max-h-96 overflow-auto"><table class="w-full text-left text-xs"><thead><tr class="border-b"><th class="p-2">Data</th><th>Tarefa</th><th>Campo</th><th>Antes</th><th>Depois</th><th>Autor</th></tr></thead><tbody>@foreach(var h in Model.FieldHistory){var t=ownTasks.FirstOrDefault(x=>x.Id==h.TaskId);var p=Model.Profiles.FirstOrDefault(x=>x.Id==h.ChangedBy);<tr class="border-b"><td class="p-2">@h.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@t?.Title</td><td>@h.FieldName</td><td class="max-w-48 truncate text-red-500">@h.OldValue</td><td class="max-w-48 truncate text-emerald-600">@h.NewValue</td><td>@(p?.FullName??p?.Email??"Sistema")</td></tr>}</tbody></table></div></section>
</div>
@section Scripts{<script>function addColumnRow(){const host=document.getElementById('columnEditor'),i=host.children.length,row=document.createElement('div');row.className='column-row grid gap-2 rounded-xl bg-slate-50 p-3 md:grid-cols-5';row.innerHTML='<input name="columnId" value="stage-'+(i+1)+'" class="field"/><input name="title" value="Nova etapa" class="field"/><input name="color" type="color" value="#6366f1" class="h-10 w-full rounded border"/><input name="wipLimit" type="number" min="1" class="field" placeholder="WIP sem limite"/><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="requiresApproval" value="'+i+'"/> Exigir aprovação</label>';host.append(row)}document.getElementById('selectAllTasks')?.addEventListener('change',e=>document.querySelectorAll('#bulkForm input[name=taskIds]').forEach(x=>x.checked=e.target.checked));document.getElementById('bulkForm')?.addEventListener('submit',async e=>{e.preventDefault();const r=await fetch(e.target.action,{method:'POST',body:new FormData(e.target)}),j=await r.json();if(!r.ok||!j.success)return alert(j.message||'Falha na operação');location.reload()});</script>}
