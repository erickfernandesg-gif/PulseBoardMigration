@model List<PulseBoardMigration.Models.Board>
@{ ViewData["Title"] = "Formulários"; }
<div class="mb-8"><h1 class="text-2xl font-bold">Formulários de solicitação</h1><p class="text-sm text-slate-500">Links públicos para receber demandas diretamente nos quadros.</p></div>
<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    @foreach(var board in Model)
    {
        var url = $"{Context.Request.Scheme}://{Context.Request.Host}/Submit/{board.Id}";
        <article data-searchable class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"><i data-lucide="clipboard-list"></i></div>
            <h2 class="mt-4 font-bold">Entrada: @board.Name</h2><p class="mt-2 text-sm text-slate-500">Solicitações recebidas entram na caixa de entrada deste quadro.</p>
            <input id="url-@board.Id" readonly value="@url" class="field mt-5 text-xs" />
            <div class="mt-3 flex gap-2"><button onclick="navigator.clipboard.writeText(document.getElementById('url-@board.Id').value);this.textContent='Copiado!'" class="flex-1 rounded-lg bg-indigo-600 py-2 text-xs font-bold text-white">Copiar link</button><a target="_blank" href="/Submit/@board.Id" class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold">Testar</a></div>
        </article>
    }
</div>
