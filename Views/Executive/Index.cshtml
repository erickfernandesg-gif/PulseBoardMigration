@model PulseBoardMigration.Models.ExecutiveViewModel
@{ ViewData["Title"] = "Painel executivo"; }
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h1 class="text-2xl font-bold">Painel executivo</h1><p class="text-sm text-slate-500">Capacidade, consumo e custo do portfólio.</p></div><form method="get" class="flex gap-2"><input type="month" name="fromMonth" value="@Model.FromMonth" class="field"/><input type="month" name="toMonth" value="@Model.ToMonth" class="field"/><button class="rounded-lg bg-slate-900 px-4 text-sm font-bold text-white">Filtrar</button></form></div>
<div class="grid gap-4 md:grid-cols-5"><div class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-slate-400">Planejado</p><p class="mt-2 text-3xl font-bold">@((Model.EstimatedMinutes/60m).ToString("0.0"))h</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-slate-400">Realizado</p><p class="mt-2 text-3xl font-bold text-indigo-600">@((Model.LoggedMinutes/60m).ToString("0.0"))h</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-slate-400">Custo realizado</p><p class="mt-2 text-3xl font-bold text-amber-600">@Model.TotalCost.ToString("C")</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-slate-400">Receita faturada</p><p class="mt-2 text-3xl font-bold text-emerald-600">@Model.TotalBilledRevenue.ToString("C")</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-slate-400">Margem bruta</p><p class="mt-2 text-3xl font-bold @(Model.TotalMargin<0?"text-red-600":"text-emerald-600")">@Model.TotalMargin.ToString("C")</p></div></div>
@{
    void MetricTable(string title, List<PulseBoardMigration.Models.ExecutiveMetric> items)
    {
        <section class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="mb-4 text-lg font-bold">@title</h2><div class="space-y-4">@foreach(var item in items.Take(10)){var max=Math.Max(item.EstimatedMinutes,item.LoggedMinutes); var pct=max==0?0:item.LoggedMinutes*100/max;<div data-searchable><div class="mb-1 flex justify-between text-sm"><strong>@item.Name</strong><span class="text-slate-500">@((item.LoggedMinutes/60m).ToString("0.#"))h · @item.Cost.ToString("C")</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-indigo-500" style="width:@Math.Min(100,pct)%"></div></div></div>}</div></section>
    }
}
<div class="mt-6 grid gap-6 xl:grid-cols-3">@{MetricTable("Projetos",Model.Projects);MetricTable("Clientes",Model.Clients);MetricTable("Carga da equipe",Model.Workload);}</div>
<section class="mt-6 overflow-x-auto rounded-2xl border bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Orçamento e margem por projeto</h2></div><table class="w-full min-w-[1000px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Projeto</th><th>Orçamento</th><th>Custo</th><th>Comprometido</th><th>Previsão final</th><th>Receita</th><th>Margem</th><th>Consumo</th></tr></thead><tbody class="divide-y">@foreach(var item in Model.ProjectFinancials){<tr><td class="p-4 font-bold">@item.Name</td><td>@item.Budget.ToString("C")</td><td>@item.ActualCost.ToString("C")</td><td>@item.CommittedCost.ToString("C")</td><td>@item.ForecastAtCompletion.ToString("C")</td><td>@item.BilledRevenue.ToString("C")</td><td class="font-bold @(item.GrossMargin<0?"text-red-600":"text-emerald-600")">@item.GrossMargin.ToString("C")</td><td><span class="rounded-full px-2 py-1 text-xs font-bold @(item.BudgetConsumedPercent>=100?"bg-red-100 text-red-700":item.BudgetConsumedPercent>=80?"bg-amber-100 text-amber-700":"bg-emerald-100 text-emerald-700")">@item.BudgetConsumedPercent.ToString("0")%</span></td></tr>}</tbody></table></section>
<section class="mt-6 overflow-x-auto rounded-2xl border bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Indicadores de entrega da equipe</h2><p class="text-xs text-slate-500">Use os indicadores para remover gargalos e melhorar estimativas, não como ranking isolado.</p></div><table class="w-full min-w-[900px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Pessoa</th><th>Concluídas</th><th>Em aberto</th><th>Atrasadas</th><th>Bloqueadas</th><th>No prazo</th><th>Real/estimado</th></tr></thead><tbody class="divide-y">@foreach(var item in Model.PeoplePerformance){<tr><td class="p-4 font-bold">@item.Name</td><td>@item.CompletedTasks</td><td>@item.OpenTasks</td><td class="text-red-600">@item.OverdueTasks</td><td class="text-amber-600">@item.BlockedTasks</td><td>@item.OnTimePercent.ToString("0")%</td><td>@item.EstimateAccuracyPercent.ToString("0")%</td></tr>}</tbody></table></section>
