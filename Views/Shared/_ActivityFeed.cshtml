@model PulseBoardMigration.Models.BoardDetailsViewModel
<section class="rounded-xl border border-slate-200 bg-white p-6">
    <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-slate-600">Atividade recente</h2>
    @if (!Model.Activity.Any())
    {
        <p class="text-sm italic text-slate-400">Nenhuma atividade registrada.</p>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var log in Model.Activity.Take(20))
            {
                var profile = Model.Profile(log.UserId);
                <div class="flex gap-3 border-b border-slate-100 pb-3 last:border-0">
                    <span class="mt-1 h-2 w-2 rounded-full bg-indigo-500"></span>
                    <div><p class="text-sm text-slate-700"><strong>@(profile?.FullName ?? profile?.Email ?? "Usuário")</strong> · @log.Action.Replace("_", " ")</p><p class="text-xs text-slate-400">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
                </div>
            }
        </div>
    }
</section>
