@model PulseBoardMigration.Models.ReportsViewModel
@{ ViewData["Title"] = "Relatórios"; }
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-wide text-indigo-600">Indicadores</p><h1 class="mt-1 text-2xl font-bold">Horas e custo por projeto</h1><p class="text-sm text-slate-500">O custo usa a taxa histórica registrada no apontamento. A pessoa responsável pela tarefa e a pessoa que registrou horas podem ser diferentes.</p></div><a asp-action="Export" asp-route-month="@Model.Month" asp-route-teamId="@Model.TeamId" asp-route-userId="@Model.UserId" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white">Exportar detalhes CSV</a></div>
<form method="get" class="mb-6 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-4">
    <input type="month" name="month" value="@Model.Month" class="field"/>
    <select name="teamId" class="field"><option value="">Todas as equipes</option>@foreach(var team in Model.Teams){<option value="@team.Id" selected="@(Model.TeamId == team.Id)">@team.Name</option>}</select>
    <select name="userId" class="field"><option value="">Todos os usuários</option>@foreach(var profile in Model.Profiles){<option value="@profile.Id" selected="@(Model.UserId == profile.Id)">@(profile.FullName ?? profile.Email)</option>}</select>
    <button class="rounded-lg bg-slate-900 text-sm font-bold text-white">Aplicar filtros</button>
</form>
<section class="mb-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-950"><strong>Leitura dos dados:</strong> esta tela é por execução. Horas, custo e tarefas consideram apontamentos cuja data está no mês filtrado. “Custo/hora aplicado” é a média ponderada da taxa histórica; se a taxa mudou, cada apontamento preserva a taxa da própria data.</section>
<div class="mb-6 grid gap-4 sm:grid-cols-4"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Tarefas com execução</p><p class="text-2xl font-bold">@Model.TotalTasks</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Concluídas</p><p class="text-2xl font-bold text-emerald-600">@Model.CompletedTasks</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Horas realizadas</p><p class="text-2xl font-bold text-indigo-600">@((Model.LoggedMinutes/60m).ToString("0.0")) h</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Custo realizado</p><p class="text-2xl font-bold text-amber-600">@Model.TotalCost.ToString("C")</p></div></div>
<section class="mb-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Resumo por projeto</h2><p class="text-sm text-slate-500">Tempo, custo e tarefas com execução no período filtrado.</p></div><table class="w-full min-w-[800px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Projeto</th><th>Tarefas com execução</th><th>Concluídas</th><th>Bloqueadas</th><th>Horas realizadas</th><th>Custo total</th></tr></thead><tbody class="divide-y">@foreach(var row in Model.Rows){<tr data-searchable><td class="p-4 font-bold">@row.BoardName</td><td>@row.TotalTasks</td><td>@row.CompletedTasks</td><td>@row.BlockedTasks</td><td>@((row.LoggedMinutes/60m).ToString("0.00")) h</td><td class="font-bold text-amber-700">@row.Cost.ToString("C")</td></tr>}@if(!Model.Rows.Any()){<tr><td colspan="6" class="p-8 text-center text-slate-500">Não há apontamentos para os filtros escolhidos.</td></tr>}</tbody></table></section>
<section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white"><div class="border-b p-5"><h2 class="text-lg font-bold">Composição do custo: pessoa e projeto</h2><p class="text-sm text-slate-500">Mostra quem registrou a hora, inclusive quando essa pessoa é diferente do responsável da tarefa.</p></div><table class="w-full min-w-[900px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Projeto</th><th>Pessoa que registrou</th><th>Lançamentos</th><th>Horas realizadas</th><th>Custo/hora aplicado</th><th>Custo total</th></tr></thead><tbody class="divide-y">@foreach(var row in Model.Contributors){<tr data-searchable><td class="p-4 font-bold">@row.BoardName</td><td>@row.PersonName</td><td>@row.Entries</td><td>@((row.LoggedMinutes/60m).ToString("0.00")) h</td><td>@row.EffectiveHourlyRate.ToString("C")/h</td><td class="font-bold text-amber-700">@row.Cost.ToString("C")</td></tr>}@if(!Model.Contributors.Any()){<tr><td colspan="6" class="p-8 text-center text-slate-500">Nenhum apontamento encontrado para os filtros escolhidos.</td></tr>}</tbody></table></section>
