@model List<PulseBoardMigration.Models.Board>
@{ ViewData["Title"] = "Quadros"; }
<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div><h1 class="text-2xl font-bold">Meus quadros</h1><p class="text-sm text-slate-500">Projetos e fluxos de trabalho.</p></div>
    <button onclick="openCreateBoardModal()" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white">+ Novo quadro</button>
</div>
@if (!Model.Any())
{
    <div class="rounded-2xl border-2 border-dashed border-slate-200 p-16 text-center"><h2 class="text-lg font-bold">Crie seu primeiro quadro</h2><button onclick="openCreateBoardModal()" class="mt-4 text-sm font-bold text-indigo-600">Começar agora</button></div>
}
else
{
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        @foreach(var board in Model)
        {
            <article data-searchable class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between"><div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"><i data-lucide="kanban-square"></i></div><div class="flex gap-1"><span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase text-slate-500">@board.Status</span><span class="rounded-full px-2 py-1 text-[10px] font-bold uppercase @(board.Health=="off_track"?"bg-red-100 text-red-700":board.Health=="at_risk"?"bg-amber-100 text-amber-700":"bg-emerald-100 text-emerald-700")">@board.Health</span></div></div>
                <a href="/Boards/Details/@board.Id" class="block"><h2 class="mt-4 text-lg font-bold hover:text-indigo-600">@board.Name</h2><p class="mt-2 line-clamp-2 min-h-10 text-sm text-slate-500">@board.Description</p></a>
                <details class="mt-5 border-t border-slate-100 pt-4">
                    <summary class="cursor-pointer text-xs font-bold text-slate-500">Editar configurações</summary>
                    <form asp-action="UpdateBoard" method="post" class="mt-3 space-y-2">
                        <input type="hidden" name="boardId" value="@board.Id"/><input name="name" value="@board.Name" required class="field"/><textarea name="description" class="field">@board.Description</textarea>
                        <select name="status" class="field"><option value="active" selected="@(board.Status=="active")">Ativo</option><option value="paused" selected="@(board.Status=="paused")">Pausado</option><option value="archived" selected="@(board.Status=="archived")">Arquivado</option></select>
                        <select name="health" class="field"><option value="on_track" selected="@(board.Health=="on_track")">No prazo</option><option value="at_risk" selected="@(board.Health=="at_risk")">Em risco</option><option value="off_track" selected="@(board.Health=="off_track")">Atrasado</option><option value="on_hold" selected="@(board.Health=="on_hold")">Em espera</option></select>
                        <div class="grid grid-cols-2 gap-2"><input type="date" name="plannedStart" value="@board.PlannedStart?.ToString("yyyy-MM-dd")" class="field"/><input type="date" name="plannedEnd" value="@board.PlannedEnd?.ToString("yyyy-MM-dd")" class="field"/></div><input type="number" min="0" step="0.01" name="budgetAmount" value="@board.BudgetAmount" class="field" placeholder="Orçamento"/>
                        <button class="w-full rounded-lg bg-slate-900 py-2 text-xs font-bold text-white">Salvar</button>
                    </form>
                    <form asp-action="DeleteBoard" method="post" class="mt-2" onsubmit="return confirm('Excluir este quadro e todas as tarefas?')"><input type="hidden" name="boardId" value="@board.Id"/><button class="w-full rounded-lg py-2 text-xs font-bold text-red-600 hover:bg-red-50">Excluir quadro</button></form>
                </details>
            </article>
        }
    </div>
}
@await Html.PartialAsync("_CreateBoardModal")
