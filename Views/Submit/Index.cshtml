@model PulseBoardMigration.Models.Board
@{ Layout = null; ViewData["Title"] = "Enviar solicitação"; }
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Solicitação - @Model.Name</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-100 p-4 sm:p-10"><main class="mx-auto max-w-2xl rounded-2xl bg-white p-7 shadow-xl">
    <div class="mb-7"><span class="text-xs font-bold uppercase tracking-widest text-indigo-600">PulseBoard</span><h1 class="mt-2 text-2xl font-bold">Enviar demanda para @Model.Name</h1><p class="mt-1 text-sm text-slate-500">@Model.Description</p></div>
    <div asp-validation-summary="All" class="mb-4 text-sm text-red-600"></div>
    <form method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <div><label class="mb-1 block text-sm font-bold">Título *</label><input name="title" required class="w-full rounded-lg border border-slate-200 p-3"/></div>
        <div><label class="mb-1 block text-sm font-bold">Descrição *</label><textarea name="description" required rows="6" class="w-full rounded-lg border border-slate-200 p-3"></textarea></div>
        <div class="grid gap-4 sm:grid-cols-2"><div><label class="mb-1 block text-sm font-bold">Seu nome</label><input name="requesterName" class="w-full rounded-lg border border-slate-200 p-3"/></div><div><label class="mb-1 block text-sm font-bold">Seu e-mail</label><input name="requesterEmail" type="email" class="w-full rounded-lg border border-slate-200 p-3"/></div></div>
        <div><label class="mb-1 block text-sm font-bold">Prioridade</label><select name="priority" class="w-full rounded-lg border border-slate-200 p-3"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div>
        <button class="w-full rounded-lg bg-indigo-600 py-3 font-bold text-white">Enviar solicitação</button>
    </form>
</main></body></html>
