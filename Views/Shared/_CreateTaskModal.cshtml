@model PulseBoardMigration.Models.BoardDetailsViewModel
<div id="createTaskModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm">
    <div class="max-h-[92vh] w-full max-w-4xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
        <div class="mb-6 flex items-center justify-between">
            <div><h2 class="text-xl font-bold">Nova demanda</h2><p class="text-sm text-slate-500">Escopo, planejamento e responsáveis.</p></div>
            <button type="button" onclick="closeCreateTaskModal()" class="rounded-lg p-2 hover:bg-slate-100">✕</button>
        </div>
        <form id="createTaskForm" asp-controller="Boards" asp-action="CreateTask" method="post" class="grid gap-6 md:grid-cols-2">
            <input type="hidden" name="boardId" value="@Model.Board.Id" />
            <div class="space-y-4">
                @if (Model.TaskTemplates.Any())
                {
                    <div><label class="label">Usar modelo</label><select id="CreateTaskTemplate" class="field"><option value="">Começar em branco</option>@foreach(var template in Model.TaskTemplates){var priority=template.Definition.TryGetValue("priority",out var templatePriority)?templatePriority?.ToString()??"medium":"medium";var minutes=template.Definition.TryGetValue("estimatedMinutes",out var templateMinutes)?templateMinutes?.ToString()??"0":"0";<option value="@template.Id" data-name="@template.Name" data-description="@template.Description" data-priority="@priority" data-estimated-minutes="@minutes">@template.Name</option>}</select><p class="mt-1 text-xs text-slate-400">Preenche os campos padrão; você ainda pode ajustá-los.</p></div>
                }
                <div><label class="label">Título *</label><input name="title" required maxlength="200" class="field" /></div>
                <div><label class="label">Descrição</label><textarea name="description" rows="4" maxlength="5000" class="field"></textarea></div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="label">Etapa</label><select id="CreateColumnId" name="columnId" class="field">@foreach (var c in Model.Columns){<option value="@c.Id">@c.Title</option>}</select></div>
                    <div><label class="label">Prioridade</label><select name="priority" class="field"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select></div>
                </div>
                <div><label class="label">Cliente</label><select name="clientId" class="field"><option value="">Operação interna</option>@foreach(var c in Model.Clients){<option value="@c.Id">@c.Name</option>}</select></div>
            </div>
            <div class="space-y-4">
                <div><label class="label">Responsável</label><select name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName ?? p.Email)</option>}</select></div>
                <div><label class="label">Colaboradores</label><div class="grid max-h-28 grid-cols-2 gap-2 overflow-y-auto rounded-lg border border-slate-200 p-3">@foreach(var p in Model.Profiles){<label class="flex items-center gap-2 text-xs"><input type="checkbox" name="collaboratorIds" value="@p.Id" /> @(p.FullName ?? p.Email)</label>}</div></div>
                <div class="grid grid-cols-2 gap-3"><div><label class="label">Início</label><input id="CreateStartDate" type="date" name="startDate" class="field" /></div><div><label class="label">Prazo</label><input id="CreateDueDate" type="date" name="dueDate" class="field" /></div></div>
                <div><label class="label">Ciclo</label><input type="month" name="targetMonth" class="field" /></div>
                <div><label class="label">Estimativa</label><div class="grid grid-cols-2 gap-3"><input type="number" min="0" max="100000" name="estimatedHours" placeholder="Horas" class="field" /><input type="number" min="0" max="59" name="estimatedMinutes" placeholder="Minutos" class="field" /></div></div>
            </div>
            <div id="createTaskError" role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 md:col-span-2"></div>
            <div class="flex justify-end gap-3 border-t border-slate-100 pt-5 md:col-span-2">
                <button type="button" onclick="closeCreateTaskModal()" class="rounded-lg px-4 py-2 text-sm font-bold text-slate-500">Cancelar</button>
                <button type="submit" class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-bold text-white">Criar demanda</button>
            </div>
        </form>
    </div>
</div>
