@{ ViewData["Title"] = "Redefinir senha - PulseBoard"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"]</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="flex min-h-screen items-center justify-center bg-gray-50 p-4"><main class="w-full max-w-sm rounded-lg bg-white p-8 shadow-md">
    <h1 class="text-2xl font-bold text-gray-900">Defina uma nova senha</h1><p class="mt-2 text-sm text-gray-500">Escolha uma senha com pelo menos 8 caracteres.</p>
    <form asp-action="ResetPassword" method="post" class="mt-6"><input id="recoveryAccessToken" name="recoveryAccessToken" type="hidden" /><div asp-validation-summary="All" class="mb-4 text-sm text-red-600"></div><label for="newPassword" class="mb-1 block text-sm font-medium text-gray-700">Nova senha</label><input id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required class="mb-4 w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" /><label for="confirmPassword" class="mb-1 block text-sm font-medium text-gray-700">Confirmar nova senha</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required class="w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" /><button id="resetButton" class="mt-5 w-full rounded-md bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700">Redefinir senha</button></form>
    <p id="invalidLink" class="mt-4 hidden rounded-md bg-red-50 p-3 text-sm text-red-700">Este link é inválido ou expirou. Solicite uma nova recuperação.</p>
    <a asp-action="ForgotPassword" class="mt-5 block text-center text-sm font-semibold text-blue-600 hover:underline">Solicitar novo link</a>
</main><script>const token = new URLSearchParams(window.location.hash.slice(1)).get('access_token'); const input = document.getElementById('recoveryAccessToken'); if (token) { input.value = token; history.replaceState(null, document.title, window.location.pathname); } else { document.getElementById('resetButton').disabled = true; document.getElementById('resetButton').classList.add('cursor-not-allowed','opacity-50'); document.getElementById('invalidLink').classList.remove('hidden'); }</script></body></html>
