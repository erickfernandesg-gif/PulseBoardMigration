@model PulseBoardMigration.Models.SettingsViewModel
@{ ViewData["Title"] = "Configurações"; }
<div class="mb-8"><h1 class="text-2xl font-bold">Configurações e perfil</h1><p class="text-sm text-slate-500">Gerencie seu nome, a forma como recebe alertas e a segurança da conta.</p></div>
<div class="max-w-3xl rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 bg-slate-50/70 p-6"><h2 class="text-lg font-bold">Informações pessoais</h2><p class="text-xs text-slate-500">Nome e dados da conta.</p></div>
    <form asp-action="UpdateProfile" method="post" class="p-6">
        <div class="mb-8 flex items-center gap-5">
            <div class="flex h-20 w-20 items-center justify-center rounded-full bg-indigo-600 text-2xl font-bold text-white">@((Model.Profile.FullName ?? Model.Profile.Email).FirstOrDefault().ToString().ToUpperInvariant())</div>
            <div><p class="font-bold">@Model.Profile.Email</p><span class="mt-1 inline-block rounded-full bg-indigo-50 px-2 py-1 text-[10px] font-bold uppercase text-indigo-700">@Model.Profile.Role</span></div>
        </div>
        <div><label class="label">Nome completo</label><input name="fullName" value="@Model.Profile.FullName" required class="field" /></div>
        <div class="mt-5"><label class="label">E-mail de acesso</label><input value="@Model.Profile.Email" disabled class="field cursor-not-allowed text-slate-400" /></div>
        <div class="mt-7 flex justify-end"><button class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white">Salvar alterações</button></div>
    </form>
</div>
<section class="mt-6 max-w-3xl rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 bg-slate-50/70 p-6"><h2 class="text-lg font-bold">Senha e segurança</h2><p class="text-xs text-slate-500">Use sua senha atual para confirmar esta alteração. O e-mail de acesso é administrado pela organização.</p></div>
    <form asp-action="ChangePassword" method="post" class="grid gap-4 p-6 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="label" for="currentPassword">Senha atual</label><input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required class="field" /></div>
        <div><label class="label" for="newPassword">Nova senha</label><input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required class="field" /><p class="mt-1 text-xs text-slate-500">Use pelo menos 8 caracteres.</p></div>
        <div><label class="label" for="confirmPassword">Confirmar nova senha</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required class="field" /></div>
        <div class="sm:col-span-2 flex items-center justify-between gap-4"><a asp-controller="Auth" asp-action="ForgotPassword" class="text-sm font-semibold text-indigo-700 hover:underline">Esqueci minha senha</a><button class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white">Alterar senha</button></div>
    </form>
</section>
<div class="mt-6 max-w-3xl rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 bg-slate-50/70 p-6"><h2 class="text-lg font-bold">Alertas e lembretes</h2><p class="text-xs text-slate-500">Escolha quais eventos exigem sua atenção.</p></div>
    <form asp-action="UpdateNotifications" method="post" class="grid gap-4 p-6 sm:grid-cols-2">
        <input type="hidden" name="inApp" value="false"/><input type="hidden" name="emailDigest" value="false"/><input type="hidden" name="dueReminders" value="false"/><input type="hidden" name="budgetAlerts" value="false"/><input type="hidden" name="mentionAlerts" value="false"/>
        <label class="flex items-center gap-3 rounded-xl border p-4"><input type="checkbox" name="inApp" value="true" checked="@Model.Notifications.InApp"/><span><strong class="block text-sm">Alertas no aplicativo</strong><small class="text-slate-500">Desative para não receber notificações no sino</small></span></label>
        <label class="flex items-center gap-3 rounded-xl border p-4"><input type="checkbox" name="mentionAlerts" value="true" checked="@Model.Notifications.MentionAlerts"/><span><strong class="block text-sm">Menções no chat</strong><small class="text-slate-500">Quando alguém mencionar você no aplicativo</small></span></label>
        <label class="flex items-center gap-3 rounded-xl border p-4"><input type="checkbox" name="dueReminders" value="true" checked="@Model.Notifications.DueReminders"/><span><strong class="block text-sm">Prazos</strong><small class="text-slate-500">Tarefas próximas ou atrasadas</small></span></label>
        <label class="flex items-center gap-3 rounded-xl border p-4"><input type="checkbox" name="budgetAlerts" value="true" checked="@Model.Notifications.BudgetAlerts"/><span><strong class="block text-sm">Orçamento</strong><small class="text-slate-500">Limites e desvios financeiros</small></span></label>
        <label class="flex items-center gap-3 rounded-xl border p-4"><input type="checkbox" name="emailDigest" value="true" checked="@Model.Notifications.EmailDigest"/><span><strong class="block text-sm">Resumo por e-mail</strong><small class="text-slate-500">Preparado para integração de e-mail</small></span></label>
        <label class="rounded-xl border p-4"><strong class="mb-2 block text-sm">Hora do resumo</strong><input type="number" min="0" max="23" name="digestHour" value="@Model.Notifications.DigestHour" class="field"/></label>
        <div class="sm:col-span-2 flex justify-end"><button class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white">Salvar alertas</button></div>
    </form>
</div>
