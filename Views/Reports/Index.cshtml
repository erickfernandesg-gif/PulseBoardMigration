@model PulseBoardMigration.Models.ReportsViewModel
@{ ViewData["Title"] = "Relatórios"; }
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h1 class="text-2xl font-bold">Relatórios operacionais e financeiros</h1><p class="text-sm text-slate-500">Produtividade, horas e custo por projeto.</p></div><a asp-action="Export" asp-route-month="@Model.Month" asp-route-teamId="@Model.TeamId" asp-route-userId="@Model.UserId" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white">Exportar CSV</a></div>
<form method="get" class="mb-6 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-4">
    <input type="month" name="month" value="@Model.Month" class="field"/>
    <select name="teamId" class="field"><option value="">Todas as equipes</option>@foreach(var team in Model.Teams){<option value="@team.Id" selected="@(Model.TeamId == team.Id)">@team.Name</option>}</select>
    <select name="userId" class="field"><option value="">Todos os usuários</option>@foreach(var profile in Model.Profiles){<option value="@profile.Id" selected="@(Model.UserId == profile.Id)">@(profile.FullName ?? profile.Email)</option>}</select>
    <button class="rounded-lg bg-slate-900 text-sm font-bold text-white">Aplicar filtros</button>
</form>
<div class="mb-6 grid gap-4 sm:grid-cols-4"><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Tarefas</p><p class="text-2xl font-bold">@Model.TotalTasks</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Concluídas</p><p class="text-2xl font-bold text-emerald-600">@Model.CompletedTasks</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Horas</p><p class="text-2xl font-bold text-indigo-600">@((Model.LoggedMinutes/60m).ToString("0.0"))</p></div><div class="rounded-xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-400">Custo</p><p class="text-2xl font-bold text-amber-600">@Model.TotalCost.ToString("C")</p></div></div>
<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-400"><tr><th class="p-4">Projeto</th><th>Tarefas</th><th>Concluídas</th><th>Bloqueadas</th><th>Horas</th><th>Custo</th></tr></thead><tbody class="divide-y">@foreach(var row in Model.Rows){<tr data-searchable><td class="p-4 font-bold">@row.BoardName</td><td>@row.TotalTasks</td><td>@row.CompletedTasks</td><td>@row.BlockedTasks</td><td>@((row.LoggedMinutes/60m).ToString("0.00"))</td><td>@row.Cost.ToString("C")</td></tr>}</tbody></table></div>
