@model PulseBoardMigration.Models.BoardDetailsViewModel
@{
    ViewData["Title"] = Model.Board.Name;
    string PriorityLabel(string value) => value switch
    {
        "low" => "Baixa",
        "high" => "Alta",
        "critical" => "Crítica",
        _ => "Média"
    };
}

<div class="mb-4 flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50">
            <i data-lucide="arrow-left" class="h-5 w-5"></i>
        </a>
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900">@Model.Board.Name</h1>
                <span class="rounded-full bg-indigo-50 px-2 py-1 text-[10px] font-bold uppercase text-indigo-700">@Model.Board.Status</span>
            </div>
            <p class="text-sm text-slate-500">@Model.Board.Description</p>
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <select id="filterMonth" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
            <option value="">Todos os ciclos</option>
            <option value="inbox">Sem ciclo</option>
            @foreach (var month in Model.Tasks.Where(t => !string.IsNullOrWhiteSpace(t.TargetMonth)).Select(t => t.TargetMonth).Distinct().OrderDescending())
            {
                <option value="@month">@month</option>
            }
        </select>
        <select id="filterUser" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
            <option value="">Toda a equipe</option>
            @foreach (var profile in Model.Profiles)
            {
                <option value="@profile.Id">@(profile.FullName ?? profile.Email)</option>
            }
        </select>
        <div class="flex rounded-lg bg-slate-100 p-1">
            <button data-view-target="kanban" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-indigo-600 shadow-sm">Kanban</button>
            <button data-view-target="table" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600">Tabela</button>
            <button data-view-target="gantt" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600">Gantt</button>
        </div>
        @if(Model.CanManageBoard){<a asp-controller="BoardOperations" asp-action="Index" asp-route-id="@Model.Board.Id" class="flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-sm font-bold text-slate-700"><i data-lucide="settings-2" class="h-4 w-4"></i> Operações</a>}
        <button onclick="openCreateTaskModal()" class="flex h-10 items-center gap-2 rounded-lg bg-indigo-600 px-4 text-sm font-bold text-white hover:bg-indigo-700">
            <i data-lucide="plus" class="h-4 w-4"></i> Nova demanda
        </button>
    </div>
</div>

<div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Total</p><p class="mt-0.5 text-xl font-bold">@Model.Tasks.Count</p></div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Concluídas</p><p class="mt-0.5 text-xl font-bold text-emerald-600">@Model.Tasks.Count(t => t.Status == "done")</p></div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Bloqueadas</p><p class="mt-0.5 text-xl font-bold text-red-600">@Model.Tasks.Count(t => t.IsBlocked)</p></div>
    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Horas registradas</p><p class="mt-0.5 text-xl font-bold text-indigo-600">@((Model.TimeLogs.Sum(x => x.Minutes) / 60m).ToString("0.0"))h</p></div>
</div>

<div id="view-kanban" class="kanban-board flex min-h-0 gap-4 overflow-x-auto overflow-y-hidden pb-3">
    @foreach (var column in Model.Columns)
    {
        <section class="flex h-full w-[min(20rem,calc(100vw-2rem))] shrink-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-100/60 p-3 md:w-80">
            <header class="mb-3 flex shrink-0 items-center justify-between">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-600">@column.Title</h2>
                <span class="rounded-full bg-white px-2 py-1 text-xs font-bold text-slate-500">@Model.Tasks.Count(t => t.Status == column.Id)</span>
            </header>
            <div data-column-id="@column.Id" class="kanban-column-body flex min-h-20 flex-1 flex-col gap-3 overflow-y-auto pr-1">
                @foreach (var task in Model.Tasks.Where(t => t.Status == column.Id).OrderBy(t => t.PositionIndex))
                {
                    var profile = Model.Profile(task.AssignedTo);
                    var client = Model.Client(task.ClientId);
                    var collaborators = Model.Collaborators.Where(c => c.TaskId == task.Id).Select(c => c.UserId);
                    <article class="kanban-task cursor-grab rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-indigo-300 hover:shadow-md"
                             data-task-id="@task.Id"
                             data-row-version="@task.RowVersion"
                             data-title="@task.Title"
                             data-description="@task.Description"
                             data-status="@task.Status"
                             data-priority="@task.Priority"
                             data-assigned-to="@task.AssignedTo"
                             data-client-id="@task.ClientId"
                             data-start-date="@(task.StartDate?.ToString("yyyy-MM-dd"))"
                             data-due-date="@(task.DueDate?.ToString("yyyy-MM-dd"))"
                             data-target-month="@task.TargetMonth"
                             data-estimated-minutes="@task.EstimatedMinutes"
                             data-sla-minutes="@task.SlaMinutes"
                             data-planned-value="@task.PlannedValue"
                             data-custom-fields="@System.Text.Json.JsonSerializer.Serialize(task.CustomFields)"
                             data-is-blocked="@task.IsBlocked.ToString().ToLowerInvariant()"
                             data-blocker-reason="@task.BlockerReason"
                             data-collaborators="@string.Join(",", collaborators)"
                             onclick="openTaskDetailsModal(this)">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="rounded-md bg-indigo-50 px-2 py-1 text-[10px] font-bold uppercase text-indigo-700">@PriorityLabel(task.Priority)</span>
                            @if (task.IsBlocked) { <i data-lucide="triangle-alert" class="h-4 w-4 text-red-500"></i> }
                        </div>
                        <h3 class="text-sm font-bold text-slate-900">@task.Title</h3>
                        <p class="mt-1 line-clamp-2 text-xs text-slate-500">@task.Description</p>
                        @if (client != null) { <p class="mt-3 text-[10px] font-bold uppercase text-slate-400">@client.Name</p> }
                        <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
                            <span class="text-xs text-slate-500">@(profile?.FullName ?? "Sem responsável")</span>
                            <span class="text-xs font-bold text-slate-400">@((task.TotalMinutesSpent / 60m).ToString("0.#"))h / @((task.EstimatedMinutes / 60m).ToString("0.#"))h</span>
                        </div>
                    </article>
                }
            </div>
            <button onclick="openCreateTaskModal('@column.Id')" class="mt-3 rounded-lg border border-dashed border-slate-300 py-2 text-xs font-bold text-slate-500 hover:bg-white">+ Adicionar</button>
        </section>
    }
</div>

<div id="view-table" class="hidden">@await Html.PartialAsync("_TableBoard", Model)</div>
<div id="view-gantt" class="hidden">@await Html.PartialAsync("_GanttBoard", Model)</div>

<div class="mt-8">@await Html.PartialAsync("_ActivityFeed", Model)</div>
@if (Model.CanManageBoard && Model.ArchivedTasks.Any())
{
    <details class="mt-6 rounded-2xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer text-sm font-bold text-slate-600">Tarefas arquivadas (@Model.ArchivedTasks.Count)</summary><div class="mt-3 space-y-2">@foreach(var archived in Model.ArchivedTasks){<div class="flex items-center justify-between rounded-lg bg-slate-50 p-3"><div><strong class="text-sm">@archived.Title</strong><p class="text-xs text-slate-400">Arquivada em @archived.ArchivedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><button type="button" onclick="restoreTask('@archived.Id')" class="text-xs font-bold text-indigo-600">Restaurar</button></div>}</div></details>
}
@await Html.PartialAsync("_CreateTaskModal", Model)
@await Html.PartialAsync("_TaskDetailsModal", Model)

@foreach (var task in Model.Tasks)
{
    <template id="task-extra-@task.Id">
        <div class="grid gap-6 lg:grid-cols-3">
            @if (task.CustomFields.TryGetValue("monday_item_id", out var mondayId))
            {
                <section class="lg:col-span-3 rounded-xl border border-indigo-100 bg-indigo-50/40 p-4">
                    <div class="mb-3 flex items-center justify-between"><h4 class="text-xs font-bold uppercase text-indigo-700">Dados importados do Monday</h4><span class="text-[10px] font-bold text-indigo-400">ID @mondayId</span></div>
                    <div class="grid gap-3 text-xs sm:grid-cols-2 lg:grid-cols-4">
                        @foreach (var field in new[] { ("monday_group", "Grupo"), ("monday_original_status", "Status original"), ("team", "Equipe"), ("project_type", "Tipo de projeto"), ("slo_result", "SLO"), ("monthly_occupancy", "Ocupação mensal"), ("development_hours", "Horas realizadas"), ("specific_project", "Projeto específico"), ("actual_start", "Início realizado"), ("actual_end", "Fim realizado"), ("subelements_summary", "Subelementos"), ("unmatched_owners", "Responsáveis não encontrados") })
                        {
                            if (task.CustomFields.TryGetValue(field.Item1, out var value) && value != null && value.ToString() is { Length: > 0 } text && text != "[]")
                            {
                                <div><p class="font-bold uppercase text-slate-400">@field.Item2</p><p class="mt-1 whitespace-pre-wrap text-slate-700">@text</p></div>
                            }
                        }
                    </div>
                </section>
            }
            <section>
                <h4 class="mb-3 text-xs font-bold uppercase text-slate-500">Checklist</h4>
                <div class="space-y-2">
                    @foreach (var item in Model.Checklists.Where(i => i.TaskId == task.Id))
                    {
                        <label class="flex items-center gap-2 rounded-lg bg-slate-50 p-2 text-sm">
                            <input type="checkbox" @(item.IsCompleted ? "checked" : "") onchange="toggleChecklist('@item.Id', this.checked)" />
                            <span class="@(item.IsCompleted ? "line-through text-slate-400" : "")">@item.Title</span>
                            <button type="button" class="ml-auto text-red-400" onclick="deleteChecklist('@item.Id')">×</button>
                        </label>
                    }
                </div>
            </section>
            <section class="lg:col-span-2">
                <div class="mb-3 flex items-center justify-between"><h4 class="text-xs font-bold uppercase text-slate-500">Conversa da atividade</h4><span class="text-[10px] text-slate-400">Mensagens ficam registradas no histórico</span></div>
                <div class="max-h-96 space-y-3 overflow-y-auto pr-1">
                    @foreach (var comment in Model.Comments.Where(c => c.TaskId == task.Id))
                    {
                        var author = Model.Profile(comment.UserId);
                        var attachments = Model.CommentAttachments.Where(a => a.CommentId == comment.Id).ToList();
                        var isMine = comment.UserId == Model.CurrentUserId;
                        <div class="rounded-xl border @(comment.MessageType == "question" ? "border-amber-200 bg-amber-50" : "border-slate-100 bg-slate-50") p-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-2"><div class="grid h-7 w-7 place-items-center rounded-full bg-indigo-100 text-[10px] font-bold text-indigo-700">@((author?.FullName ?? author?.Email ?? "U")[0])</div><div><p class="text-xs font-bold text-indigo-700">@(author?.FullName ?? author?.Email ?? "Usuário")</p><p class="text-[10px] text-slate-400">@comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @if(comment.UpdatedAt.HasValue){<span>· editada</span>}</p></div>@if(comment.MessageType == "question"){<span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-700">DÚVIDA</span>}</div>
                                @if (isMine && !comment.DeletedAt.HasValue)
                                {
                                    <div class="flex gap-2"><button type="button" data-content="@comment.Content" onclick="editComment('@comment.Id', this.dataset.content)" class="text-xs text-slate-400 hover:text-indigo-600">Editar</button><button type="button" onclick="deleteComment('@comment.Id')" class="text-xs text-red-400 hover:text-red-600">Excluir</button></div>
                                }
                            </div>
                            <p class="mt-2 whitespace-pre-wrap text-sm @(comment.DeletedAt.HasValue ? "italic text-slate-400" : "text-slate-700")">@comment.Content</p>
                            @if (!comment.DeletedAt.HasValue && attachments.Any())
                            {
                                <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                                @foreach (var attachment in attachments)
                                {
                                    <a href="/Boards/CommentAttachment/@attachment.Id" target="_blank" class="group overflow-hidden rounded-lg border border-slate-200 bg-white"><img src="/Boards/CommentAttachment/@attachment.Id" alt="@attachment.FileName" loading="lazy" class="h-28 w-full object-cover transition group-hover:scale-105"/><span class="block truncate px-2 py-1 text-[10px] text-slate-500">@attachment.FileName</span></a>
                                }
                                </div>
                            }
                        </div>
                    }
                    @if (!Model.Comments.Any(c => c.TaskId == task.Id)){<p class="rounded-xl border border-dashed border-slate-200 p-6 text-center text-sm text-slate-400">Inicie a conversa desta atividade.</p>}
                </div>
            </section>
            <section>
                <h4 class="mb-3 text-xs font-bold uppercase text-slate-500">Apontamentos</h4>
                <div class="max-h-48 space-y-2 overflow-y-auto">
                    @foreach (var log in Model.TimeLogs.Where(l => l.TaskId == task.Id))
                    {
                        <div class="rounded-lg bg-slate-50 p-3 text-sm">
                            <strong>@((log.Minutes / 60m).ToString("0.##"))h</strong>
                            <span class="text-slate-400"> · @log.LogDate.ToString("dd/MM/yyyy")</span>
                            <p class="text-xs text-slate-500">@log.Description</p>
                        </div>
                    }
                </div>
            </section>
            <section>
                <h4 class="mb-2 text-xs font-bold uppercase text-slate-500">Pré-requisitos</h4>
                <p class="mb-3 text-xs text-slate-500">Esta atividade só pode ser aceita quando as tarefas abaixo estiverem concluídas.</p>
                <div class="space-y-2">
                @foreach (var dependency in Model.Dependencies.Where(d => d.TaskId == task.Id))
                {
                    var prerequisite = Model.Tasks.FirstOrDefault(candidate => candidate.Id == dependency.DependsOnTaskId);
                    if (prerequisite == null) continue;
                    <div class="flex items-center gap-2 rounded-lg border border-slate-100 bg-slate-50 p-2 text-xs"><span class="h-2 w-2 rounded-full @(prerequisite.Status == "done" ? "bg-emerald-500" : "bg-amber-500")"></span><span class="min-w-0 flex-1 truncate">@prerequisite.Title</span><span class="text-[10px] font-bold @(prerequisite.Status == "done" ? "text-emerald-600" : "text-amber-600")">@(prerequisite.Status == "done" ? "Concluída" : "Pendente")</span><button type="button" onclick="deleteDependency('@dependency.Id')" class="text-red-400" title="Remover dependência">×</button></div>
                }
                @if (!Model.Dependencies.Any(d => d.TaskId == task.Id)){<p class="text-xs italic text-slate-400">Nenhum pré-requisito.</p>}
                </div>
            </section>
            <section>
                <h4 class="mb-3 text-xs font-bold uppercase text-slate-500">Subtarefas</h4>
                <div class="space-y-2">@foreach(var child in Model.Tasks.Where(x=>x.ParentTaskId==task.Id)){<div class="rounded-lg bg-slate-50 p-2 text-xs"><span class="mr-2 inline-block h-2 w-2 rounded-full @(child.Status=="done"?"bg-emerald-500":"bg-indigo-500")"></span><strong>@child.Title</strong><span class="float-right text-slate-400">@child.Status</span></div>}@if(!Model.Tasks.Any(x=>x.ParentTaskId==task.Id)){<p class="text-xs italic text-slate-400">Nenhuma subtarefa.</p>}</div>
            </section>
            @if (Model.ApprovalSteps.Any(step => step.TaskId == task.Id))
            {
                <section class="lg:col-span-3">
                    <h4 class="mb-3 text-xs font-bold uppercase text-slate-500">Fluxo de aprovação</h4>
                    <div class="grid gap-2 md:grid-cols-2">
                    @foreach (var step in Model.ApprovalSteps.Where(step => step.TaskId == task.Id).OrderBy(step => step.Sequence))
                    {
                        var approver = Model.Profile(step.ApproverId);
                        <div class="rounded-lg border border-slate-100 bg-slate-50 p-3 text-xs">
                            <div class="flex items-center justify-between"><strong>Etapa @step.Sequence · @(approver?.FullName ?? approver?.Email)</strong><span class="font-bold @(step.Status == "approved" ? "text-emerald-600" : step.Status == "rejected" ? "text-red-600" : step.Status == "pending" ? "text-amber-600" : "text-slate-400")">@step.Status</span></div>
                            @if (step.Status == "pending" && Model.CanDecide(step))
                            {
                                <form asp-controller="Boards" asp-action="DecideApproval" method="post" class="mt-3 space-y-2">
                                    <input type="hidden" name="boardId" value="@Model.Board.Id"/><input type="hidden" name="stepId" value="@step.Id"/>
                                    <input name="note" maxlength="1000" class="field" placeholder="Observação da decisão (opcional)"/>
                                    <div class="flex gap-3"><button name="decision" value="approve" class="font-bold text-emerald-600">Aprovar</button><button name="decision" value="reject" class="font-bold text-red-600">Solicitar alterações</button></div>
                                </form>
                            }
                        </div>
                    }
                    </div>
                </section>
            }
            <section>
                <h4 class="mb-3 text-xs font-bold uppercase text-slate-500">Arquivos</h4>
                <div class="space-y-2">@foreach(var file in Model.Files.Where(x=>x.TaskId==task.Id)){<a href="/Boards/TaskFile/@file.Id" class="block rounded-lg border bg-white p-2 text-xs hover:border-indigo-300"><strong class="block truncate">@file.FileName</strong><span class="text-slate-400">v@file.Version · @((file.FileSize/1024m).ToString("0")) KB</span></a>}@if(!Model.Files.Any(x=>x.TaskId==task.Id)){<p class="text-xs italic text-slate-400">Nenhum arquivo.</p>}</div>
            </section>
        </div>
    </template>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/frappe-gantt/0.6.1/frappe-gantt.min.js"></script>
    <script src="~/js/boards.js" asp-append-version="true"></script>
    <script src="~/js/gantt-advanced.js" asp-append-version="true"></script>
}
