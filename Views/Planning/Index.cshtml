@model PulseBoardMigration.Models.EnterprisePlanningViewModel
@{ ViewData["Title"] = "Planejamento avançado"; }
<div class="mb-7"><h1 class="text-3xl font-bold">Planejamento avançado</h1><p class="mt-1 text-sm text-slate-500">Capacidade real, baselines, portfólio, modelos e tarefas recorrentes.</p></div>

<div class="grid gap-6 xl:grid-cols-2">
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Disponibilidade da equipe</h2>
        <form asp-action="AddAbsence" method="post" class="grid gap-2 sm:grid-cols-2">
            <select name="userId" required class="field"><option value="">Pessoa</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select>
            <select name="type" class="field"><option value="vacation">Férias</option><option value="leave">Afastamento</option><option value="training">Treinamento</option><option value="day_off">Folga</option><option value="other">Outro</option></select>
            <input type="date" name="startsOn" required class="field"/><input type="date" name="endsOn" required class="field"/>
            <input name="notes" class="field sm:col-span-2" placeholder="Observação"/><button class="rounded-lg bg-indigo-600 py-2 text-sm font-bold text-white sm:col-span-2">Registrar ausência</button>
        </form>
        <div class="mt-4 space-y-2">@foreach(var item in Model.Absences.Take(8)){<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@(Model.Person(item.UserId)?.FullName??"Pessoa")</strong><span class="float-right text-xs text-slate-500">@item.StartsOn.ToString("dd/MM")–@item.EndsOn.ToString("dd/MM")</span><p class="text-xs text-slate-400">@item.AbsenceType · @item.Notes</p></div>}</div>
    </section>
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Feriados</h2>
        <form asp-action="AddHoliday" method="post" class="grid gap-2 sm:grid-cols-2"><input type="date" name="date" required class="field"/><input name="name" required class="field" placeholder="Nome"/><select name="teamId" class="field"><option value="">Toda a empresa</option>@foreach(var t in Model.Teams){<option value="@t.Id">@t.Name</option>}</select><button class="rounded-lg bg-slate-900 text-sm font-bold text-white">Adicionar</button></form>
        <div class="mt-4 flex flex-wrap gap-2">@foreach(var item in Model.Holidays.Take(15)){<span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold">@item.HolidayDate.ToString("dd/MM") · @item.Name</span>}</div>
    </section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Baseline de projeto</h2>
        <form asp-action="CaptureBaseline" method="post" class="grid gap-2 sm:grid-cols-[1fr_1fr_auto]"><select name="boardId" required class="field"><option value="">Projeto</option>@foreach(var b in Model.Boards){<option value="@b.Id">@b.Name</option>}</select><input name="name" class="field" placeholder="Nome da versão"/><button class="rounded-lg bg-indigo-600 px-4 text-sm font-bold text-white">Capturar</button></form>
        <div class="mt-4 space-y-2">@foreach(var item in Model.Baselines.Take(8)){<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@Model.Board(item.BoardId)?.Name</strong><span class="float-right text-xs">v@item.Version</span><p class="text-xs text-slate-400">@item.Name · @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>}</div>
    </section>
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Dependências entre projetos</h2>
        <form asp-action="AddDependency" method="post" class="grid gap-2 sm:grid-cols-2"><select name="predecessor" required class="field"><option value="">Projeto predecessor</option>@foreach(var b in Model.Boards){<option value="@b.Id">@b.Name</option>}</select><select name="successor" required class="field"><option value="">Projeto dependente</option>@foreach(var b in Model.Boards){<option value="@b.Id">@b.Name</option>}</select><select name="type" class="field"><option value="finish_to_start">Fim → início</option><option value="start_to_start">Início → início</option><option value="finish_to_finish">Fim → fim</option></select><div class="flex gap-2"><input type="number" name="lagDays" value="0" class="field" title="Defasagem em dias"/><button class="rounded-lg bg-slate-900 px-4 text-sm font-bold text-white">Adicionar</button></div></form>
        <div class="mt-4 space-y-2">@foreach(var d in Model.PortfolioDependencies.Take(8)){<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@Model.Board(d.PredecessorBoardId)?.Name</strong> → <strong>@Model.Board(d.SuccessorBoardId)?.Name</strong><span class="float-right text-xs text-slate-400">@d.LagDays dias</span></div>}</div>
    </section>

    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Modelos de tarefa</h2>
        <form asp-action="SaveTemplate" method="post" class="grid gap-2 sm:grid-cols-2"><input name="name" required class="field" placeholder="Nome do modelo"/><select name="boardId" class="field"><option value="">Todos os projetos</option>@foreach(var b in Model.Boards){<option value="@b.Id">@b.Name</option>}</select><input name="description" class="field sm:col-span-2" placeholder="Descrição padrão"/><input type="number" name="estimatedMinutes" min="0" class="field" placeholder="Estimativa em minutos"/><select name="priority" class="field"><option value="medium">Média</option><option value="high">Alta</option><option value="critical">Crítica</option></select><button class="rounded-lg bg-indigo-600 py-2 text-sm font-bold text-white sm:col-span-2">Salvar modelo</button></form>
        <div class="mt-4 flex flex-wrap gap-2">@foreach(var item in Model.Templates.Take(12)){<span class="rounded-full border px-3 py-1.5 text-xs font-bold">@item.Name</span>}</div>
    </section>
    <section class="rounded-2xl border bg-white p-5"><h2 class="mb-4 text-lg font-bold">Tarefas recorrentes</h2>
        <form asp-action="SaveRecurring" method="post" class="grid gap-2 sm:grid-cols-2"><select name="boardId" required class="field"><option value="">Projeto</option>@foreach(var b in Model.Boards){<option value="@b.Id">@b.Name</option>}</select><input name="title" required class="field" placeholder="Título"/><select name="cadence" class="field"><option value="daily">Diária</option><option value="weekly">Semanal</option><option value="monthly">Mensal</option></select><input type="number" name="intervalCount" min="1" value="1" class="field"/><input type="datetime-local" name="nextRunAt" required class="field"/><select name="assignedTo" class="field"><option value="">Sem responsável</option>@foreach(var p in Model.Profiles){<option value="@p.Id">@(p.FullName??p.Email)</option>}</select><input type="number" name="estimatedMinutes" min="0" class="field" placeholder="Estimativa (min)"/><input type="number" name="dueAfterDays" min="0" value="0" class="field" placeholder="Prazo após criação"/><textarea name="description" class="field sm:col-span-2" placeholder="Descrição"></textarea><button class="rounded-lg bg-slate-900 py-2 text-sm font-bold text-white sm:col-span-2">Programar recorrência</button></form>
        <div class="mt-4 space-y-2">@foreach(var item in Model.RecurringRules.Take(10)){<div class="rounded-lg bg-slate-50 p-3 text-sm"><strong>@item.Title</strong><span class="float-right text-xs">@item.Cadence</span><p class="text-xs text-slate-400">Próxima: @item.NextRunAt.ToLocalTime().ToString("dd/MM HH:mm")</p></div>}</div>
    </section>
</div>
